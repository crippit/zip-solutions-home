---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';

const pillars = [
  {
    title: "Hybrid Sessions & Multi-Room Streaming",
    description: "Planning an event with both in-room and remote attendees? We help set up and manage reliable live streams across concurrent rooms or keynote halls, managing the feed so your team can focus on the program.",
    icon: "broadcast"
  },
  {
    title: "Remote Presenter Support",
    description: "Bringing in a guest speaker over video? We test with remote presenters beforehand and bring their audio and video cleanly onto your venue projection screens or live stream.",
    icon: "video"
  },
  {
    title: "Accessibility Built In from Day One",
    description: "Accessibility is often left to the last minute. We help you plan it into the event setup from the start, including live captions, assistive listening considerations, and clear visual presentation.",
    icon: "accessibility"
  },
  {
    title: "Google for Education & Custom PD Workshops",
    description: "Beyond day-of event tech, we deliver customized, practical PD sessions for teachers, administrators, and business teams on Google Workspace, Gemini AI, assistive tools, and inclusive educational technology.",
    icon: "graduation"
  }
];

const timelineSteps = [
  {
    step: "01",
    title: "Initial Consultation",
    description: "We talk through your schedule, venue layout, audio equipment, and what kind of streaming or recording you need."
  },
  {
    step: "02",
    title: "Pre-Event Planning & Testing",
    description: "We help plan the technical flow, test remote connections in advance, and confirm audio and display setups."
  },
  {
    step: "03",
    title: "Event Day Support",
    description: "Hands-on technical assistance to help your presentations, streams, and attendee accessibility run smoothly."
  }
];

const idealAudiences = [
  "School District Professional Development Days & Educator Conferences",
  "Academic Symposia & University Lecture Series",
  "Non-Profit Summits & Community Assemblies",
  "Hybrid Association Meetings & Annual Conventions"
];

const faqs = [
  {
    question: "Hotel and convention center AV quotes want $5,000+ per room just for hybrid streaming and live captioning. How do you keep event costs realistic for schools, non-profits, and associations?",
    answer: "Traditional venue AV quotes mark up proprietary hardware encoders, dedicated video trucks, and per-hour stenographer feeds. Because we engineered the Zip Captions broadcast stack ourselves, we tap directly into your venue's existing soundboard, use lightweight vMix/OBS switching, and stream live captions simultaneously to stage projectors and attendee smartphones via QR code—eliminating thousands of dollars in rented hardware."
  },
  {
    question: "When a remote speaker joins our in-person conference over Zoom or Google Meet, why does the room audio often echo—and how do you prevent it?",
    answer: "Feedback loops happen when a podium laptop's speakers bleed back into the room microphones or when the soundboard sends the remote guest their own voice back. Before your event day, we run a dedicated tech check with every remote presenter and configure a clean 'mix-minus' audio feed into the room PA and livestream so virtual guests sound crisp in the hall with zero echo."
  },
  {
    question: "What if the hotel or school gymnasium Wi-Fi gets congested once 300 attendees walk into the room?",
    answer: "Crowded venue Wi-Fi is the #1 killer of amateur hybrid events. We always prioritize hardwired Ethernet for the main production and captioning rigs, bring cellular bonding/failover backups for on-site productions across Montreal, Quebec, and Canada, and use ultra-low-bandwidth WebSocket text streams so attendee QR caption relays stay responsive even on congested mobile networks."
  },
  {
    question: "Most teacher PD days feel like generic slide decks where staff tune out by 10:00 AM. How are your Google for Education workshops different?",
    answer: "Our workshops are built and led by practicing educators—Chris Webb (Google for Education Certified Trainer, Certified Innovator, GEG Leader, and Champions Ambassador) and James Petersen (Google for Education Certified Innovator). Instead of abstract lectures, teachers spend the session building real classroom accommodations, Gemini AI lesson workflows, and Google Workspace tools they can use with their students the very next morning."
  },
  {
    question: "Where can we book your team for on-site event production versus remote support or virtual PD?",
    answer: "We are based near Montreal, Quebec, Canada. Our team travels on-site for conferences, school conventions, theatre productions, and in-person PD days across Greater Montreal, Quebec, and throughout Canada. We also provide remote technical production direction, custom live captioning rooms, and virtual Google for Education PD workshops for schools and organizations worldwide."
  }
];

const eventServiceSchema = {
  "@type": "Service",
  "@id": "https://zipsolutions.org/events#service",
  "name": "In-Person & Hybrid Event Organisation & Google for Education PD",
  "provider": {
    "@id": "https://zipsolutions.org/#organization"
  },
  "serviceType": "Hybrid Conference Production, Multi-Room Streaming & Educator Professional Development",
  "description": "Practical technical production, multi-room hybrid streaming, live event accessibility, and tailored Google for Education training workshops for schools, conferences, and businesses. On-site across Montreal, Quebec, and Canada; virtual and remote worldwide.",
  "url": "https://zipsolutions.org/events",
  "areaServed": [
    { "@type": "City", "name": "Montreal" },
    { "@type": "AdministrativeArea", "name": "Quebec" },
    { "@type": "Country", "name": "Canada" },
    { "@type": "Country", "name": "United States" },
    { "@type": "Country", "name": "United Kingdom" },
    { "@type": "Place", "name": "Worldwide" }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Event Production & Educator PD Offerings",
    "itemListElement": [
      {
        "@type": "Offer",
        "name": "In-Person & Hybrid Conference Production & Multi-Room Streaming",
        "description": "Custom quote per event. Turnkey multi-room streaming, remote presenter integration, and accessible stage display management.",
        "url": "https://zipsolutions.org/contact-us"
      },
      {
        "@type": "Offer",
        "name": "Google for Education Training & Custom Educator PD Workshops",
        "description": "Custom quote for schools, school boards, and corporate teams. Led by Google for Education Certified Trainers & Innovators (Gemini AI, Google Workspace, assistive technology).",
        "url": "https://zipsolutions.org/contact-us"
      }
    ]
  }
};
---

<BaseLayout 
  title="In-Person & Hybrid Event Production & Educator PD | Zip Solutions" 
  description="Practical technical production, multi-room hybrid conference streaming, live captions, and tailored Google for Education training workshops for schools and businesses."
  schema={eventServiceSchema}
  faqs={faqs}
>

  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-white to-slate-50 border-b border-slate-200/80 pt-14 pb-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-sm font-bold text-coral tracking-wide uppercase mb-3 font-heading">
        Educational &amp; Community Events
      </p>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-midnight font-heading leading-tight">
        In-Person &amp; Hybrid Event Organisation
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Practical technical production, multi-room hybrid streaming, and tailored professional development workshops for schools, conferences, and non-profits.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href="/contact-us" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl font-heading font-bold text-white bg-coral hover:bg-rose-600 shadow-md hover:shadow-lg transition-all text-sm"
        >
          <span>Discuss Your Event</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        <a 
          href="#services" 
          class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-3.5 rounded-xl font-heading font-bold text-slate-700 hover:text-midnight bg-slate-100 hover:bg-slate-200 transition-colors text-sm"
        >
          Explore Services
        </a>
      </div>
    </div>
  </section>

  <!-- Core Services Grid -->
  <section id="services" class="py-16 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <p class="text-xs font-bold uppercase tracking-wider text-teal-brand font-heading mb-2">
        What We Offer
      </p>
      <h2 class="text-2xl sm:text-4xl font-extrabold font-heading text-midnight">
        Practical Production &amp; Hands-On Support
      </h2>
      <p class="mt-3 text-slate-600 text-sm sm:text-base leading-relaxed">
        We handle the technical details and live streaming infrastructure so your presenters can focus on sharing ideas.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {pillars.map((pillar) => (
        <div class="bg-white rounded-3xl p-8 sm:p-10 border border-slate-200 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-coral/10 text-coral flex items-center justify-center mb-6">
              {pillar.icon === 'broadcast' && (
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.343 9.343c5.857-5.857 15.355-5.857 21.213 0" />
                </svg>
              )}
              {pillar.icon === 'video' && (
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
              )}
              {pillar.icon === 'accessibility' && (
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
              )}
              {pillar.icon === 'graduation' && (
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14v7" />
                </svg>
              )}
            </div>

            <h3 class="text-xl font-bold font-heading text-midnight mb-3">
              {pillar.title}
            </h3>

            <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
              {pillar.description}
            </p>

            {pillar.icon === 'graduation' && (
              <div class="mt-4 pt-4 border-t border-slate-100">
                <a href="#training" class="text-xs font-bold text-teal-brand hover:text-teal-dark inline-flex items-center gap-1 transition-colors">
                  <span>View Workshop Topics &amp; Facilitators</span>
                  <span>&darr;</span>
                </a>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Google for Education Training & Custom Workshops (Zero Pills) -->
  <section id="training" class="py-16 sm:py-20 bg-slate-50 border-t border-slate-200/80 scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="text-xs font-bold font-mono text-amethyst uppercase tracking-wider block">
          Practical Training &amp; Professional Development
        </span>
        <h2 class="text-2xl sm:text-4xl font-extrabold font-heading text-midnight">
          Google for Education Training &amp; Custom Workshops
        </h2>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
          Real, practical training led by working educators and Google certified specialists. Whether you need a focused pedagogical day for your school staff, a hands-on session on Gemini AI, or practical Google Workspace training for your business team, we tailor sessions to what you actually need.
        </p>
      </div>

      <!-- Facilitators & Credentials (Zero Pills) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 max-w-5xl mx-auto">
        
        <!-- Chris Webb -->
        <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-xs flex flex-col justify-between">
          <div class="space-y-4">
            <div class="flex items-center gap-4">
              <img 
                src="/images/Chris_Circle.png" 
                alt="Chris Webb" 
                class="w-16 h-16 rounded-2xl object-cover border border-purple-100 shadow-xs shrink-0"
                loading="lazy"
              />
              <div>
                <h3 class="text-lg font-bold font-heading text-midnight">Chris Webb</h3>
                <p class="text-xs text-amethyst font-semibold font-heading">Co-Founder &amp; High School Computer Science Teacher</p>
              </div>
            </div>
            
            <div class="pt-2 border-t border-slate-100">
              <span class="text-xs font-bold font-mono text-slate-400 uppercase tracking-wider block mb-2">
                Google for Education Credentials
              </span>
              <ul class="text-xs font-mono text-slate-600 space-y-1.5">
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-amethyst shrink-0"></span>
                  <span>Google for Education Certified Trainer</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-amethyst shrink-0"></span>
                  <span>Google for Education Certified Innovator</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-amethyst shrink-0"></span>
                  <span>Google Educator Group (GEG) Leader</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-amethyst shrink-0"></span>
                  <span>Google Certified Educator (Level 1 &amp; Level 2)</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-amethyst shrink-0"></span>
                  <span>Google for Education Gemini Certified</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-amethyst shrink-0"></span>
                  <span>Google for Education Champions Ambassador</span>
                </li>
              </ul>
            </div>
          </div>
        </div>

        <!-- James Petersen -->
        <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-xs flex flex-col justify-between">
          <div class="space-y-4">
            <div class="flex items-center gap-4">
              <img 
                src="/images/James_Circle.png" 
                alt="James Petersen" 
                class="w-16 h-16 rounded-2xl object-cover border border-teal-100 shadow-xs shrink-0"
                loading="lazy"
              />
              <div>
                <h3 class="text-lg font-bold font-heading text-midnight">James Petersen</h3>
                <p class="text-xs text-teal-brand font-semibold font-heading">Co-Founder, Cloud Architect &amp; Former Educator</p>
              </div>
            </div>
            
            <div class="pt-2 border-t border-slate-100">
              <span class="text-xs font-bold font-mono text-slate-400 uppercase tracking-wider block mb-2">
                Specialization &amp; Credentials
              </span>
              <ul class="text-xs font-mono text-slate-600 space-y-1.5">
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-teal-brand shrink-0"></span>
                  <span>Google for Education Certified Innovator</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-teal-brand shrink-0"></span>
                  <span>Cloud Architecture &amp; Secure Data Pipelines</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-teal-brand shrink-0"></span>
                  <span>Open Source &amp; User Privacy Advocate</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-teal-brand shrink-0"></span>
                  <span>Practical Automation &amp; Google Apps Script</span>
                </li>
              </ul>
            </div>
          </div>
        </div>

      </div>

      <!-- Workshop Focus Areas: Schools vs. Businesses -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto pt-4">
        
        <!-- For Schools -->
        <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-xs space-y-5">
          <div class="space-y-1">
            <span class="text-xs font-bold font-mono text-coral uppercase tracking-wider block">
              Education Sector
            </span>
            <h3 class="text-xl font-bold font-heading text-midnight">
              For Schools &amp; School Boards
            </h3>
          </div>
          <ul class="space-y-3 text-sm text-slate-600">
            <li class="flex items-start gap-2.5">
              <span class="text-teal-brand font-bold mt-0.5">✓</span>
              <span><strong class="text-midnight">Google Classroom &amp; Workspace in Practice:</strong> Streamlining day-to-day teaching, assignments, student feedback, and reducing administrative load.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-teal-brand font-bold mt-0.5">✓</span>
              <span><strong class="text-midnight">Gemini AI for Educators:</strong> Thoughtful, practical use of generative AI for lesson design, differentiated resources, rubrics, and time-saving workflows while respecting student privacy.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-teal-brand font-bold mt-0.5">✓</span>
              <span><strong class="text-midnight">Built-In Accessibility:</strong> Leveraging ChromeOS and Google Workspace accessibility features (screen readers, dictation, captions, reading aids) under Universal Design for Learning (UDL).</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-teal-brand font-bold mt-0.5">✓</span>
              <span><strong class="text-midnight">Custom PD Days:</strong> Flexible half-day or full-day hands-on sessions aligned directly with your school or district priorities.</span>
            </li>
          </ul>
        </div>

        <!-- For Businesses -->
        <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-xs space-y-5">
          <div class="space-y-1">
            <span class="text-xs font-bold font-mono text-teal-brand uppercase tracking-wider block">
              Corporate &amp; Non-Profit
            </span>
            <h3 class="text-xl font-bold font-heading text-midnight">
              For Businesses &amp; Organizations
            </h3>
          </div>
          <ul class="space-y-3 text-sm text-slate-600">
            <li class="flex items-start gap-2.5">
              <span class="text-teal-brand font-bold mt-0.5">✓</span>
              <span><strong class="text-midnight">Google Workspace Collaboration:</strong> Helping teams get the most out of Google Docs, Drive, Sheets, and Meet for efficient, organized daily teamwork.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-teal-brand font-bold mt-0.5">✓</span>
              <span><strong class="text-midnight">Practical Gemini Workflows:</strong> Introducing staff to AI tools for drafting, synthesizing information, meeting summaries, and everyday productivity.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-teal-brand font-bold mt-0.5">✓</span>
              <span><strong class="text-midnight">Connected Spreadsheets &amp; Dashboards:</strong> Building straightforward data views and tracking sheets without complex enterprise software.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-teal-brand font-bold mt-0.5">✓</span>
              <span><strong class="text-midnight">Tailored Team Coaching:</strong> Targeted sessions focused on your team's specific bottlenecks, whether in-person or remote.</span>
            </li>
          </ul>
        </div>

      </div>

      <!-- Delivery Formats & Action Callout -->
      <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 max-w-5xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-6 shadow-xs">
        <div class="space-y-1 text-center sm:text-left">
          <p class="text-sm font-bold font-heading text-midnight">
            Flexible In-Person or Virtual Delivery • Fully Bilingual (EN / FR)
          </p>
          <p class="text-xs sm:text-sm text-slate-500">
            We deliver on-site sessions across Quebec and Canada, or interactive virtual workshops via Google Meet.
          </p>
        </div>
        <a 
          href="/contact-us" 
          class="shrink-0 inline-flex items-center gap-2 px-6 py-3 rounded-xl font-heading font-bold text-sm text-white bg-amethyst hover:bg-amethyst-dark transition-all shadow-xs"
        >
          <span>Discuss Training for Your Team</span>
          <span>&rarr;</span>
        </a>
      </div>

    </div>
  </section>

  <!-- How It Works Timeline -->
  <section class="py-16 bg-white border-y border-slate-200/80">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <p class="text-xs font-bold uppercase tracking-wider text-amethyst font-heading mb-2">
          Collaboration Workflow
        </p>
        <h2 class="text-2xl sm:text-3xl font-extrabold font-heading text-midnight">
          How We Work Together
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {timelineSteps.map((step) => (
          <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm relative">
            <span class="text-3xl font-black text-coral/30 font-mono block mb-3">
              {step.step}
            </span>
            <h3 class="text-lg font-bold font-heading text-midnight mb-2">
              {step.title}
            </h3>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Suitable Settings -->
  <section class="py-16 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-gradient-to-br from-midnight to-slate-900 rounded-3xl p-8 sm:p-12 text-white shadow-xl">
      <div class="max-w-2xl">
        <span class="text-xs font-bold uppercase tracking-wider text-teal-brand font-heading block mb-2">
          Ideal Settings
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold font-heading tracking-tight mb-4">
          Events &amp; Sessions We Support
        </h2>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-6">
          Whether your gathering is fully in-person, fully virtual, or a hybrid mix across multiple breakout rooms, we tailor our technical setup to your venue and audience needs.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 pt-2">
        {idealAudiences.map((audience) => (
          <div class="flex items-center gap-3 p-3.5 rounded-2xl bg-white/5 border border-white/10 text-xs sm:text-sm text-slate-200 font-medium">
            <span class="w-5 h-5 rounded-full bg-teal-brand/20 text-teal-brand flex items-center justify-center text-xs font-bold shrink-0">✓</span>
            <span>{audience}</span>
          </div>
        ))}
      </div>

      <div class="mt-8 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="text-xs text-slate-400">
          Have questions about your specific venue or equipment?
        </p>
        <div class="flex flex-wrap items-center gap-3">
