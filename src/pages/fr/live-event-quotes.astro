---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import FaqSection from '../../components/FaqSection.astro';

const displayOptions = [
  {
    title: "Relais sur appareils personnels des participants (via code QR)",
    description: "La formule la plus simple et la plus accessible. Nous générons un code QR unique affiché sur scène ou dans le programme. Les participants le scannent pour suivre les sous-titres en temps réel directement sur leur téléphone, tablette ou ordinateur portable depuis leur siège.",
    icon: "qrcode",
    recommended: true
  },
  {
    title: "Écrans de scène et affichages de salle",
    description: "Affichez les sous-titres en direct directement sur le projecteur d'un amphithéâtre, un écran de retour de scène ou un moniteur d'appoint, avec une typographie nette, lisible et à fort contraste adaptée à l'éclairage de la salle.",
    icon: "projector"
  },
  {
    title: "Intégration pour webdiffusion (vMix et OBS)",
    description: "Connectez les sous-titres directement dans votre mélangeur de diffusion. Grâce à notre extension vMix ou à nos flux web standard, vous obtenez des incrustations numériques parfaites, sans capture d'écran approximative.",
    icon: "stream"
  },
  {
    title: "Surtitrage synchronisé pour le théâtre",
    description: "Une solide expérience de déploiement et de déclenchement de surtitres pour le théâtre, les spectacles vivants et les comédies musicales, garantissant une parfaite synchronisation avec le jeu des comédiens.",
    icon: "theatre"
  }
];

const quoteChecklist = [
  "Date, heure et durée prévue de l'événement",
  "Format de l'événement (en présentiel, virtuel ou hybride)",
  "Mode d'affichage des sous-titres souhaité (code QR pour participants, projecteur de salle, flux vMix ou surtitres théâtraux)",
  "Emplacement de la salle et particularités audiovisuelles"
];
const liveCaptionsServiceSchema = {
  "@type": "Service",
  "@id": "https://zipsolutions.org/fr/live-event-quotes#service",
  "name": "Sous-titrage en direct d'événements, relais QR et surtitrage théâtral",
  "provider": {
    "@id": "https://zipsolutions.org/#organization"
  },
  "serviceType": "Sous-titrage en direct et surtitrage de spectacle",
  "description": "Sous-titres en direct flexibles sur le web pour conférences, présentations en auditorium, relais par code QR, webdiffusions vMix/OBS et pièces de théâtre. Sur place à Montréal, au Québec et au Canada, et à distance dans le monde entier.",
  "url": "https://zipsolutions.org/fr/live-event-quotes",
  "areaServed": [
    { "@type": "City", "name": "Montréal" },
    { "@type": "AdministrativeArea", "name": "Québec" },
    { "@type": "Country", "name": "Canada" },
    { "@type": "Country", "name": "États-Unis" },
    { "@type": "Country", "name": "Royaume-Uni" },
    { "@type": "Place", "name": "Dans le monde entier" }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Solutions de sous-titrage en direct et de surtitrage",
    "itemListElement": [
      {
        "@type": "Offer",
        "name": "Relais sur appareils personnels des participants (via code QR)",
        "description": "Devis événementiel sur mesure. Diffusion des sous-titres en temps réel sur les téléphones, tablettes et ordinateurs portables des participants via code QR."
      },
      {
        "@type": "Offer",
        "name": "Écrans de scène, affichages de salle et incrustations vMix/OBS",
        "description": "Devis événementiel sur mesure. Affichage à fort contraste sur écrans d'auditorium et intégration directe dans les flux vidéo vMix et OBS Studio."
      },
      {
        "@type": "Offer",
        "name": "Surtitrage synchronisé pour le théâtre",
        "description": "Devis de production sur mesure. Surtitres théâtraux préchargés et déclenchés en direct au rythme exact des comédiens."
      }
    ]
  }
};

const quoteFaqs = [
  {
    question: "Pourquoi ne peut-on pas simplement utiliser la reconnaissance vocale automatique pour une pièce de théâtre, une comédie musicale ou un gala scénarisé ?",
    answer: "La reconnaissance vocale automatique échoue souvent au théâtre parce que les comédiens projettent leur voix avec émotion, se coupent la parole, chantent par-dessus la musique et jouent sur un rythme comique ou dramatique précis — un décalage de deux secondes ou un mot mal compris gâche une réplique. Pour le théâtre, nous préchargeons votre texte et déclenchons manuellement chaque surtitre en direct au rythme exact du jeu sur scène ou sur les téléphones du public."
  },
  {
    question: "Notre colloque comporte 4 salles d'ateliers simultanées et nous n'avons pas le budget pour louer des écrans géants dédiés aux sous-titres dans chaque salle. Comment rendre chaque atelier accessible ?",
    answer: "C'est précisément la force de notre relais sur appareils personnels par code QR. Plutôt que de louer des projecteurs et écrans supplémentaires pour chaque salle d'atelier, nous attribuons à chaque salle une affiche avec code QR à l'entrée et sur la diapositive d'accueil. Les participants scannent le code QR avec leur téléphone ou ordinateur portable pour suivre les sous-titres en temps réel depuis leur siège, sans application à installer."
  },
  {
    question: "De quoi votre équipe a-t-elle concrètement besoin de la part du technicien audiovisuel de la salle le jour de l'événement ?",
    answer: "Seulement deux éléments : une sortie audio directe des microphones de parole depuis la console de son (XLR, jack 6,35 mm ou interface USB — en excluant la musique d'ambiance) et une prise électrique standard. Si vous souhaitez aussi afficher les sous-titres sur un écran de scène ou dans un flux vMix/OBS, nous nous y connectons en HDMI ou via le réseau local en quelques minutes."
  },
  {
    question: "Comment gérez-vous les conférences bilingues (français/anglais), les acronymes spécialisés et les noms propres des conférenciers ?",
    answer: "Avant votre événement, transmettez-nous votre programme, la liste des intervenants, vos acronymes et vos présentations. Nous préparons les profils linguistiques (français québécois, français international, anglais) et le vocabulaire personnalisé afin que les noms propres et termes techniques soient retranscrits avec exactitude."
  },
  {
    question: "Dans quel délai répondez-vous aux demandes de devis et quelles régions desservez-vous sur place ou à distance ?",
    answer: "Nous répondons généralement sous un jour ouvrable avec une recommandation technique claire et un devis transparent. Nous intervenons sur place à Montréal, partout au Québec et au Canada, et assurons le sous-titrage à distance pour les événements virtuels et hybrides dans le monde entier."
  }
];
---

<BaseLayout 
  title="Devis sous-titrage d'événements en direct, relais QR et surtitrage | Solutions Zip" 
  description="Demandez un devis pour le sous-titrage en direct de conférences, relais sur téléphone par code QR, écrans d'auditorium, webdiffusions vMix/OBS et surtitrage de théâtre."
  schema={liveCaptionsServiceSchema}
  faqs={quoteFaqs}
>
  <Fragment slot="head">
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  </Fragment>

  <!-- En-tête -->
  <section class="bg-gradient-to-b from-white to-slate-50 border-b border-slate-200/80 pt-14 pb-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-sm font-bold text-teal-brand tracking-wide uppercase mb-3 font-heading">
        Sous-titres et surtitrage d'événements en direct
      </p>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-midnight font-heading leading-tight">
        Des sous-titres et surtitres adaptés à votre événement
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Des solutions de sous-titrage en direct souples, conçues pour le web et pensées pour les colloques, conférences en salle, diffusions en direct et productions scéniques.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href="#quote-form" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl font-heading font-bold text-white bg-teal-brand hover:bg-teal-dark shadow-md hover:shadow-lg transition-all text-sm"
        >
          <span>Demander un devis</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        <a 
          href="#display-options" 
          class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-3.5 rounded-xl font-heading font-bold text-slate-700 hover:text-midnight bg-slate-100 hover:bg-slate-200 transition-colors text-sm"
        >
          Voir les options d'affichage
        </a>
      </div>
    </div>
  </section>

  <!-- Options d'affichage -->
  <section id="display-options" class="py-16 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <p class="text-xs font-bold uppercase tracking-wider text-amethyst font-heading mb-2">
        Modes d'affichage polyvalents
      </p>
      <h2 class="text-2xl sm:text-4xl font-extrabold font-heading text-midnight">
        Plusieurs façons d'afficher vos sous-titres
      </h2>
      <p class="mt-3 text-slate-600 text-sm sm:text-base leading-relaxed">
        Choisissez la disposition qui convient à l'architecture de votre lieu et au confort de votre public.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {displayOptions.map((option) => (
        <div class="bg-white rounded-3xl p-8 sm:p-10 border border-slate-200 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-6">
              <div class="w-12 h-12 rounded-2xl bg-teal-brand/10 text-teal-brand flex items-center justify-center">
                {option.icon === 'qrcode' && (
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
                  </svg>
                )}
                {option.icon === 'projector' && (
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                  </svg>
                )}
                {option.icon === 'stream' && (
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                  </svg>
                )}
                {option.icon === 'theatre' && (
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z" />
                  </svg>
                )}
              </div>
              {option.recommended && (
                <span class="text-xs font-semibold text-teal-brand tracking-wide uppercase">
                  Le plus demandé
                </span>
              )}
            </div>

            <h3 class="text-xl font-bold font-heading text-midnight mb-3">
              {option.title}
            </h3>

            <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
              {option.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Engagement de confidentialité (zéro pilule) -->
  <section class="pb-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-gradient-to-r from-purple-50 via-slate-50 to-teal-50/50 rounded-3xl p-8 sm:p-10 border border-slate-200">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-wider text-amethyst font-heading block mb-2">
          Engagement de confidentialité
        </span>
        <h3 class="text-xl sm:text-2xl font-bold font-heading text-midnight mb-3">
          100% privé dès la conception
        </h3>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
          Le signal audio traité par Zip Captions demeure strictement confidentiel. Aucun enregistrement n'est conservé, stocké ou revendu. Vos conférenciers, participants et discussions sont totalement protégés.
        </p>
      </div>
    </div>
  </section>

  <!-- Formulaire et informations de devis -->
  <section id="quote-form" class="py-16 bg-slate-50 border-t border-slate-200/80 scroll-mt-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      
      <div class="text-center max-w-2xl mx-auto">
        <span class="text-xs font-bold uppercase tracking-wider text-teal-brand font-heading block mb-2">
          Consultation sur mesure
        </span>
        <h2 class="text-2xl sm:text-4xl font-extrabold font-heading text-midnight">
          Demander un devis personnalisé
        </h2>
        <p class="mt-3 text-slate-600 text-sm sm:text-base leading-relaxed">
          Chaque lieu et chaque production ont des impératifs particuliers. Renseignez les paramètres de votre événement pour recevoir une proposition adaptée.
        </p>
      </div>

      <!-- Liste de vérification pour devis (zéro pilule) -->
      <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-4">
        <h3 class="text-base font-bold font-heading text-midnight">
          Renseignements qui nous aident à préparer votre estimation :
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {quoteChecklist.map((item) => (
            <div class="flex items-start gap-3 p-3 rounded-2xl bg-slate-50 border border-slate-100 text-xs sm:text-sm text-slate-700">
              <span class="w-5 h-5 rounded-lg bg-teal-brand/10 text-teal-brand flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">✓</span>
              <span>{item}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Formulaire de devis interactif -->
      <QuoteForm id="event-quote-request-form" />

      <div class="text-center text-xs text-slate-500 pt-2">
        <p>
          Vous avez une question générale ou un projet de partenariat ? Visitez notre <a href="/fr/contact-us" class="text-teal-brand font-semibold hover:underline">Page de contact général</a>.
        </p>
      </div>

    </div>
  </section>

  <FaqSection 
    title="Questions fréquentes sur les devis d'événements en direct"
    subtitle="Réponses rapides sur nos délais de réponse, les combinaisons d'affichage et le surtitrage théâtral."
    faqs={quoteFaqs}
  />

</BaseLayout>
