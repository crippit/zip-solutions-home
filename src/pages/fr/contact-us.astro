---
import BaseLayout from '../../layouts/BaseLayout.astro';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '0x4AAAAAAFBlnTxyYW0fzpJV';

const inquiryTypes = [
  { id: "accommodations", label: "Aménagement / Adaptation d'accessibilité", value: "Accessibility Adaptation / Accommodation" },
  { id: "partnership", label: "Demande de partenariat", value: "Partnership Inquiry" },
  { id: "product", label: "Renseignement produit ou service", value: "Product or service Inquiry" },
  { id: "advisory-board", label: "Intérêt pour le conseil consultatif", value: "Interested in Advisory Board" },
  { id: "help-support", label: "Aide ou soutien technique", value: "Help or Support" },
  { id: "media-press", label: "Médias / Presse", value: "Media / Press" },
  { id: "general-contact", label: "Contact général", value: "General Contact", defaultChecked: true }
];
---

<BaseLayout 
  title="Contactez-nous et devis d'événements | Solutions Zip" 
  description="Communiquez avec l'équipe de Solutions Zip pour des devis de sous-titrage sur mesure, l'organisation d'événements en présentiel ou hybrides, des formations ou des partenariats."
>
  <Fragment slot="head">
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  </Fragment>

  <section class="bg-gradient-to-b from-white to-slate-50 border-b border-slate-200/80 pt-14 pb-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-sm font-bold text-amethyst tracking-wide uppercase mb-3 font-heading">
        Prendre contact
      </p>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-midnight font-heading">
        Contact et devis personnalisés
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Vous organisez un événement en présentiel ou hybride ? Vous souhaitez des sous-titres en direct adaptés pour votre conférence ou une formation pour vos éducateurs ? Contactez-nous pour un devis et des conseils techniques.
      </p>
    </div>
  </section>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-10">
    
    <!-- Engagement d'adaptation et respect des besoins (zéro pilule) -->
    <div id="accommodations" class="bg-gradient-to-br from-slate-900 via-midnight to-slate-950 rounded-3xl p-8 sm:p-10 text-white border border-slate-800 shadow-xl scroll-mt-24">
      <div class="space-y-3">
        <span class="text-xs font-bold uppercase tracking-wider text-teal-brand font-heading block">
          Notre engagement fondamental
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold font-heading tracking-tight">
          Le respect de chaque besoin d'accessibilité
        </h2>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
          Il n'y a pas deux classes, deux auditoires ou deux équipes de diffusion identiques. Si vos élèves, participants ou techniciens nécessitent un aménagement précis (raccourcis clavier personnalisés, affichage à fort contraste, crochets WebSockets sur mesure ou intégration matérielle en classe), nous sommes là pour vous accompagner.
        </p>
        <p class="text-xs text-slate-400 font-mono pt-1">
          Sélectionnez <span class="text-teal-brand font-semibold">"Aménagement / Adaptation d'accessibilité"</span> ci-dessous pour transmettre votre demande directement à notre équipe technique et consultative.
        </p>
      </div>
    </div>

    <!-- Demande de devis événementiel -->
    <div class="bg-gradient-to-r from-teal-50 to-purple-50 p-6 sm:p-7 rounded-3xl border border-teal-200/80 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-teal-brand font-heading block mb-1">
          Événement en direct ou conférence ?
        </span>
        <h3 class="text-base sm:text-lg font-bold font-heading text-midnight">
          Vous recherchez un devis événementiel ?
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 mt-1">
          Utilisez notre formulaire événementiel dédié pour préciser la taille de la salle, les relais QR ou les configurations d'affichage.
        </p>
      </div>
      <a 
        href="/fr/live-event-quotes#quote-form" 
        class="shrink-0 px-5 py-2.5 bg-teal-brand hover:bg-teal-dark text-white font-heading font-bold text-xs rounded-xl shadow-sm transition-all"
      >
        <span>Ouvrir le formulaire de devis &rarr;</span>
      </a>
    </div>
    
    <!-- iframe invisible pour la soumission en arrière-plan vers Google Forms -->
    <iframe 
      name="hidden_gform_iframe" 
      id="hidden_gform_iframe" 
      class="hidden" 
      title="Cible du formulaire en arrière-plan"
    ></iframe>

    <!-- Conteneur du formulaire de contact -->
    <div class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm">
      
      <!-- Message de confirmation de soumission -->
      <div id="form-success-banner" class="hidden text-center py-10 space-y-4" role="status" aria-live="polite" tabindex="-1">
        <div class="w-16 h-16 mx-auto rounded-2xl bg-teal-50 text-teal-brand flex items-center justify-center border border-teal-200">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <h2 class="text-2xl font-bold font-heading text-midnight">Merci beaucoup !</h2>
        <p class="text-slate-600 max-w-md mx-auto text-sm sm:text-base">
          Votre message a bien été reçu. Notre équipe étudiera votre demande et vous répondra dans les plus brefs délais.
        </p>
        <button 
          id="reset-form-btn" 
          type="button" 
          class="inline-block mt-4 px-6 py-2.5 bg-slate-100 hover:bg-slate-200 text-midnight text-xs font-bold rounded-xl transition-colors"
        >
          Envoyer un autre message
        </button>
      </div>

      <!-- Formulaire principal -->
      <form 
        id="zip-contact-form"
        target="hidden_gform_iframe"
        action=""
        data-action="https://docs.google.com/forms/u/0/d/e/1FAIpQLSeat_QYrLNUwVb37U-qYQvWAlhKns2xs9zd_gnsZvI6XmgYow/formResponse"
        method="POST"
        class="space-y-6"
      >
        <!-- Piège à pourriels (champ caché) -->
        <div class="hidden" aria-hidden="true" style="display: none !important;">
          <label for="company_url_hp">Veuillez laisser ce champ vide</label>
          <input type="text" name="company_url_hp" id="company_url_hp" tabindex="-1" autocomplete="off" />
        </div>
        
        <!-- Nom -->
        <div>
          <label for="user-name" class="block text-sm font-semibold text-midnight mb-1.5 font-heading">
            Votre nom <span class="text-coral">*</span>
          </label>
          <input 
            type="text" 
            name="entry.862584966" 
            id="user-name" 
            required 
            placeholder="Marie Tremblay"
            class="w-full px-4 py-3 rounded-xl border border-slate-300 bg-white text-midnight placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-amethyst text-sm transition-all"
          />
        </div>

        <!-- Courriel -->
        <div>
          <label for="user-email" class="block text-sm font-semibold text-midnight mb-1.5 font-heading">
            Adresse courriel <span class="text-coral">*</span>
          </label>
          <input 
            type="email" 
            name="entry.578521937" 
            id="user-email" 
            required 
            placeholder="marie@exemple.ca"
            class="w-full px-4 py-3 rounded-xl border border-slate-300 bg-white text-midnight placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-amethyst text-sm transition-all"
          />
        </div>

        <!-- Type de demande -->
        <fieldset>
          <legend class="block text-sm font-semibold text-midnight mb-3 font-heading">
            Objet de la demande <span class="text-coral">*</span>
          </legend>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {inquiryTypes.map((type) => (
              <label 
                for={type.id}
                class="flex items-center gap-3 p-3 rounded-xl border border-slate-200 hover:border-amethyst/50 hover:bg-slate-50/70 cursor-pointer transition-colors"
              >
                <input 
                  type="radio" 
                  name="entry.1361511396" 
                  value={type.value} 
                  id={type.id} 
                  checked={type.defaultChecked}
                  class="w-4 h-4 text-amethyst focus:ring-amethyst border-slate-300"
                />
                <span class="text-xs sm:text-sm font-medium text-slate-700">{type.label}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <!-- Message -->
        <div>
          <label for="user-message" class="block text-sm font-semibold text-midnight mb-1.5 font-heading">
            Votre message <span class="text-coral">*</span>
          </label>
          <textarea 
            name="entry.433641966" 
            id="user-message" 
            rows="5" 
            required 
            placeholder="Expliquez-nous comment nous pouvons vous aider..."
            class="w-full px-4 py-3 rounded-xl border border-slate-300 bg-white text-midnight placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-amethyst text-sm transition-all resize-y"
          ></textarea>
        </div>

        <!-- Cloudflare Turnstile Captcha -->
        <div class="pt-2 flex flex-col items-center sm:items-start">
          <div 
            class="cf-turnstile" 
            data-sitekey={turnstileSiteKey}
            data-theme="light"
            data-callback="onTurnstileSuccess"
            data-expired-callback="onTurnstileExpired"
            data-error-callback="onTurnstileError"
          ></div>
          <p id="turnstile-error-msg" class="hidden text-xs text-coral mt-1.5 font-semibold" role="alert" aria-live="assertive">
            Veuillez compléter la vérification ci-dessus avant d'envoyer votre message.
          </p>
        </div>

        <!-- Bouton d'envoi -->
        <div class="pt-1">
          <button 
            id="submit-btn"
            type="submit" 
            class="w-full py-3.5 px-6 rounded-xl font-heading font-bold text-white bg-teal-brand hover:bg-teal-dark shadow-md hover:shadow-lg transition-all focus:outline-none focus:ring-2 focus:ring-teal-brand text-base flex items-center justify-center gap-2"
          >
            <span>Envoyer le message</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>
        </div>

        <p class="text-center text-xs text-slate-500">
          Vos renseignements sont transmis de façon sécurisée à notre équipe et ne sont jamais partagés.
        </p>

      </form>

    </div>

    <!-- Soutien communautaire supplémentaire -->
    <div class="mt-12 text-center text-xs text-slate-500">
      <p>
        Besoin d'aide communautaire ou de conseils d'utilisation ? Rejoignez notre <a href="https://discord.gg/5Hyu7sQTHv" target="_blank" rel="noopener noreferrer" class="text-amethyst font-semibold hover:underline">serveur Discord communautaire</a>.
      </p>
    </div>

  </div>

</BaseLayout>

<script>
  // Fonctions de rappel Turnstile sur window
  (window as any).onTurnstileSuccess = () => {
    const errorMsg = document.getElementById('turnstile-error-msg');
    if (errorMsg) errorMsg.classList.add('hidden');
  };

  (window as any).onTurnstileExpired = () => {
    // Expiré
  };

  (window as any).onTurnstileError = () => {
    const errorMsg = document.getElementById('turnstile-error-msg');
    if (errorMsg) {
      errorMsg.textContent = 'Le service de vérification a rencontré un problème. Veuillez actualiser la page.';
      errorMsg.classList.remove('hidden');
    }
  };

  const form = document.getElementById('zip-contact-form') as HTMLFormElement;
  const successBanner = document.getElementById('form-success-banner');
  const resetBtn = document.getElementById('reset-form-btn');
  const submitBtn = document.getElementById('submit-btn');
  const turnstileErrorMsg = document.getElementById('turnstile-error-msg');

  let isSubmitting = false;

  form?.addEventListener('submit', (e) => {
    if (isSubmitting) {
      e.preventDefault();
      return;
    }

    // 1. Piège à pourriels
    const honeypot = (document.getElementById('company_url_hp') as HTMLInputElement)?.value;
    if (honeypot) {
      e.preventDefault();
      form.classList.add('hidden');
      successBanner?.classList.remove('hidden');
      return;
    }

    // 2. Vérification Turnstile
    const turnstileToken = (form.querySelector('[name="cf-turnstile-response"]') as HTMLInputElement)?.value 
      || (window as any).turnstile?.getResponse();

    if (!turnstileToken) {
      e.preventDefault();
      if (turnstileErrorMsg) {
        turnstileErrorMsg.textContent = "Veuillez compléter la vérification ci-dessus avant d'envoyer votre message.";
        turnstileErrorMsg.classList.remove('hidden');
      }
      return;
    }

    if (turnstileErrorMsg) {
      turnstileErrorMsg.classList.add('hidden');
    }

    // 3. Action dynamique
    form.action = form.dataset.action || "https://docs.google.com/forms/u/0/d/e/1FAIpQLSeat_QYrLNUwVb37U-qYQvWAlhKns2xs9zd_gnsZvI6XmgYow/formResponse";

    isSubmitting = true;
    if (submitBtn) {
      submitBtn.setAttribute('disabled', 'true');
      submitBtn.innerHTML = `
        <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
        </svg>
        <span>Envoi en cours...</span>
      `;
    }

    setTimeout(() => {
      form.classList.add('hidden');
      successBanner?.classList.remove('hidden');
      (successBanner as HTMLElement)?.focus();
      isSubmitting = false;
    }, 1200);
  });

  resetBtn?.addEventListener('click', () => {
    form?.reset();
    form?.classList.remove('hidden');
    successBanner?.classList.add('hidden');
    if (turnstileErrorMsg) {
      turnstileErrorMsg.classList.add('hidden');
    }
    if ((window as any).turnstile) {
      try {
        (window as any).turnstile.reset();
      } catch (err) {
        // ignore
      }
    }
    if (submitBtn) {
      submitBtn.removeAttribute('disabled');
      submitBtn.innerHTML = `
        <span>Envoyer le message</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      `;
    }
  });
</script>
