---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pressReleaseSchema = [
  {
    "@type": "CollectionPage",
    "@id": "https://zipsolutions.org/fr/pressrelease#webpage",
    "url": "https://zipsolutions.org/fr/pressrelease",
    "name": "Communiqués de presse officiels | Solutions Zip",
    "description": "Annonces officielles et déclarations aux médias de Solutions Zip et Zip Captions.",
    "isPartOf": {
      "@id": "https://zipsolutions.org/#website"
    },
    "hasPart": [
      {
        "@type": "NewsArticle",
        "headline": "Solutions Zip lance le mode Image dans l'image (Picture-in-Picture) pour Zip Captions, apportant des sous-titres flottants en direct à n'importe quel écran ou application",
        "datePublished": "2026-10-17T09:00:00-04:00",
        "url": "https://zipsolutions.org/fr/pressrelease#picture-in-picture",
        "publisher": {
          "@id": "https://zipsolutions.org/#organization"
        },
        "inLanguage": "fr"
      },
      {
        "@type": "NewsArticle",
        "headline": "Zip Captions révolutionne l'accessibilité avec des sous-titres en direct assistés par IA",
        "datePublished": "2025-02-01T09:00:00-05:00",
        "url": "https://zipsolutions.org/fr/pressrelease#ai-captions",
        "publisher": {
          "@id": "https://zipsolutions.org/#organization"
        },
        "inLanguage": "fr"
      }
    ]
  }
];
---

<BaseLayout 
  title="Communiqués de presse | Solutions Zip" 
  description="Annonces officielles et déclarations aux médias de Solutions Zip et Zip Captions."
  schema={pressReleaseSchema}
>
  <!-- En-tête -->
  <section class="relative bg-gradient-to-b from-white via-alabaster to-slate-100 border-b border-slate-200/80 pt-16 pb-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <!-- Onglets de navigation secondaire (zéro pilule) -->
      <div class="inline-flex p-1 bg-slate-200/70 rounded-xl mb-8">
        <a 
          href="/fr/press" 
          class="px-5 py-2 rounded-lg text-xs font-bold font-heading text-slate-600 hover:text-midnight transition-colors"
        >
          Distinctions et revue de presse
        </a>
        <a 
          href="/fr/pressrelease" 
          class="px-5 py-2 rounded-lg text-xs font-bold font-heading bg-white text-midnight shadow-sm"
        >
          Communiqués officiels
        </a>
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-midnight font-heading tracking-tight leading-tight">
        Communiqués de presse officiels
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Annonces directes, étapes marquantes de nos produits et ressources médias de l'équipe Solutions Zip.
      </p>
    </div>
  </section>

  <!-- Conteneur principal des communiqués -->
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20 space-y-16">

    <!-- Index des communiqués / Accès rapide -->
    <div class="bg-white rounded-2xl border border-slate-200/80 p-4 sm:p-5 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-center gap-2.5">
        <span class="w-2.5 h-2.5 rounded-full bg-teal-brand animate-pulse"></span>
        <span class="text-xs font-bold uppercase tracking-wider text-slate-600 font-mono">Archives des communiqués</span>
      </div>
      <div class="flex flex-wrap items-center gap-2 sm:gap-3 text-xs font-bold font-heading">
        <a 
          href="#picture-in-picture" 
          class="px-3.5 py-1.5 rounded-lg bg-teal-50 text-teal-800 hover:bg-teal-100 border border-teal-200/60 transition-all flex items-center gap-1.5"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-teal-600"></span>
          <span>Dernier : Mode Image dans l'image (Oct. 2026)</span>
        </a>
        <a 
          href="#ai-captions" 
          class="px-3.5 py-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200 border border-slate-200/70 transition-all flex items-center gap-1.5"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
          <span>Sous-titres assistés par IA (Fév. 2025)</span>
        </a>
      </div>
    </div>

    <!-- COMMUNIQUÉ 1 (LE PLUS RÉCENT) : MODE IMAGE DANS L'IMAGE -->
    <article id="picture-in-picture" class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden scroll-mt-24">
      <!-- Barre supérieure de métadonnées -->
      <div class="bg-slate-50 border-b border-slate-200 px-6 sm:px-10 py-4 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-2">
          <span class="text-coral text-xs font-bold font-mono tracking-wider uppercase">
            Pour diffusion immédiate
          </span>
          <span class="text-slate-400">•</span>
          <span class="text-xs text-slate-500 font-medium">
            Montréal, Québec • Octobre 2026
          </span>
        </div>

        <a 
          href="/files/Press Release - Picture in Picture.pdf" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-midnight hover:bg-slate-800 text-white text-xs font-bold font-heading shadow-sm transition-all"
        >
          <svg class="w-4 h-4 text-teal-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>Télécharger le PDF officiel</span>
        </a>
      </div>

      <!-- Corps du communiqué -->
      <div class="p-6 sm:p-10 lg:p-14 space-y-8">
        <div>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-midnight font-heading tracking-tight leading-tight mb-4">
            Solutions Zip lance le mode Image dans l'image (Picture-in-Picture) pour Zip Captions, apportant des sous-titres flottants en direct à n'importe quel écran ou application
          </h2>
          <p class="text-lg sm:text-xl font-medium text-amethyst">
            Cette nouvelle fonctionnalité intégrée au navigateur élimine le jonglage entre fenêtres pour les enseignants, les télétravailleurs et les organisateurs d'événements en permettant aux sous-titres en direct de flotter harmonieusement par-dessus les présentations, documents et logiciels en plein écran.
          </p>
        </div>

        <hr class="border-slate-100" />

        <div class="prose prose-slate max-w-none text-slate-700 text-base sm:text-lg leading-relaxed space-y-6">
          <p>
            <strong class="text-midnight uppercase tracking-wide text-sm font-heading">Montréal (Québec) —</strong> 
            Solutions Zip, le créateur québécois de technologies d'assistance et d'outils de communication accessibles, a annoncé aujourd'hui le lancement du mode Image dans l'image (Picture-in-Picture / PiP) pour son application web phare, Zip Captions. Disponible immédiatement et entièrement gratuit, ce nouvel outil permet aux utilisateurs de détacher les sous-titres en direct de leur navigateur web pour les placer dans une fenêtre flottante redimensionnable et toujours au premier plan, visible au-dessus des applications de bureau.
          </p>

          <p>
            Pendant des années, le sous-titrage en direct sur navigateur s'accompagnait d'un inconvénient pratique : dès qu'un utilisateur clique dans un autre programme, ouvre une présentation plein écran ou commence à prendre des notes dans une fenêtre distincte, l'onglet du navigateur disparaît, emportant les sous-titres avec lui. Les utilisateurs travaillant sur un écran d'ordinateur portable unique devaient jusqu'ici scinder maladroitement leur affichage ou recourir à plusieurs moniteurs pour lire les sous-titres tout en travaillant ou en enseignant.
          </p>

          <p>
            Grâce à la nouvelle fonctionnalité Image dans l'image de Zip Captions, un simple clic détache le flux de sous-titrage en direct dans une fenêtre autonome superposée à l'écran de l'utilisateur. Qu'un utilisateur présente un diaporama PowerPoint, fasse une démonstration logicielle, modifie une feuille de calcul ou rédige des notes dans un document, les sous-titres demeurent épinglés au premier plan. Les utilisateurs peuvent redimensionner librement la fenêtre, la déplacer vers n'importe quel coin de leur écran et conserver leurs réglages de police et de contraste élevé personnalisés.
          </p>

          <blockquote class="border-l-4 border-amethyst pl-6 py-4 italic text-slate-800 font-medium bg-purple-50/40 rounded-r-2xl my-6 space-y-3">
            <p class="text-base sm:text-lg leading-relaxed">
              « En tant qu'enseignant, je sais d'expérience que personne n'enseigne à partir d'un onglet de navigateur vide : on passe constamment d'un diaporama à un PDF, à des vidéos et à des outils interactifs », a déclaré Chris Webb, PDG et cofondateur de Solutions Zip. « Jusqu'à maintenant, garder les sous-titres en direct visibles sur un projecteur signifiait sacrifier de l'espace d'écran ou composer avec des solutions de contournement complexes. L'Image dans l'image résout cela immédiatement : vous détachez les sous-titres, vous les placez où vous le souhaitez, et vous enseignez, tout simplement. »
            </p>
            <div class="flex items-center gap-3 not-italic pt-1">
              <img 
                src="/images/Chris_Circle.png" 
                alt="Chris Webb" 
                class="w-10 h-10 rounded-full object-cover border border-purple-200"
                loading="lazy"
              />
              <div>
                <div class="font-bold font-heading text-sm text-midnight">Chris Webb</div>
                <div class="text-xs text-slate-500 font-medium">PDG et cofondateur, Solutions Zip</div>
              </div>
            </div>
          </blockquote>

          <p>
            Puisque la fonctionnalité est directement intégrée au moteur web de Zip Captions, elle ne requiert aucun téléchargement de logiciel, aucune extension de navigateur ni autorisation d'administrateur informatique. Il s'agit d'un avantage décisif pour les Chromebooks scolaires et les ordinateurs portables d'entreprise verrouillés.
          </p>

          <blockquote class="border-l-4 border-teal-brand pl-6 py-4 italic text-slate-800 font-medium bg-teal-50/40 rounded-r-2xl my-6 space-y-3">
            <p class="text-base sm:text-lg leading-relaxed">
              « Notre objectif à chaque mise à jour est d'éliminer les irritants sans jamais compromettre la confidentialité des utilisateurs », a expliqué James Petersen, directeur technique et cofondateur de Solutions Zip. « En tirant parti des fonctionnalités natives d'Image dans l'image du navigateur, nous offrons la possibilité de superposer des sous-titres sur l'ensemble du système d'exploitation, le tout sans aucune installation et avec un traitement 100 % local dans le navigateur. »
            </p>
            <div class="flex items-center gap-3 not-italic pt-1">
              <img 
                src="/images/James_Circle.png" 
                alt="James Petersen" 
                class="w-10 h-10 rounded-full object-cover border border-teal-200"
                loading="lazy"
              />
              <div>
                <div class="font-bold font-heading text-sm text-midnight">James Petersen</div>
                <div class="text-xs text-slate-500 font-medium">Directeur technique et cofondateur, Solutions Zip</div>
              </div>
            </div>
          </blockquote>

          <h3 class="text-xl sm:text-2xl font-bold font-heading text-midnight pt-4">
            Transformer l'accessibilité à travers les secteurs
          </h3>
          <p class="text-slate-600 text-sm sm:text-base">
            L'introduction du mode Image dans l'image ouvre des flux de travail pratiques au quotidien dans de multiples contextes :
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 not-prose">
            <div class="p-5 sm:p-6 rounded-2xl bg-alabaster border border-slate-200">
              <span class="text-xs font-bold uppercase tracking-wider text-teal-brand font-heading block mb-1">
                Milieu scolaire
              </span>
              <h4 class="font-bold text-midnight text-base font-heading mb-1.5">Salles de classe et amphithéâtres</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
                Les enseignants peuvent afficher des sous-titres en direct directement par-dessus des présentations plein écran, des tableaux numériques ou des environnements de codage sans masquer le matériel pédagogique. Les élèves recevant des sous-titres diffusés sur leurs propres appareils peuvent faire flotter le texte juste à côté de leurs notes numériques.
              </p>
            </div>

            <div class="p-5 sm:p-6 rounded-2xl bg-alabaster border border-slate-200">
              <span class="text-xs font-bold uppercase tracking-wider text-amethyst font-heading block mb-1">
                Entreprise et télétravail
              </span>
              <h4 class="font-bold text-midnight text-base font-heading mb-1.5">Milieux de travail et collaboration à distance</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
                Les employés sourds, malentendants ou neurodivergents (comme ceux ayant un TDAH ou un trouble du traitement auditif) peuvent suivre les conversations en direct tout en collaborant activement dans des documents partagés, des outils de design ou des feuilles de calcul sur un seul écran.
              </p>
            </div>

            <div class="p-5 sm:p-6 rounded-2xl bg-alabaster border border-slate-200">
              <span class="text-xs font-bold uppercase tracking-wider text-teal-brand font-heading block mb-1">
                Communautaire
              </span>
              <h4 class="font-bold text-midnight text-base font-heading mb-1.5">Lieux de culte et espaces communautaires</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
                Les équipes audiovisuelles bénévoles peuvent aisément faire glisser une barre de sous-titres claire et lisible sur les diaporamas, les annonces ou la lecture vidéo, sans nécessiter de commutateurs vidéo spécialisés ni de logiciels de diffusion complexes.
              </p>
            </div>

            <div class="p-5 sm:p-6 rounded-2xl bg-alabaster border border-slate-200">
              <span class="text-xs font-bold uppercase tracking-wider text-amethyst font-heading block mb-1">
                Scène et conférences
              </span>
              <h4 class="font-bold text-midnight text-base font-heading mb-1.5">Conférences et séminaires en direct</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
                Les conférenciers effectuant des démonstrations de logiciels en direct peuvent basculer librement d'une application à l'autre sur scène pendant que la fenêtre flottante de sous-titrage reste ancrée sur l'écran principal de l'auditorium.
              </p>
            </div>
          </div>

          <p class="pt-4">
            Fidèle à la mission fondamentale de Solutions Zip, la mise à jour Image dans l'image est accessible à tous les utilisateurs sur la formule gratuite de Zip Captions, fonctionnant de manière parfaitement fluide tant avec la reconnaissance vocale standard du navigateur qu'avec le moteur optionnel de sous-titrage assisté par IA d'Azure. Comme pour toutes les sessions Zip Captions, l'audio n'est jamais enregistré et les transcriptions demeurent stockées en toute confidentialité dans la mémoire locale du navigateur.
          </p>

          <p>
            Pour essayer la nouvelle fonctionnalité Image dans l'image ou en apprendre davantage sur Zip Captions, visitez <a href="https://zipcaptions.app" target="_blank" rel="noopener noreferrer" class="font-bold text-teal-brand hover:underline">zipcaptions.app</a> ou découvrez la suite complète d'outils d'accessibilité de l'organisation sur <a href="/fr" class="font-bold text-teal-brand hover:underline">zipsolutions.org</a>.
          </p>

          <!-- À propos de Solutions Zip -->
          <div class="mt-8 pt-6 border-t border-slate-200/80 not-prose">
            <h4 class="text-base font-bold font-heading text-midnight mb-2">À propos de Solutions Zip</h4>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
              Établie près de Montréal (Québec), Solutions Zip (« La maison de l'accessibilité ») a été fondée par des enseignants et des ingénieurs logiciels déterminés à concevoir des technologies d'assistance privées, intuitives et dignes. Guidée par un comité consultatif d'éducateurs certifiés pour les personnes sourdes et de défenseurs de la communauté, Solutions Zip développe des outils ouverts et sans barrières, notamment Zip Captions, Easy Speak CAA, et des passerelles d'intégration de diffusion pour les écoles, les milieux de travail, les lieux de culte et les événements en direct partout dans le monde.
            </p>
          </div>

          <!-- Coordonnées médias -->
          <div class="mt-6 pt-4 border-t border-slate-100 text-xs text-slate-600 not-prose flex flex-wrap gap-x-6 gap-y-2">
            <div><strong class="text-midnight font-sans">Relations médias :</strong> Solutions Zip</div>
            <div><strong class="text-midnight font-sans">Courriel :</strong> <a href="mailto:media@zipcaptions.app" class="text-teal-brand hover:underline">media@zipcaptions.app</a></div>
            <div><strong class="text-midnight font-sans">Site web :</strong> <a href="https://www.zipsolutions.org" class="text-teal-brand hover:underline">https://www.zipsolutions.org</a></div>
            <div><strong class="text-midnight font-sans">Portail applicatif :</strong> <a href="https://zipcaptions.app" target="_blank" rel="noopener noreferrer" class="text-teal-brand hover:underline">https://zipcaptions.app</a></div>
          </div>
        </div>

        <!-- Pied du document -->
        <div class="pt-8 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="text-xs text-slate-500">
            Identifiant officiel du document : <code class="font-mono bg-slate-100 px-2 py-1 rounded text-slate-700">PR-2026-10-PIPMODE</code>
          </div>

          <a 
            href="/files/Press Release - Picture in Picture.pdf" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-teal-brand hover:bg-teal-700 text-white text-sm font-bold font-heading shadow-sm transition-all"
          >
            <span>Voir le communiqué complet (PDF)</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>
    </article>

    <!-- COMMUNIQUÉ 2 : SOUS-TITRES ASSISTÉS PAR IA -->
    <article id="ai-captions" class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden scroll-mt-24">
      <!-- Barre supérieure de métadonnées -->
      <div class="bg-slate-50 border-b border-slate-200 px-6 sm:px-10 py-4 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-2">
          <span class="text-coral text-xs font-bold font-mono tracking-wider uppercase">
            Pour diffusion immédiate
          </span>
          <span class="text-slate-400">•</span>
          <span class="text-xs text-slate-500 font-medium">
            Montréal, Québec • Février 2025
          </span>
        </div>

        <a 
          href="/files/Press Release - AI Captions.pdf" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-midnight hover:bg-slate-800 text-white text-xs font-bold font-heading shadow-sm transition-all"
        >
          <svg class="w-4 h-4 text-teal-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>Télécharger le PDF officiel</span>
        </a>
      </div>

      <!-- Corps du communiqué -->
      <div class="p-6 sm:p-10 lg:p-14 space-y-8">
        <div>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-midnight font-heading tracking-tight leading-tight mb-4">
            Zip Captions révolutionne l'accessibilité avec des sous-titres en direct assistés par IA
          </h2>
          <p class="text-lg sm:text-xl font-medium text-amethyst">
            Les sous-titres IA complètent nos solutions existantes de sous-titrage en direct entièrement gratuites.
          </p>
        </div>

        <hr class="border-slate-100" />

        <div class="prose prose-slate max-w-none text-slate-700 text-base sm:text-lg leading-relaxed space-y-6">
          <p>
            <strong class="text-midnight uppercase tracking-wide text-sm font-heading">Montréal (Québec) :</strong> 
            Zip Captions, solution de référence de sous-titrage en direct gratuit, a annoncé aujourd'hui le lancement de sa nouvelle fonctionnalité de sous-titrage assisté par IA, propulsée par Microsoft Azure. Cette mise à niveau majeure offre aux soutiens Patreon des sous-titres en direct nettement plus précis, créant une expérience fluide et compréhensible pour les personnes vivant avec une perte auditive, un TDAH, des troubles du traitement auditif ou une neuropathie auditive.
          </p>

          <p>
            Le nouveau moteur d'intelligence artificielle traite la parole à travers des modèles acoustiques et linguistiques de pointe, assurant une précision remarquable dans les environnements acoustiques difficiles, les salles de conférence bruyantes et les cours magistraux au rythme soutenu.
          </p>

          <blockquote class="border-l-4 border-amethyst pl-6 py-2 italic text-slate-800 font-medium bg-slate-50/60 rounded-r-2xl my-6">
            "Notre mission première a toujours été l'accès universel et digne à la parole. En introduisant un sous-titrage IA de pointe tout en maintenant notre formule de base 100% gratuite et ouverte, nous rendons les outils de compréhension de nouvelle génération accessibles aux salles de classe, aux lieux de culte et aux événements sans créer de barrières financières."
          </blockquote>

          <h3 class="text-xl font-bold font-heading text-midnight pt-4">
            Points clés de cette mise à niveau :
          </h3>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 not-prose">
            <div class="p-5 rounded-2xl bg-alabaster border border-slate-200">
              <span class="text-xs font-bold uppercase tracking-wider text-teal-brand font-heading block mb-1">
                Intelligence avancée
              </span>
              <h4 class="font-bold text-midnight text-base font-heading mb-1">Azure AI Cognitive Speech</h4>
              <p class="text-slate-600 text-xs sm:text-sm">
                Des modèles de reconnaissance vocale de premier plan garantissent une exactitude contextuelle profonde pour les termes spécialisés, les accents et les tournures complexes.
              </p>
            </div>

            <div class="p-5 rounded-2xl bg-alabaster border border-slate-200">
              <span class="text-xs font-bold uppercase tracking-wider text-amethyst font-heading block mb-1">
                Accessibilité universelle
              </span>
              <h4 class="font-bold text-midnight text-base font-heading mb-1">Formule gratuite préservée</h4>
              <p class="text-slate-600 text-xs sm:text-sm">
                Le moteur vocal intégré au navigateur demeure 100% gratuit pour tous les utilisateurs, avec une durée de session illimitée.
              </p>
            </div>

            <div class="p-5 rounded-2xl bg-alabaster border border-slate-200">
              <span class="text-xs font-bold uppercase tracking-wider text-teal-brand font-heading block mb-1">
                Compatibilité étendue
              </span>
              <h4 class="font-bold text-midnight text-base font-heading mb-1">Moteur web multiplateforme</h4>
              <p class="text-slate-600 text-xs sm:text-sm">
                Fonctionnement instantané sur Chromebooks, Windows, macOS, iPadOS, iOS, Android et Linux sans aucun programme à installer.
              </p>
            </div>

            <div class="p-5 rounded-2xl bg-alabaster border border-slate-200">
              <span class="text-xs font-bold uppercase tracking-wider text-amethyst font-heading block mb-1">
                Intégration professionnelle
