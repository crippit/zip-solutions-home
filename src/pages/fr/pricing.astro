---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqSection from '../../components/FaqSection.astro';

const tiers = [
  {
    name: "Standard",
    price: "0 $",
    period: "pour toujours",
    description: "Sous-titrage standard direct dans le navigateur pour un usage individuel.",
    highlight: false,
    ctaText: "Commencer",
    ctaLink: "https://zipcaptions.app",
    external: true,
  },
  {
    name: "Communautaire",
    price: "0 $",
    period: "via Patreon",
    description: "Rejoignez notre communauté Patreon gratuite pour les mises à jour et l'assistance.",
    highlight: false,
    ctaText: "Rejoindre gratuitement",
    ctaLink: "https://patreon.com/zipcaptions",
    external: true,
  },
  {
    name: "Essentiel",
    price: "5 $",
    period: "par mois",
    description: "Débloquez 5 heures de sous-titrage assisté par IA chaque mois.",
    highlight: false,
    ctaText: "Choisir Essentiel",
    ctaLink: "https://www.patreon.com/zipcaptions/membership",
    external: true,
  },
  {
    name: "Premium",
    price: "15 $",
    period: "par mois",
    description: "Idéal pour les enseignants, créateurs et sessions personnelles régulières (10 heures d'IA).",
    highlight: true,
    badge: "Le plus populaire",
    ctaText: "Choisir Premium",
    ctaLink: "https://patreon.com/zipcaptions/membership",
    external: true,
  },
  {
    name: "Platine",
    price: "30 $",
    period: "par mois",
    description: "Capacité maximale pour usage individuel (25 heures d'IA), articles exclusifs et priorité.",
    highlight: false,
    ctaText: "Choisir Platine",
    ctaLink: "https://patreon.com/zipcaptions/membership",
    external: true,
  },
];

const features = [
  { name: "Sous-titrage standard", values: ["Illimité", "Illimité", "Illimité", "Illimité", "Illimité"] },
  { name: "Navigateurs (Sous-titrage)", values: ["Chrome, Safari et Edge²", "Chrome, Safari et Edge²", "Tous navigateurs¹", "Tous navigateurs¹", "Tous navigateurs¹"] },
  { name: "Lecture Broadcast / Code QR", values: ["Tous navigateurs¹", "Tous navigateurs¹", "Tous navigateurs¹", "Tous navigateurs¹", "Tous navigateurs¹"] },
  { name: "Mode Image dans l'image (PiP)", values: ["Chromium (Chrome, Edge)⁸", "Chromium (Chrome, Edge)⁸", "Chromium (Chrome, Edge)⁸", "Chromium (Chrome, Edge)⁸", "Chromium (Chrome, Edge)⁸"] },
  { name: "Traduction en temps réel", values: ["IA sur appareil Chrome⁹", "IA sur appareil Chrome⁹", "IA sur appareil Chrome⁹", "IA sur appareil Chrome⁹", "IA sur appareil Chrome⁹"] },
  { name: "Sous-titres IA (/mois)³", values: ["-", "Sur demande⁷", "5 heures³", "10 heures³", "25 heures³"] },
  { name: "Transcription et exportation", values: ["Oui", "Oui", "Oui", "Oui", "Oui"] },
  { name: "Apparence personnalisable", values: ["Oui", "Oui", "Oui", "Oui", "Oui"] },
  { name: "Application mobile Android⁴", values: ["Oui", "Oui", "Oui", "Oui", "Oui"] },
  { name: "Navigateur mobile compatible", values: ["Oui", "Oui", "Oui", "Oui", "Oui"] },
  { name: "Application Windows disponible", values: ["Oui", "Oui", "Oui", "Oui", "Oui"] },
  { name: "Assistance disponible⁵", values: ["Groupe Discord", "Groupe Discord", "Assistance prioritaire", "Assistance prioritaire", "Assistance prioritaire"] },
  { name: "Conforme au RGPD", values: ["Oui", "Oui", "Oui", "Oui", "Oui"] },
  { name: "Pack d'articles exclusifs", values: ["-", "-", "-", "-", "Oui"] },
];

const faqs = [
  {
    question: "Que se passe-t-il si nos heures de sous-titrage IA s'épuisent en plein milieu d'un cours, d'une messe ou d'une conférence ? L'écran devient-il noir ?",
    answer: "Jamais. Nous ne coupons jamais la parole au milieu d'une présentation. Si votre quota mensuel d'heures IA (5 h pour Essentiel, 10 h pour Premium ou 25 h pour Platine) est atteint en cours de séance, vous pouvez basculer instantanément vers le sous-titrage Standard gratuit (0 $) et illimité en un clic (dans Chrome, Safari ou Edge), tout en conservant le même code de salle Broadcast et votre connexion OBS ou vMix."
  },
  {
    question: "Dans quelles situations ai-je réellement besoin du sous-titrage IA payant (5 $ à 30 $ US/mois) plutôt que du mode Standard gratuit à 0 $ ?",
    answer: "Si vous utilisez Google Chrome, Apple Safari ou Microsoft Edge dans un local calme avec un bon micro-cravate ou micro-casque, le mode Standard à 0 $ suffit amplement et reste illimité pour toujours. Le moteur IA payant (propulsé par Microsoft Azure AI) répond aux défis acoustiques plus complexes : micros de lutrin éloignés, églises ou salles réverbérantes, accents régionaux marqués, vocabulaire médical, scientifique ou liturgique pointu, ou captation dans des navigateurs qui ne prennent pas en charge le sous-titrage gratuit (comme Firefox, Brave ou Opera). La lecture d'un flux partagé par code de salle Broadcast ou code QR fonctionne gratuitement dans n'importe quel navigateur."
  },
  {
    question: "Faut-il payer un supplément lorsque 50 élèves ou 300 congressistes scannent notre code QR pour lire les sous-titres sur leur téléphone ?",
    answer: "Non. La lecture des sous-titres par les participants via le mode Diffusion (Broadcast) et les codes QR est 100 % gratuite et illimitée dans tous les forfaits, y compris le forfait Standard à 0 $. Vous ne payez jamais au nombre de lecteurs ou d'appareils connectés."
  },
  {
    question: "Notre centre de services scolaire, université ou entreprise ne peut pas utiliser Patreon ou a besoin d'un accompagnement dédié. Comment fonctionne la tarification Entreprise ?",
    answer: "Les abonnements Patreon sont conçus pour un usage personnel ou individuel. Pour les déploiements en entreprise, les colloques multi-salles ou les établissements nécessitant un soutien dédié et une facturation par bon de commande (PO), notre tarif Entreprise est de 1 000 $ pour 1 jour (1 salle incluse), 250 $ par jour additionnel et 200 $/jour par salle supplémentaire. Utilisez notre calculateur de devis Entreprise (/fr/enterprise-pricing) pour configurer votre événement et soumettre votre demande."
  },
  {
    question: "Les outils EasySpeak CAA, EquiBrowse et Zip Solutions Remediator nécessitent-ils un abonnement Patreon ?",
    answer: "Non. Toutes nos autres applications — incluant Zip EasySpeak et EasySpeak AI (CAA hors ligne), EquiBrowse, Zip Speech pour Google Meet, ZipPanel, Zip Connect et Zip Captions pour vMix — sont 100 % gratuites (0 $) sans abonnement. Zip Solutions Remediator pour Google Workspace est également gratuit et fonctionne avec votre propre clé API Google Gemini (modèle BYOK), évitant tout coût de licence par élève."
  }
];
const pricingSchema = {
  "@type": "SoftwareApplication",
  "@id": "https://zipsolutions.org/fr/pricing#software",
  "name": "Zip Captions",
  "applicationCategory": "EducationalApplication, UtilitiesApplication, MultimediaApplication",
  "operatingSystem": "All (Web Browser, Windows, macOS, Linux, ChromeOS, iOS, Android)",
  "url": "https://zipcaptions.app",
  "publisher": {
    "@id": "https://zipsolutions.org/#organization"
  },
  "offers": [
    {
      "@type": "Offer",
      "name": "Forfait Standard (Sous-titrage en direct sur navigateur)",
      "price": "0.00",
      "priceCurrency": "USD",
      "description": "Sous-titrage en direct sur navigateur 100 % gratuit pour toujours, utilisation illimitée, codes de salle et intégration OBS/vMix.",
      "availability": "https://schema.org/InStock",
      "url": "https://zipcaptions.app"
    },
    {
      "@type": "Offer",
      "name": "Forfait Communautaire (Patreon gratuit)",
      "price": "0.00",
      "priceCurrency": "USD",
      "description": "Adhésion communautaire gratuite sur Patreon avec mises à jour, soutien Discord et accès complet au sous-titrage standard.",
      "availability": "https://schema.org/InStock",
      "url": "https://patreon.com/zipcaptions"
    },
    {
      "@type": "Offer",
      "name": "Forfait Essentiel (5 heures/mois de sous-titrage IA)",
      "price": "5.00",
      "priceCurrency": "USD",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": "5.00",
        "priceCurrency": "USD",
        "billingDuration": "P1M"
      },
      "description": "Débloque 5 heures de sous-titrage en direct assisté par intelligence artificielle chaque mois.",
      "availability": "https://schema.org/InStock",
      "url": "https://www.patreon.com/zipcaptions/membership"
    },
    {
      "@type": "Offer",
      "name": "Forfait Premium (10 heures/mois de sous-titrage IA)",
      "price": "15.00",
      "priceCurrency": "USD",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": "15.00",
        "priceCurrency": "USD",
        "billingDuration": "P1M"
      },
      "description": "Débloque 10 heures de sous-titrage en direct assisté par IA chaque mois pour les cours, réunions et diffusions.",
      "availability": "https://schema.org/InStock",
      "url": "https://www.patreon.com/zipcaptions/membership"
    },
    {
      "@type": "Offer",
      "name": "Forfait Platine (25 heures/mois de sous-titrage IA + Articles exclusifs)",
      "price": "30.00",
      "priceCurrency": "USD",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": "30.00",
        "priceCurrency": "USD",
        "billingDuration": "P1M"
      },
      "description": "Débloque 25 heures de sous-titrage en direct assisté par IA chaque mois ainsi que des articles exclusifs.",
      "availability": "https://schema.org/InStock",
      "url": "https://www.patreon.com/zipcaptions/membership"
    }
  ]
};
---

<BaseLayout 
  title="Tarifs de Zip Captions — Sous-titrage en direct gratuit et forfaits IA" 
  description="Zip Captions est 100 % gratuit pour le sous-titrage standard sur navigateur. Découvrez nos forfaits mensuels accessibles dès 5 $/mois pour la transcription par intelligence artificielle."
  schema={pricingSchema}
  faqs={faqs}
>
  
  <section class="bg-gradient-to-b from-white to-slate-50 border-b border-slate-200/80 pt-12 pb-14 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-sm font-bold text-amethyst tracking-wide uppercase mb-3 font-heading">
        Équitable et transparent
      </p>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-midnight font-heading">
        Tarifs de Zip Captions
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Zip Captions proposera toujours une version de base 100 % gratuite. Les abonnements Patreon sont conçus pour un <strong>usage personnel ou individuel</strong>, tandis que les entreprises et événements nécessitant un soutien dédié peuvent créer un devis sur mesure avec notre <strong>calculateur de devis Entreprise</strong>.
      </p>

      <!-- Sélecteur de profil d'utilisation -->
      <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4 text-left max-w-3xl mx-auto">
        <a 
          href="#personal-plans" 
          class="p-5 rounded-2xl bg-white border-2 border-amethyst/40 hover:border-amethyst shadow-xs transition-all flex flex-col justify-between group"
        >
          <div>
            <span class="text-xs font-bold font-mono uppercase tracking-wider text-amethyst block mb-1">
              Usage personnel et individuel
            </span>
            <h2 class="text-base sm:text-lg font-bold font-heading text-midnight">
              Forfaits gratuits et mensuels Patreon (0 $ à 30 $/mois)
            </h2>
            <p class="text-xs text-slate-600 mt-1 leading-relaxed">
              Sous-titrage en libre-service et forfaits d'heures IA mensuels via Patreon pour utilisateurs individuels, enseignants et créateurs.
            </p>
          </div>
          <span class="mt-3 text-xs font-bold text-amethyst group-hover:underline inline-flex items-center gap-1">
            <span>Voir les forfaits individuels ci-dessous</span>
            <span aria-hidden="true">&darr;</span>
          </span>
        </a>

        <a 
          href="/fr/enterprise-pricing" 
          class="p-5 rounded-2xl bg-midnight text-white border-2 border-midnight hover:border-teal-brand shadow-md transition-all flex flex-col justify-between group"
        >
          <div>
            <span class="text-xs font-bold font-mono uppercase tracking-wider text-teal-light block mb-1">
              Entreprises et événements avec soutien
            </span>
            <h2 class="text-base sm:text-lg font-bold font-heading text-white">
              Calculateur de devis Entreprise sur mesure
            </h2>
            <p class="text-xs text-slate-300 mt-1 leading-relaxed">
              1 000 $ Jour 1 • +250 $ par jour suppl. • +200 $/jour par salle suppl. Inclut soutien dédié et facturation PO.
            </p>
          </div>
          <span class="mt-3 text-xs font-bold text-teal-light group-hover:underline inline-flex items-center gap-1">
            <span>Créer un devis Entreprise</span>
            <span aria-hidden="true">&rarr;</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Cartes de tarification -->
  <div id="personal-plans" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 scroll-mt-20">
    <div class="mb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div>
        <span class="text-xs font-bold font-mono uppercase tracking-wider text-amethyst block mb-1">
          Abonnements individuels en libre-service
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold font-heading text-midnight">
          Forfaits pour usage personnel et individuel (via Patreon)
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 mt-1">
          Le soutien via Patreon est destiné à un usage personnel ou individuel. Besoin d'un déploiement en entreprise, de plusieurs salles ou d'une facture sur bon de commande ? <a href="/fr/enterprise-pricing" class="text-teal-brand font-bold underline hover:text-teal-dark">Utilisez le calculateur de devis Entreprise &rarr;</a>
        </p>
      </div>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 mb-16">
      {tiers.map((tier) => (
        <div class={`rounded-3xl p-6 flex flex-col justify-between transition-all duration-200 ${
          tier.highlight 
            ? 'bg-midnight text-white ring-2 ring-amethyst shadow-xl relative' 
            : 'bg-white text-midnight border border-slate-200 shadow-sm hover:shadow-md'
        }`}>
          <div>
            {tier.badge && (
              <span class="inline-block mb-3 px-2.5 py-1 rounded-md text-xs font-bold uppercase tracking-wider bg-amethyst text-white">
                {tier.badge}
              </span>
            )}
            <h2 class={`text-lg font-bold font-heading mb-1 ${tier.highlight ? 'text-white' : 'text-midnight'}`}>
              {tier.name}
            </h2>
            <p class={`text-xs mb-4 min-h-[32px] ${tier.highlight ? 'text-slate-300' : 'text-slate-500'}`}>
              {tier.description}
            </p>
            <div class="mb-6">
              <span class={`text-3xl sm:text-4xl font-extrabold font-heading ${tier.highlight ? 'text-white' : 'text-midnight'}`}>
                {tier.price}
              </span>
              <span class={`text-xs ml-1 ${tier.highlight ? 'text-slate-300' : 'text-slate-500'}`}>
                / {tier.period}
              </span>
            </div>
          </div>

          <a 
            href={tier.ctaLink}
            target={tier.external ? "_blank" : undefined}
            rel={tier.external ? "noopener noreferrer" : undefined}
            class={`w-full py-2.5 px-4 rounded-xl text-center text-xs font-bold font-heading transition-colors ${
              tier.highlight
                ? 'bg-amethyst hover:bg-amethyst-dark text-white'
                : 'bg-slate-100 hover:bg-slate-200 text-midnight'
            }`}
          >
            {tier.ctaText}
          </a>
        </div>
      ))}
    </div>

    <!-- Tableau comparatif -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden mb-12">
      <div class="px-6 py-5 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between">
        <h2 class="text-xl font-bold font-heading text-midnight">Matrice comparative des fonctionnalités</h2>
        <span class="text-xs text-slate-500">Faites défiler horizontalement sur petit écran</span>
      </div>
      
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse min-w-[700px]">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-200 text-xs uppercase tracking-wider text-slate-500">
              <th class="p-4 font-bold">Fonctionnalité</th>
              {tiers.map((t) => (
                <th class={`p-4 font-bold text-center ${t.highlight ? 'bg-purple-50/60 text-amethyst' : ''}`}>
                  {t.name}
                </th>
              ))}
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-sm">
            {features.map((feat) => (
              <tr class="hover:bg-slate-50/60 transition-colors">
                <td class="p-4 font-medium text-slate-800">
                  {feat.name}
                </td>
                {feat.values.map((val, idx) => (
                  <td class={`p-4 text-center ${tiers[idx].highlight ? 'bg-purple-50/30 font-semibold text-midnight' : 'text-slate-600'}`}>
                    {val === "Oui" ? (
                      <span class="inline-flex items-center text-teal-brand font-semibold">
                        <svg class="w-4 h-4 mr-1 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                        </svg>
                        Oui
                      </span>
                    ) : (
                      val
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Bannière Entreprise et événements accompagnés -->
    <div class="bg-gradient-to-br from-midnight to-slate-900 text-white rounded-3xl p-8 sm:p-10 border border-slate-800 shadow-xl mb-12 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8">
      <div class="space-y-3 max-w-2xl">
        <span class="text-xs font-bold font-mono uppercase tracking-wider text-teal-light block">
          Entreprises et événements en direct accompagnés
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold font-heading text-white">
          Besoin de Zip Captions pour une entreprise ou un événement multi-salles avec soutien dédié ?
        </h2>
        <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
          Alors que les paliers Patreon sont réservés à un usage personnel et individuel, notre modèle Entreprise comprend l'accompagnement technique dédié, la configuration du vocabulaire IA, les relais QR multi-salles et la facturation officielle (bon de commande / PO) :
        </p>
        <div class="flex flex-wrap gap-3 pt-1 text-xs font-mono">
          <span class="px-3 py-1.5 rounded-xl bg-white/10 border border-white/15 text-white font-bold">
            1 Jour = 1 000 $
          </span>
          <span class="px-3 py-1.5 rounded-xl bg-white/10 border border-white/15 text-teal-light font-bold">
            Chaque jour suppl. = +250 $
          </span>
          <span class="px-3 py-1.5 rounded-xl bg-white/10 border border-white/15 text-coral-light font-bold">
            Salles suppl. = +200 $ / salle / jour
          </span>
        </div>
      </div>
      <div class="shrink-0 w-full lg:w-auto">
        <a 
          href="/fr/enterprise-pricing" 
          class="w-full lg:w-auto inline-flex items-center justify-center gap-2 px-7 py-4 rounded-xl font-heading font-bold text-white bg-teal-brand hover:bg-teal-light hover:text-midnight shadow-md transition-all text-sm sm:text-base"
        >
          <span>Ouvrir le calculateur de devis Entreprise</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>

    <!-- Notes explicatives -->
    <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200 text-xs text-slate-600 space-y-2 leading-relaxed">
      <p><b>1.</b> Le sous-titrage IA payant ainsi que la lecture d'une salle Broadcast / code QR fonctionnent dans tous les navigateurs modernes (notamment Google Chrome, Microsoft Edge, Apple Safari, Mozilla Firefox, Opera et Brave).</p>
      <p><b>2.</b> Le sous-titrage standard gratuit (captation microphone) est pris en charge dans Google Chrome, Apple Safari et Microsoft Edge. Les navigateurs comme Firefox, Brave et Opera nécessitent un forfait IA payant pour capter la voix, mais permettent de suivre gratuitement les sous-titres partagés en mode Broadcast / code QR.</p>
      <p><b>3.</b> Le nombre d'heures est calculé sur l'utilisation de jetons attribués selon votre palier Patreon, sous réserve d'un abonnement actif. L'attribution des jetons peut évoluer et bénéficie du soutien de Microsoft Founders Hub.</p>
      <p><b>4.</b> Zip Captions est installable depuis Google Play Store, et fonctionne également sur iOS via le navigateur ou en application web progressive (PWA).</p>
      <p><b>5.</b> Une assistance est disponible pour tous les forfaits. Les délais de réponse varient et les formules d'entrée de gamme s'appuient principalement sur la communauté.</p>
      <p><b>6.</b> Les tarifs sont exprimés en dollars américains (USD) et peuvent être révisés à tout moment.</p>
      <p><b>7.</b> Des demandes d'accès gratuit peuvent être formulées à tout moment par les organismes et établissements admissibles. <a href="/fr/givingback" class="text-teal-brand font-medium underline">En savoir plus sur notre engagement solidaire</a>.</p>
      <p><b>8.</b> Le mode flottant Image dans l'image (Picture-in-Picture) est pris en charge sur les navigateurs Chromium pour ordinateur (Google Chrome, Microsoft Edge, Brave, Opera) via l'API Document Picture-in-Picture. Des navigateurs comme Firefox et Safari ne prennent pas actuellement en charge cette norme Document Picture-in-Picture.</p>
      <p><b>9.</b> La traduction gratuite de sous-titres en temps réel est propulsée par les modèles d'IA sur appareil (On-Device AI) intégrés à Google Chrome, s'exécutant localement dans Chrome avec un téléchargement de langue en un clic et sans frais d'abonnement infonuagique.</p>
    </div>

  </div>

  <FaqSection faqs={faqs} groupName="faq-fr-pricing" />

</BaseLayout>
