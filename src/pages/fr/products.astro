---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ZipDashboard from '../../components/ZipDashboard.astro';
import FaqSection from '../../components/FaqSection.astro';

const productsFaqs = [
  {
    question: "Comment savoir si nos équipes peuvent utiliser vos outils web gratuits (0 $) en autonomie ou s'il est préférable de faire appel à votre équipe événementielle ?",
    answer: "Pour un cours en classe, une célébration hebdomadaire, un comptoir d'accueil clinique ou une diffusion OBS/vMix avec un micro clair, notre application gratuite Zip Captions (0 $ ou 5 $ à 30 $/mois pour l'IA) et nos guides PDF gratuits suffisent amplement. Faites appel à notre service événementiel sur mesure lorsque vous organisez un congrès multi-salles, une conférence hybride avec invités distants ou une pièce de théâtre nécessitant un surtitrage synchronisé par nos techniciens."
  },
  {
    question: "Des intégrateurs audiovisuels nous ont soumis un devis de plus de 15 000 $ pour un système d'aide à l'écoute. Comment fonctionne votre modèle de consultation accompagnée ?",
    answer: "Beaucoup d'écoles, de lieux de culte et de théâtres communautaires renoncent à l'accessibilité auditive en raison des marges élevées sur le matériel propriétaire. Dans le cadre de notre service de consultation en aide à l'écoute, nous analysons votre salle et votre console existante, puis nous vous fournissons une liste d'achat précise (ex. Phonak Roger ou écoute assistée par Wi-Fi) et un schéma de câblage clair pour que votre équipe locale puisse l'installer à une fraction du coût habituel."
  },
  {
    question: "Notre centre de services scolaire peut-il déployer vos extensions Chrome (EquiBrowse, ZipPanel, Zip Speech) via la console d'administration Google ?",
    answer: "Oui. Toutes nos extensions sont publiées sur le Chrome Web Store et le Google Workspace Marketplace selon la norme Manifest V3. Les administrateurs TI peuvent les autoriser ou les déployer par unité organisationnelle (UO) sur les Chromebooks scolaires en quelques minutes, sans aucune collecte de données personnelles d'élèves."
  },
  {
    question: "Dans quelles régions offrez-vous vos services sur place par rapport à l'accompagnement à distance ?",
    answer: "Basés dans le Grand Montréal (Québec, Canada), nous intervenons sur place pour la production d'événements, le sous-titrage et surtitrage, l'éclairage architectural (ETC Mosaic), la sonorisation et les formations Google pour l'éducation à Montréal, partout au Québec et à travers le Canada — et à distance dans le monde entier."
  }
];

const productsPageSchema = {
  "@type": "CollectionPage",
  "@id": "https://zipsolutions.org/fr/products#collection",
  "name": "Tous les outils d'accessibilité, logiciels de sous-titrage et services | Solutions Zip",
  "url": "https://zipsolutions.org/fr/products",
  "inLanguage": "fr-CA",
  "description": "Catalogue complet des 18 solutions d'accessibilité de Solutions Zip : sous-titrage en direct gratuit Zip Captions, CAA hors ligne EasySpeak, Remediator mathématique, production d'événements hybrides, formations Google pour l'éducation et conseil AV.",
  "about": {
    "@id": "https://zipsolutions.org/#organization"
  },
  "mainEntity": {
    "@type": "ItemList",
    "name": "Produits et services de Solutions Zip",
    "numberOfItems": 18,
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Zip Captions — Sous-titrage en direct gratuit sur navigateur (0 $ / IA optionnelle 5 $ à 30 $ US/mois)", "url": "https://zipsolutions.org/fr/zipcaptions" },
      { "@type": "ListItem", "position": 2, "name": "Zip Captions pour vMix — Intégration de diffusion en direct (0 $ Gratuit)", "url": "https://zipsolutions.org/fr/zipvmix" },
      { "@type": "ListItem", "position": 3, "name": "Zip Captions Companion — Pont Stream Deck et Bitfocus (0 $ Gratuit)", "url": "https://zipsolutions.org/fr/zipcaptionscompanion" },
      { "@type": "ListItem", "position": 4, "name": "ZipPanel — Superposition flottante de sous-titres Chrome (0 $ Gratuit)", "url": "https://zipsolutions.org/fr/zippanel" },
      { "@type": "ListItem", "position": 5, "name": "Zip Connect — Pont Twitch et multi-appareils (0 $ Gratuit)", "url": "https://zipsolutions.org/fr/zipconnect" },
      { "@type": "ListItem", "position": 6, "name": "Sous-titrage sur mesure pour événements en direct et surtitrage (Devis sur mesure — Montréal, Québec, Canada et International)", "url": "https://zipsolutions.org/fr/live-event-quotes" },
      { "@type": "ListItem", "position": 7, "name": "Zip EasySpeak — Application web et mobile de CAA (0 $ Gratuit et code ouvert)", "url": "https://zipsolutions.org/fr/easyspeak" },
      { "@type": "ListItem", "position": 8, "name": "Zip EasySpeak AI — CAA hors ligne propulsée par l'IA (0 $ Gratuit)", "url": "https://zipsolutions.org/fr/easyspeak" },
      { "@type": "ListItem", "position": 9, "name": "Zip EasySpeak for Education — Tableau de bord enseignant (0 $ Gratuit)", "url": "https://zipsolutions.org/fr/easyspeak" },
      { "@type": "ListItem", "position": 10, "name": "Zip Speech — Injection vocale CAA pour Google Meet (0 $ Gratuit)", "url": "https://zipsolutions.org/fr/zipspeech" },
      { "@type": "ListItem", "position": 11, "name": "EquiBrowse — Extension Chrome de lecture à voix haute et dictionnaire visuel (0 $ Gratuit)", "url": "https://zipsolutions.org/fr/equibrowse" },
      { "@type": "ListItem", "position": 12, "name": "EquiAssess — Plateforme d'évaluation sommative accessible (Gratuit pour les enseignants)", "url": "https://equiassess.zipsolutions.org" },
      { "@type": "ListItem", "position": 13, "name": "Zip Solutions Remediator — Évaluation formative en mathématiques pour Google Workspace (0 $ Gratuit BYOK)", "url": "https://zipsolutions.org/fr/zipmath" },
      { "@type": "ListItem", "position": 14, "name": "Organisation d'événements en présentiel et hybrides & Formations Google pour l'éducation (Devis sur mesure — Montréal, Québec, Canada et Virtuel)", "url": "https://zipsolutions.org/fr/events" },
      { "@type": "ListItem", "position": 15, "name": "Consultation en systèmes d'aide à l'écoute (Devis sur mesure — Montréal, Québec, Canada et à distance)", "url": "https://zipsolutions.org/fr/contact-us" },
      { "@type": "ListItem", "position": 16, "name": "Systèmes numériques de sonorisation et d'éclairage architectural (Devis sur mesure — Montréal, Québec et Canada)", "url": "https://zipsolutions.org/fr/contact-us" },
      { "@type": "ListItem", "position": 17, "name": "Consultation en sous-titrage et surtitrage (Devis sur mesure — Montréal, Québec, Canada et International)", "url": "https://zipsolutions.org/fr/contact-us" },
      { "@type": "ListItem", "position": 18, "name": "Ressources gratuites pour l'accessibilité auditive (0 $ Base de connaissances ouverte)", "url": "https://resources.zipsolutions.org" }
    ]
  }
};
---

<BaseLayout 
  title="Outils d'accessibilité, applications CAA et services de sous-titrage | Solutions Zip"
  description="Découvrez l'ensemble des outils d'accessibilité de Solutions Zip : sous-titrage en direct gratuit, applications de CAA hors ligne, outils Google Workspace et production d'événements hybrides."
  schema={productsPageSchema}
  faqs={productsFaqs}
>
  <!-- En-tête -->
  <section class="bg-gradient-to-b from-white to-slate-50 border-b border-slate-200/80 pt-12 pb-14 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-sm font-bold text-amethyst tracking-wide uppercase mb-3 font-heading">
        Écosystème et services
      </p>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-midnight font-heading">
        Produits, services et solutions événementielles
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Des logiciels d'accessibilité novateurs à l'organisation complète d'événements, en passant par la webdiffusion de congrès hybrides et le sous-titrage en direct sur mesure, nous offrons des solutions d'accessibilité intégrales.
      </p>
    </div>
  </section>

  <!-- Services en vedette : Organisation d'événements et sous-titres sur mesure -->
  <section class="py-12 bg-white border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-10">
        <p class="text-xs sm:text-sm font-bold text-teal-brand tracking-wide uppercase mb-2 font-heading">
          Services institutionnels et professionnels
        </p>
        <h2 class="text-2xl sm:text-4xl font-extrabold font-heading text-midnight">
          Nos services événementiels et de formation
        </h2>
        <p class="mt-3 text-slate-600 text-sm sm:text-base">
          Direction technique spécialisée, gestion d'événements en présentiel et infrastructure de sous-titrage dédiée, appuyées par un soutien technique expert.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        
        <!-- Service 1: Organisation d'événements en présentiel et hybrides -->
        <div class="bg-gradient-to-br from-slate-50 to-white rounded-3xl p-8 sm:p-10 border border-slate-200 shadow-sm hover:shadow-lg transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-4 mb-5">
              <span class="p-3.5 rounded-2xl bg-amethyst text-white shadow-md shrink-0">
                <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
              </span>
              <h3 class="text-xl sm:text-2xl font-bold font-heading text-midnight leading-snug">
                Organisation d'événements en présentiel et hybrides
              </h3>
            </div>

            <p class="text-slate-600 text-sm sm:text-base leading-relaxed mb-4">
              Nous assurons l'organisation complète d'événements pour les établissements d'enseignement, congrès et organismes sans but lucratif. De l'infrastructure technique à la webdiffusion et à l'interaction des participants, nous prenons en charge chaque détail afin que votre équipe puisse se consacrer au contenu.
            </p>

            <div class="space-y-3 mb-6">
              <div class="p-4 rounded-2xl bg-white border border-slate-200 text-xs sm:text-sm text-slate-700">
                <strong class="text-midnight block mb-1">Conférences hybrides et virtuelles d'envergure :</strong>
                Gestion de sessions complexes multi-salles, intégration d'intervenants distants et synchronisation des flux d'accessibilité en temps réel.
              </div>

              <div class="p-4 rounded-2xl bg-white border border-slate-200 text-xs sm:text-sm text-slate-700">
                <strong class="text-midnight block mb-1">Formations Google pour l'éducation et perfectionnement sur mesure :</strong>
                Ateliers de perfectionnement professionnel pratiques pour le personnel enseignant, les équipes administratives et les entreprises sur Google Workspace, l'IA Gemini et les technologies inclusives, animés par des formateurs certifiés Google.
              </div>
            </div>
          </div>

          <div class="pt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-4">
            <a 
              href="/fr/events" 
              class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-coral hover:bg-rose-600 text-white font-heading font-bold text-sm rounded-xl shadow-sm transition-all"
            >
              <span>En savoir plus et planifier</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
            <span class="text-xs font-semibold text-slate-500">Hybride • Virtuel • Présentiel</span>
          </div>
        </div>

        <!-- Service 2: Solutions personnalisées Zip Captions pour événements en direct -->
        <div class="bg-gradient-to-br from-slate-50 to-white rounded-3xl p-8 sm:p-10 border border-slate-200 shadow-sm hover:shadow-lg transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-4 mb-5">
              <span class="p-3.5 rounded-2xl bg-teal-brand text-white shadow-md shrink-0">
                <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
              </span>
              <h3 class="text-xl sm:text-2xl font-bold font-heading text-midnight leading-snug">
                Sous-titres sur mesure pour événements
              </h3>
            </div>

            <p class="text-slate-600 text-sm sm:text-base leading-relaxed mb-4">
              Besoin d'un sous-titrage en direct fiable et flexible pour une conférence en auditorium, une pièce de théâtre, un rassemblement communautaire ou un colloque ? Nous déployons Zip Captions selon les exigences de votre salle.
            </p>

            <div class="space-y-3 mb-6">
              <div class="p-4 rounded-2xl bg-white border border-slate-200 text-xs sm:text-sm text-slate-700">
                <strong class="text-midnight block mb-1">Surtitrage scénique et affichage de diffusion :</strong>
                Personnalisation visuelle pour écrans de salle, retours de scène, bandeaux de diffusion ou relais web sur smartphones des participants.
              </div>

              <div class="p-4 rounded-2xl bg-white border border-slate-200 text-xs sm:text-sm text-slate-700">
                <strong class="text-midnight block mb-1">Devis personnalisés :</strong>
                Nous établissons des devis clairs et adaptés selon la durée de votre événement, la taille de l'auditoire et les besoins techniques.
              </div>
            </div>
          </div>

          <div class="pt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-4">
            <a 
              href="/fr/live-event-quotes" 
              class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-teal-brand hover:bg-teal-dark text-white font-heading font-bold text-sm rounded-xl shadow-sm transition-all"
            >
              <span>Découvrir les sous-titres et devis</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
            <span class="text-xs font-semibold text-slate-500">Auditoriums • Théâtre • Webdiffusion</span>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- Répertoire interactif complet -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="mb-8">
      <h2 class="text-2xl sm:text-3xl font-bold font-heading text-midnight">
        Explorer tous nos produits et solutions
      </h2>
      <p class="text-slate-600 text-sm sm:text-base mt-1">
        Recherchez et filtrez l'ensemble de notre catalogue d'applications web, d'outils d'IA, d'extensions et de programmes d'accompagnement.
      </p>
    </div>
    <ZipDashboard />
  </section>

  <FaqSection
    faqs={productsFaqs}
    title="Choisir entre outils gratuits en libre-service, déploiement scolaire et régie sur mesure"
    subtitle="Questions concrètes de mise en œuvre"
    groupName="faq-fr-products"
  />
</BaseLayout>
