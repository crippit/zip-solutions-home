---
import ProductLayout from '../../layouts/ProductLayout.astro';

const capabilities = [
  {
    title: "Injection directe dans le flux microphonique",
    description: "Contrairement aux logiciels habituels de synthèse vocale qui diffusent le son par les haut-parleurs physiques de l'ordinateur (provoquant un écho désagréable), Zip Speech injecte l'audio directement dans le flux microphonique de Google Meet."
  },
  {
    title: "Restitution vocale cristalline",
    description: "Les autres participants vous entendent nettement, comme si vous vous exprimiez vous-même, tout en vous permettant de continuer à entendre le son de la réunion sans perturbations acoustiques."
  },
  {
    title: "Prise en charge CAA et phrases préenregistrées",
    description: "Un tableau de phrases prédéfinies de CAA permet d'intervenir spontanément et facilement lors des réunions et échanges au rythme soutenu."
  },
  {
    title: "Traduction automatique des phrases",
    description: "Les formules usuelles intégrées s'adaptent et se traduisent automatiquement lorsque la langue est modifiée, facilitant les échanges multilingues."
  },
  {
    title: "Accents et langues multiples",
    description: "Tapez pour parler directement dans l'appel en choisissant parmi des dizaines de voix naturelles, d'accents et de rythmes de diction disponibles sur votre équipement."
  },
  {
    title: "Compatibilité avec tous les navigateurs de bureau",
    description: "Extensions officielles certifiées pour Google Chrome, Apple Safari pour macOS, Microsoft Edge et Mozilla Firefox."
  }
];

const specs = [
  { label: "Spécialement conçu pour Google Meet", value: "Développé pour garantir une expression vocale accessible lors des visioconférences Google Meet sur ordinateur." },
  { label: "Tous les grands navigateurs", value: "Disponible sous forme d'extension officielle sur Chrome, Safari pour Mac, Microsoft Edge et Firefox." },
  { label: "Parole limpide sans écho", value: "Le signal audio s'insère directement dans le flux du microphone sans larsen ni retour de haut-parleur." },
  { label: "Communication spontanée", value: "Des phrases CAA prêtes à l'emploi vous permettent d'intervenir sans délai, avec traduction multilingue instantanée." }
];

const faqs = [
  {
    question: "Dans Google Meet, les messages écrits dans le clavardage passent souvent inaperçus et la réduction de bruit bloque le son d'une tablette CAA placée devant le micro. Comment Zip Speech résout-il cela ?",
    answer: "Le filtre antibruit de Google Meet coupe souvent les haut-parleurs externes, et les participants regardent rarement le volet de clavardage. Zip Speech injecte directement la voix de synthèse dans le flux microphone WebRTC sortant de Google Meet à l'intérieur du navigateur : dès que vous saisissez une phrase, votre vignette s'illumine et tous les participants vous entendent avec une clarté parfaite."
  },
  {
    question: "Faut-il installer des pilotes de câbles audio virtuels (comme VB-Cable) souvent bloqués par les services informatiques scolaires ?",
    answer: "Non. Les pilotes audio virtuels exigent des droits d'administrateur et dérèglent souvent les paramètres de son. Zip Speech gère le routage audio à 100 % à l'intérieur de l'extension sur Chrome, Safari (macOS), Edge et Firefox, sans aucun pilote système à installer."
  },
  {
    question: "Puis-je préparer des phrases rapides à l'avance pour ne pas prendre de retard dans une réunion animée ?",
    answer: "Oui. Zip Speech permet d'enregistrer des boutons de réponses rapides CAA et de choisir parmi plusieurs voix et langues pour intervenir instantanément au fil de la conversation."
  }
];
---

<ProductLayout
  title="Extension de navigateur Zip Speech"
  seoTitle="Zip Speech — Extension CAA et synthèse vocale directe pour Google Meet"
  subtitle="Donnez une voix à chacun dans Google Meet"
  description="Zip Speech donne la parole à celles et ceux qui ne peuvent s'exprimer oralement dans Google Meet. Saisissez votre texte pour vous exprimer directement dans la conférence avec un vaste choix de voix, d'accents et de langues. Un outil d'accessibilité conçu pour que chaque personne prenne sa place dans les échanges."
  actions={[
    { 
      text: "Installer pour Chrome", 
      url: "https://chromewebstore.google.com/detail/zip-speech/abmneamgapjekkemjihkhokdgpdeejff", 
      primary: true, 
      external: true 
    },
    { 
      text: "Safari pour Mac", 
      url: "https://apps.apple.com/ca/app/zip-speech/id6758924987?mt=12", 
      external: true 
    },
    { 
      text: "Module pour Edge", 
      url: "https://microsoftedge.microsoft.com/addons/detail/zip-speech/apjbgpfgcknniiicblbmehecojgfdgip", 
      external: true 
    }
  ]}
  capabilities={capabilities}
  specs={specs}
  faqs={faqs}
  ctaTitle="Faites entendre votre voix dans chaque rencontre virtuelle"
  ctaDescription="Installez Zip Speech dès aujourd'hui et profitez d'une communication vocale naturelle et sans écho dans Google Meet."
  ctaAction={{ 
    text: "Obtenir Zip Speech pour Chrome", 
    url: "https://chromewebstore.google.com/detail/zip-speech/abmneamgapjekkemjihkhokdgpdeejff", 
    external: true 
  }}
>

  <!-- Problem & Solution Comparison Showcase -->
  <div class="space-y-12 mt-8">
    <div class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-sm space-y-8">
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold font-heading text-midnight">
          Pourquoi l'injection directe dans le microphone change tout
        </h2>
        <p class="mt-3 text-slate-600 text-sm sm:text-base max-w-3xl leading-relaxed">
          À la différence des outils de synthèse vocale classiques qui jouent le son par les haut-parleurs physiques de l'appareil (créant un effet d'écho), Zip Speech achemine numériquement le son dans le flux de votre microphone Google Meet. Vos interlocuteurs vous reçoivent ainsi avec une clarté remarquable, comme si vous parliez vous-même, tandis que vous continuez d'entendre parfaitement la réunion.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- The Old Way -->
        <div class="p-6 rounded-2xl bg-rose-50/50 border border-rose-100 space-y-3">
          <div class="flex items-center gap-2 text-rose-700 font-bold font-heading">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
            <span>Synthèse par haut-parleurs physiques</span>
          </div>
          <p class="text-slate-600 text-sm leading-relaxed">
            Le son sort par les haut-parleurs de l'ordinateur portable et est repris par le microphone. Cela entraîne un larsen gênant, des fins de mots hachées, un volume instable et de la confusion entre les participants.
          </p>
        </div>

        <!-- The Zip Speech Way -->
        <div class="p-6 rounded-2xl bg-teal-50/50 border border-teal-100 space-y-3">
          <div class="flex items-center gap-2 text-teal-800 font-bold font-heading">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>L'approche innovante de Zip Speech</span>
          </div>
          <p class="text-slate-600 text-sm leading-relaxed">
            La parole générée est insérée numériquement au cœur du flux audio de Google Meet. L'assemblée bénéficie d'une intelligibilité parfaite pendant que votre propre écoute demeure totalement confortable.
          </p>
        </div>
      </div>
    </div>

    <!-- AAC Support Highlight -->
    <div class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-sm space-y-4">
      <h2 class="text-2xl font-bold font-heading text-midnight">
        Prise en charge intégrée des phrases de CAA
      </h2>
      <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
        Dans notre dernière version, nous avons incorporé un système de CAA pour les personnes ayant besoin de phrases préétablies. Les formules de base se traduisent automatiquement lors d'un changement de langue, permettant de participer naturellement et promptement au sein de toute équipe.
      </p>
    </div>

    <!-- Download For All Browsers Grid -->
    <div class="bg-white rounded-3xl p-8 sm:p-10 border border-slate-200 shadow-sm text-center">
      <h3 class="text-xl font-bold font-heading text-midnight mb-2">
        Installez Zip Speech sur votre navigateur de prédilection
      </h3>
      <p class="text-slate-600 text-sm mb-8">
        Choisissez votre plateforme ci-dessous pour télécharger et installer Zip Speech gratuitement.
      </p>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <a 
          href="https://chromewebstore.google.com/detail/zip-speech/abmneamgapjekkemjihkhokdgpdeejff"
          target="_blank"
          rel="noopener noreferrer"
          class="p-5 rounded-2xl border border-slate-200 bg-slate-50 hover:bg-white hover:border-amethyst/50 transition-all text-center group shadow-sm"
        >
          <span class="block font-bold text-midnight group-hover:text-amethyst text-sm sm:text-base">Google Chrome</span>
          <span class="text-xs text-slate-500">Chrome Web Store</span>
        </a>

        <a 
          href="https://apps.apple.com/ca/app/zip-speech/id6758924987?mt=12"
          target="_blank"
          rel="noopener noreferrer"
          class="p-5 rounded-2xl border border-slate-200 bg-slate-50 hover:bg-white hover:border-amethyst/50 transition-all text-center group shadow-sm"
        >
          <span class="block font-bold text-midnight group-hover:text-amethyst text-sm sm:text-base">Safari (Mac)</span>
          <span class="text-xs text-slate-500">Mac App Store</span>
        </a>

        <a 
          href="https://microsoftedge.microsoft.com/addons/detail/zip-speech/apjbgpfgcknniiicblbmehecojgfdgip"
          target="_blank"
          rel="noopener noreferrer"
          class="p-5 rounded-2xl border border-slate-200 bg-slate-50 hover:bg-white hover:border-amethyst/50 transition-all text-center group shadow-sm"
        >
          <span class="block font-bold text-midnight group-hover:text-amethyst text-sm sm:text-base">Microsoft Edge</span>
          <span class="text-xs text-slate-500">Edge Add-ons</span>
        </a>

        <a 
          href="https://addons.mozilla.org/en-CA/firefox/addon/zip-speech/"
          target="_blank"
          rel="noopener noreferrer"
          class="p-5 rounded-2xl border border-slate-200 bg-slate-50 hover:bg-white hover:border-amethyst/50 transition-all text-center group shadow-sm"
        >
          <span class="block font-bold text-midnight group-hover:text-amethyst text-sm sm:text-base">Mozilla Firefox</span>
          <span class="text-xs text-slate-500">Firefox Add-ons</span>
        </a>
      </div>
    </div>
  </div>

</ProductLayout>
