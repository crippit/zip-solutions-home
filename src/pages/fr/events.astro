---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pillars = [
  {
    title: "Sessions hybrides et webdiffusion multi-salles",
    description: "Vous planifiez un événement accueillant à la fois des participants sur place et à distance ? Nous configurons et gérons des flux en direct stables et synchronisés sur plusieurs salles ou amphithéâtres, pour que votre équipe puisse se concentrer sur le programme.",
    icon: "broadcast"
  },
  {
    title: "Accompagnement des conférenciers à distance",
    description: "Vous invitez un intervenant par visioconférence ? Nous effectuons des répétitions préalables et intégrons harmonieusement son image et sa voix sur les écrans de projection de la salle ou sur le flux en direct.",
    icon: "video"
  },
  {
    title: "L'accessibilité intégrée dès la conception",
    description: "L'accessibilité est trop souvent reléguée au dernier moment. Nous l'intégrons dès le début dans la planification technique : sous-titres en direct, dispositifs d'écoute assistée et lisibilité optimale des présentations.",
    icon: "accessibility"
  },
  {
    title: "Ateliers de développement professionnel sur mesure",
    description: "Au-delà de la logistique du jour J, nous animons des formations pratiques pour enseignants, gestionnaires et équipes techniques sur les outils d'assistance, la CAA en classe et les technologies éducatives inclusives.",
    icon: "graduation"
  }
];

const timelineSteps = [
  {
    step: "01",
    title: "Consultation initiale",
    description: "Nous échangeons sur votre horaire, la configuration du lieu, l'équipement audio disponible et vos besoins spécifiques de diffusion ou d'enregistrement."
  },
  {
    step: "02",
    title: "Planification et tests préalables",
    description: "Nous structurons le déroulement technique, testons les connexions à distance à l'avance et validons les régies audio et vidéo."
  },
  {
    step: "03",
    title: "Soutien le jour de l'événement",
    description: "Une présence technique attentive pour assurer le bon déroulement de vos présentations, de vos webdiffusions et de l'accessibilité pour chaque participant."
  }
];

const idealAudiences = [
  "Journées de développement professionnel et congrès de pédagogues",
  "Colloques universitaires et cycles de conférences académiques",
  "Assemblées citoyennes et congrès d'organismes à but non lucratif",
  "Rencontres hybrides d'associations et assemblées générales annuelles"
];
const eventServiceSchema = {
  "@type": "Service",
  "name": "Organisation d'événements en présentiel et hybrides et formation professionnelle",
  "provider": {
    "@id": "https://zipsolutions.org/#organization"
  },
  "serviceType": "Production de congrès hybrides, webdiffusion multi-salles et formation continue en éducation",
  "description": "Production technique concrète, webdiffusion hybride multi-salles et ateliers de formation sur mesure pour écoles, congrès et associations.",
  "url": "https://zipsolutions.org/fr/events"
};
---

<BaseLayout 
  title="Organisation d'événements hybrides, webdiffusion et formation | Solutions Zip" 
  description="Production technique concrète, webdiffusion hybride multi-salles, sous-titrage en direct et ateliers de formation sur mesure pour écoles, congrès et associations."
  schema={eventServiceSchema}
>

  <!-- En-tête -->
  <section class="bg-gradient-to-b from-white to-slate-50 border-b border-slate-200/80 pt-14 pb-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-sm font-bold text-coral tracking-wide uppercase mb-3 font-heading">
        Événements éducatifs et communautaires
      </p>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-midnight font-heading leading-tight">
        Organisation d'événements en présentiel et hybrides
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Production technique concrète, webdiffusion hybride multi-salles et ateliers de perfectionnement professionnel adaptés aux écoles, colloques et organismes.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href="/fr/contact-us" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl font-heading font-bold text-white bg-coral hover:bg-rose-600 shadow-md hover:shadow-lg transition-all text-sm"
        >
          <span>Échanger sur votre événement</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        <a 
          href="#services" 
          class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-3.5 rounded-xl font-heading font-bold text-slate-700 hover:text-midnight bg-slate-100 hover:bg-slate-200 transition-colors text-sm"
        >
          Découvrir nos services
        </a>
      </div>
    </div>
  </section>

  <!-- Grille des services principaux -->
  <section id="services" class="py-16 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <p class="text-xs font-bold uppercase tracking-wider text-teal-brand font-heading mb-2">
        Notre accompagnement
      </p>
      <h2 class="text-2xl sm:text-4xl font-extrabold font-heading text-midnight">
        Production concrète et présence sur le terrain
      </h2>
      <p class="mt-3 text-slate-600 text-sm sm:text-base leading-relaxed">
        Nous prenons en charge les détails techniques et l'infrastructure de diffusion pour que vos intervenants puissent partager leurs idées en toute sérénité.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {pillars.map((pillar) => (
        <div class="bg-white rounded-3xl p-8 sm:p-10 border border-slate-200 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-coral/10 text-coral flex items-center justify-center mb-6">
              {pillar.icon === 'broadcast' && (
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.343 9.343c5.857-5.857 15.355-5.857 21.213 0" />
                </svg>
              )}
              {pillar.icon === 'video' && (
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
              )}
              {pillar.icon === 'accessibility' && (
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
              )}
              {pillar.icon === 'graduation' && (
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14v7" />
                </svg>
              )}
            </div>

            <h3 class="text-xl font-bold font-heading text-midnight mb-3">
              {pillar.title}
            </h3>

            <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
              {pillar.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Déroulement de la collaboration -->
  <section class="py-16 bg-slate-50 border-y border-slate-200/80">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <p class="text-xs font-bold uppercase tracking-wider text-amethyst font-heading mb-2">
          Méthode de collaboration
        </p>
        <h2 class="text-2xl sm:text-3xl font-extrabold font-heading text-midnight">
          Comment nous travaillons ensemble
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {timelineSteps.map((step) => (
          <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm relative">
            <span class="text-3xl font-black text-coral/30 font-mono block mb-3">
              {step.step}
            </span>
            <h3 class="text-lg font-bold font-heading text-midnight mb-2">
              {step.title}
            </h3>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contextes idéaux (zéro pilule) -->
  <section class="py-16 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-gradient-to-br from-midnight to-slate-900 rounded-3xl p-8 sm:p-12 text-white shadow-xl">
      <div class="max-w-2xl">
        <span class="text-xs font-bold uppercase tracking-wider text-teal-brand font-heading block mb-2">
          Cadres d'intervention
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold font-heading tracking-tight mb-4">
          Événements et rencontres accompagnés
        </h2>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-6">
          Que votre événement soit entièrement en présentiel, totalement virtuel ou hybride avec plusieurs ateliers simultanés, nous adaptons notre dispositif aux spécificités de votre lieu et de vos participants.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 pt-2">
        {idealAudiences.map((audience) => (
          <div class="flex items-center gap-3 p-3.5 rounded-2xl bg-white/5 border border-white/10 text-xs sm:text-sm text-slate-200 font-medium">
            <span class="w-5 h-5 rounded-lg bg-teal-brand/20 text-teal-brand flex items-center justify-center text-xs font-bold shrink-0">✓</span>
            <span>{audience}</span>
          </div>
        ))}
      </div>

      <div class="mt-8 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="text-xs text-slate-400">
          Des questions sur votre salle ou votre équipement ?
        </p>
        <div class="flex flex-wrap items-center gap-3">
          <a 
            href="/fr/live-event-quotes#quote-form" 
            class="inline-flex items-center gap-2 px-6 py-2.5 bg-teal-brand hover:bg-teal-dark text-white font-heading font-bold text-xs rounded-xl shadow-sm transition-all"
          >
            <span>Demander un devis événementiel</span>
            <span class="text-base leading-none">&rarr;</span>
          </a>
          <a 
            href="/fr/contact-us" 
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-white/10 hover:bg-white/20 text-white font-heading font-bold text-xs rounded-xl transition-all"
          >
            <span>Contact général</span>
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
