---
import BaseLayout from '../../layouts/BaseLayout.astro';

const homeSchema = [
  {
    "@type": "WebPage",
    "@id": "https://zipsolutions.org/fr#webpage",
    "url": "https://zipsolutions.org/fr",
    "name": "Solutions Zip (Zip Solutions) — La maison de l'accessibilité",
    "inLanguage": "fr-CA",
    "description": "Sous-titrage en direct gratuit sur navigateur (Zip Captions), outils de CAA hors ligne (EasySpeak), évaluation mathématique IA (Remediator), production d'événements hybrides, surtitrage en direct sur mesure, formation Google pour l'éducation et conseil audiovisuel.",
    "isPartOf": {
      "@id": "https://zipsolutions.org/#website"
    },
    "about": {
      "@id": "https://zipsolutions.org/#organization"
    },
    "mainEntity": {
      "@id": "https://zipsolutions.org/#organization"
    }
  },
  {
    "@type": "SoftwareApplication",
    "@id": "https://zipsolutions.org/#zipcaptions",
    "name": "Zip Captions",
    "url": "https://zipcaptions.app",
    "applicationCategory": "EducationalApplication, UtilitiesApplication, MultimediaApplication",
    "operatingSystem": "All (Web Browser, Windows, macOS, Linux, ChromeOS, iOS, Android)",
    "publisher": {
      "@id": "https://zipsolutions.org/#organization"
    },
    "offers": [
      {
        "@type": "Offer",
        "name": "Forfait Régulier — Sous-titrage en direct sur navigateur (Gratuit pour toujours)",
        "price": "0.00",
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://zipcaptions.app"
      },
      {
        "@type": "Offer",
        "name": "Forfait Essentiel — 5 heures/mois de sous-titrage IA",
        "price": "5.00",
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://zipsolutions.org/fr/pricing"
      },
      {
        "@type": "Offer",
        "name": "Forfait Premium — 10 heures/mois de sous-titrage IA",
        "price": "15.00",
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://zipsolutions.org/fr/pricing"
      },
      {
        "@type": "Offer",
        "name": "Forfait Platine — 25 heures/mois de sous-titrage IA + Articles exclusifs",
        "price": "30.00",
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://zipsolutions.org/fr/pricing"
      }
    ]
  }
];

const features = [
  {
    title: "Sous-titrage en direct et diffusion",
    details: "Transcription en temps réel dans le navigateur avec Zip Captions, accompagnée des passerelles vMix, Stream Deck Companion, ZipPanel et Zip Connect.",
    icon: "captions",
    badge: "Famille 01 • Phare",
    color: "bg-amethyst",
    href: "/fr/zipcaptions",
    linkText: "Découvrir Zip Captions",
    secondaryHref: "https://zipcaptions.app",
    secondaryLinkText: "Lancer l'appli ↗",
    secondaryExternal: true,
  },
  {
    title: "CAA et synthèse vocale",
    details: "Communication digne avec Zip EasySpeak, prédiction par IA locale hors ligne, tableaux imprimables pour la classe et Zip Speech pour Google Meet.",
    icon: "chat",
    badge: "Famille 02 • IA hors ligne",
    color: "bg-teal-brand",
    href: "/fr/easyspeak",
    linkText: "Explorer EasySpeak CAA",
    secondaryHref: "/fr/zipspeech",
    secondaryLinkText: "Zip Speech",
  },
  {
    title: "Lecture équitable et apprentissage",
    details: "Lecture bionique, polices adaptées à la dyslexie et filtres visuels avec EquiBrowse, ainsi que notre outil gratuit d'adaptation mathématique Gemini (BYOK) pour Google Workspace.",
    icon: "book",
    badge: "Famille 03 • Scolaire",
    color: "bg-indigo-600",
    href: "/fr/zipmath",
    linkText: "Zip Math Remediator",
    secondaryHref: "/fr/equibrowse",
    secondaryLinkText: "EquiBrowse",
  },
  {
    title: "Production d'événements et formations",
    details: "Production clé en main de conférences en présentiel, hybrides et virtuelles, surtitrage sur scène, relais QR mobiles et ateliers par formateur certifié Google pour l'éducation.",
    icon: "calendar",
    badge: "Famille 04 • Événements",
    color: "bg-coral",
    href: "/fr/events",
    linkText: "Événements et formations",
    secondaryHref: "/fr/enterprise-pricing",
    secondaryLinkText: "Devis instantané",
  },
  {
    title: "Conseil AV et trousses imprimables",
    details: "Architecture d'écoute assistée neutre (Phonak Roger, audio Wi-Fi), sonorisation et éclairage de scène, ainsi que nos trousses sectorielles bilingues à imprimer.",
    icon: "headphones",
    badge: "Famille 05 • Guides libres",
    color: "bg-teal-dark",
    href: "/fr/use-cases",
    linkText: "Trousses sectorielles",
    secondaryHref: "https://resources.zipsolutions.org",
    secondaryLinkText: "Base de connaissances ↗",
    secondaryExternal: true,
  },
  {
    title: "Confidentialité et dignité dès la conception",
    details: "Zéro traçage, aucun enregistrement audio, outils de base 100 % gratuits à vie et gouvernance partagée avec des mentors sourds et malentendants, cliniciens et enseignants.",
    icon: "shield",
    badge: "Architecture",
    color: "bg-midnight",
    href: "/fr/privacy",
    linkText: "Architecture privée",
    secondaryHref: "/fr/advisory",
    secondaryLinkText: "Comité consultatif",
  }
];

---

<BaseLayout 
  title="Solutions Zip | Sous-titrage en direct, outils CAA et événements"
  description="Sous-titrage en direct gratuit, outils de CAA hors ligne, production d'événements hybrides et technologies éducatives inclusives. Basé à Montréal."
  schema={homeSchema}
>
  
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-12 sm:pt-20 pb-16 sm:pb-24 bg-gradient-to-b from-white via-slate-50 to-alabaster border-b border-slate-200/80">
    
    <!-- Isometric micro-dot grid (drifts slowly behind content) + soft top wash -->
    <div class="absolute inset-0 pointer-events-none bg-[radial-gradient(ellipse_60%_45%_at_50%_0%,rgba(139,92,246,0.06),transparent_80%)]" aria-hidden="true"></div>
    <div class="iso-dots iso-mask-hero parallax-hero-bg absolute inset-x-0 -top-12 -bottom-4 pointer-events-none" aria-hidden="true"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      
      <!-- Hero Eyebrow -->
      <p class="text-xs sm:text-sm font-bold font-mono uppercase tracking-wider text-amethyst mb-4">
        Technologies d'assistance libres &bull; Sous-titrage gratuit, CAA et événements
      </p>

      <!-- Hero Heading -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-midnight font-heading max-w-4xl mx-auto leading-[1.1]">
        La maison de <span class="hero-word-sweep">l'accessibilité</span>
      </h1>

      <!-- Subtitle -->
      <p class="mt-6 text-lg sm:text-xl md:text-2xl text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Faciliter la communication avec le sous-titrage en direct en temps réel, les outils de CAA et les technologies éducatives inclusives.
      </p>

      <!-- CTA Buttons -->
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4 max-w-md mx-auto">
        <a 
          href="/fr/products" 
          class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 rounded-2xl font-heading font-bold text-base text-white bg-midnight hover:bg-slate-800 shadow-md hover:shadow-xl transition-all duration-200 focus-visible:ring-2 focus-visible:ring-midnight"
        >
          Découvrir tous les outils
        </a>
        <a 
          href="https://zipcaptions.app" 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-2xl font-heading font-bold text-base text-amethyst hover:text-white bg-purple-50 hover:bg-amethyst border border-amethyst/30 hover:border-amethyst transition-all duration-200 focus-visible:ring-2 focus-visible:ring-amethyst"
        >
          <span>Lancer Zip Captions</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>

      <!-- Quick Trust Indicators -->
      <div class="mt-12 flex flex-wrap items-center justify-center gap-6 sm:gap-10 text-xs font-semibold uppercase tracking-wider text-slate-500">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-teal-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
          Sous-titrage en direct 100% gratuit
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-teal-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
          Zéro traçage des utilisateurs
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-teal-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
          Prêt pour la classe et la diffusion
        </div>
      </div>

    </div>
  </section>

  <!-- Institutional Accolades & Partners Section (Two-Tier, Zero Pills) -->
  <section class="relative overflow-hidden bg-slate-50/80 border-b border-slate-200 py-16 sm:py-20 px-4 sm:px-6 lg:px-8">
    <div class="iso-dots iso-mask-stage parallax-slow absolute inset-x-0 -inset-y-14 pointer-events-none opacity-60" aria-hidden="true"></div>
    <div class="relative z-10 max-w-6xl mx-auto space-y-12">
      
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="text-xs font-bold font-mono text-amethyst uppercase tracking-wider block">
          Distinctions et partenaires institutionnels
        </span>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-midnight tracking-tight font-heading">
          Reconnu dans l'enseignement supérieur, les commissions scolaires et les programmes d'innovation
        </h2>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
          Des distinctions universitaires aux conseils scolaires provinciaux et aux communautés de diffusion en direct, découvrez comment Zip Captions favorise l'égalité des chances.
        </p>
      </div>

      <!-- Tier 1: Two Featured Award Cards (Zero Pills) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
        
        <!-- Card 1: University of Portsmouth -->
        <div class="bg-white border border-slate-200 hover:border-amethyst/50 rounded-2xl p-6 sm:p-8 transition-all shadow-sm hover:shadow-md flex flex-col justify-between group">
          <div class="space-y-4">
            <div class="flex items-center gap-4">
              <div class="w-16 h-16 rounded-2xl bg-white p-2.5 border border-slate-200 flex items-center justify-center shadow-xs shrink-0">
                <img src="/images/logos/portsmouth.svg" alt="Logo officiel de l'Université de Portsmouth" class="h-11 w-auto object-contain" loading="lazy" />
              </div>
              <div>
                <span class="text-xs font-bold font-mono text-amethyst uppercase tracking-wider block">
                  Lauréat de l'Alumni Impact Award (Mai 2025)
                </span>
                <h3 class="text-lg font-bold text-midnight font-heading leading-tight">
                  Université de Portsmouth
                </h3>
                <p class="text-xs text-slate-600 font-medium mt-0.5">
                  Student Impact Awards
                </p>
              </div>
            </div>

            <div class="pt-2">
              <h4 class="text-base font-bold text-midnight font-heading">
                Révolutionner l'accessibilité dans l'éducation
              </h4>
              <p class="text-slate-600 text-xs sm:text-sm mt-1 leading-relaxed">
                Hommage rendu pour innovation et service exceptionnels. Attribué au cofondateur Chris Webb pour la création de Zip Captions: un outil libre offrant un sous-titrage en direct en temps réel à plus de 1 500 utilisateurs dans le monde.
              </p>
            </div>

            <blockquote class="p-3.5 text-xs text-slate-700 italic bg-purple-50/60 border border-purple-200/70 rounded-xl">
              "Le travail innovant de Chris incarne les valeurs de l'Université, rendant l'éducation accessible à tous."
            </blockquote>
          </div>

          <div class="pt-5 mt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3">
            <a href="/fr/press#portsmouth" class="py-1.5 text-xs text-slate-600 hover:text-midnight font-medium transition-colors">
              Impact universitaire &bull; Presse
            </a>
            <a 
              href="https://www.port.ac.uk/news-events-and-blogs/news/students-contribution-to-the-community-celebrated-at-the-2025-student-impact-awards" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="py-1.5 text-xs font-bold text-teal-brand hover:text-teal-700 inline-flex items-center gap-1 group-hover:translate-x-0.5 transition-transform"
            >
              <span>Lire la citation officielle</span>
              <svg class="w-3.5 h-3.5 ml-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Card 2: VSTE Accessibility Demo Slam -->
        <div class="bg-white border border-slate-200 hover:border-teal-300 rounded-2xl p-6 sm:p-8 transition-all shadow-sm hover:shadow-md flex flex-col justify-between group">
          <div class="space-y-4">
            <div class="flex items-center gap-4">
              <div class="w-16 h-16 rounded-2xl bg-white p-2.5 border border-slate-200 flex items-center justify-center shadow-xs shrink-0">
                <img src="/images/logos/vste.png" alt="Logo de la Virginia Society for Technology in Education" class="h-8 w-auto object-contain" loading="lazy" />
              </div>
              <div>
                <span class="text-xs font-bold font-mono text-teal-brand uppercase tracking-wider block">
                  Lauréat de l'Accessibility Demo Slam
                </span>
                <h3 class="text-lg font-bold text-midnight font-heading leading-tight">
                  Virginia Society for Tech in Ed
                </h3>
                <p class="text-xs text-slate-600 font-medium mt-0.5">
                  Conception universelle de l'apprentissage (CUA)
                </p>
              </div>
            </div>

            <div class="pt-2">
              <h4 class="text-base font-bold text-midnight font-heading">
                Conception universelle de l'apprentissage en classe
              </h4>
              <p class="text-slate-600 text-xs sm:text-sm mt-1 leading-relaxed">
                Présenté par Katie Fielding (Book Creator, Coach VSTE de l'année) montrant comment Zip Captions soutient les lecteurs émergents, les élèves allophones (FLE/ALS) et les apprenants malentendants avec les polices Lexend et le contraste sombre.
              </p>
            </div>

            <blockquote class="p-3.5 text-xs text-slate-700 italic bg-teal-50/60 border border-teal-200/70 rounded-xl">
              "Un moyen particulièrement puissant de sous-titrer votre cours en direct pour soutenir tous les élèves de la classe."
            </blockquote>
          </div>

          <div class="pt-5 mt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3">
            <a href="/fr/testimonial#katie-fielding" class="py-1.5 text-xs text-slate-600 hover:text-midnight font-medium transition-colors">
              Katie Fielding &bull; Témoignage
            </a>
            <a 
              href="https://www.youtube.com/watch?v=u2wNoSQz0Zk" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="py-1.5 text-xs font-bold text-teal-brand hover:text-teal-700 inline-flex items-center gap-1 group-hover:translate-x-0.5 transition-transform"
            >
              <span>Voir la démonstration primée</span>
              <svg class="w-3.5 h-3.5 ml-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>

      </div>

      <!-- Tier 2: Institutional & Program Partners Logo Bar (Zero Pills) -->
      <div class="pt-8 border-t border-slate-200 space-y-6">
        <div class="text-center">
          <span class="text-xs font-bold font-mono text-slate-600 uppercase tracking-wider">
            Accélérateurs d'innovation, conseils scolaires partenaires et publications
          </span>
        </div>

        <!-- 6-Logo Clean Grid with Official Sourced Logos -->
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 items-stretch">
          
          <!-- Logo 1: Dell Technologies -->
          <div class="p-4 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-xs transition-all flex flex-col items-center justify-between text-center group">
            <div class="h-12 w-full flex items-center justify-center">
              <img src="/images/logos/dell.svg" alt="Logo officiel de Dell Technologies" class="h-6 max-w-[80%] object-contain opacity-75 group-hover:opacity-100 transition-opacity" loading="lazy" />
            </div>
            <span class="text-xs text-slate-500 font-medium mt-2">Accélérateur d'innovation</span>
          </div>

          <!-- Logo 2: Microsoft for Startups -->
          <div class="p-4 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-xs transition-all flex flex-col items-center justify-between text-center group">
            <div class="h-12 w-full flex items-center justify-center">
              <img src="/images/logos/microsoft.svg" alt="Logo officiel de Microsoft" class="h-6 max-w-[80%] object-contain opacity-75 group-hover:opacity-100 transition-opacity" loading="lazy" />
            </div>
            <span class="text-xs text-slate-500 font-medium mt-2">Programme Founders</span>
          </div>

          <!-- Logo 3: EMSB Inspirations -->
          <div class="p-4 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-xs transition-all flex flex-col items-center justify-between text-center group">
            <div class="h-12 w-full flex items-center justify-center">
              <img src="/images/logos/emsb.svg" alt="Logo de la Commission scolaire English-Montréal" class="h-8 max-w-[90%] object-contain opacity-80 group-hover:opacity-100 transition-opacity" loading="lazy" />
            </div>
            <span class="text-xs text-slate-500 font-medium mt-2">Journal Inspirations</span>
          </div>

          <!-- Logo 4: Lester B. Pearson -->
          <div class="p-4 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-xs transition-all flex flex-col items-center justify-between text-center group">
            <div class="h-12 w-full flex items-center justify-center">
              <img src="/images/logos/pearson.svg" alt="Logo de la Commission scolaire Lester-B.-Pearson" class="h-9 max-w-[80%] object-contain opacity-75 group-hover:opacity-100 transition-opacity" loading="lazy" />
            </div>
            <span class="text-xs text-slate-500 font-medium mt-2">The Pearson News</span>
          </div>

          <!-- Logo 5: Hear Entendre Quebec -->
          <div class="p-4 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-xs transition-all flex flex-col items-center justify-between text-center group">
            <div class="h-12 w-full flex items-center justify-center">
              <img src="/images/logos/hear_quebec.png" alt="Logo de Hear Entendre Québec" class="h-8 max-w-[90%] object-contain opacity-75 group-hover:opacity-100 transition-opacity" loading="lazy" />
            </div>
            <span class="text-xs text-slate-500 font-medium mt-2">Revue Hear Hear!</span>
          </div>

          <!-- Logo 6: Audition Quebec -->
          <div class="p-4 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-xs transition-all flex flex-col items-center justify-between text-center group">
            <div class="h-12 w-full flex items-center justify-center">
              <img src="/images/logos/audition_quebec.png" alt="Logo d'Audition Québec" class="h-9 max-w-[80%] object-contain opacity-75 group-hover:opacity-100 transition-opacity" loading="lazy" />
            </div>
            <span class="text-xs text-slate-500 font-medium mt-2">Revue Technologique</span>
          </div>

        </div>
      </div>

    </div>
  </section>

  <!-- 5-Family Product & Service Hub + Privacy Architecture Section -->
  <section class="relative overflow-hidden py-20 sm:py-28">
    <div class="parallax-slow absolute inset-x-0 -inset-y-16 pointer-events-none bg-[radial-gradient(ellipse_55%_45%_at_20%_30%,rgba(139,92,246,0.05),transparent_70%),radial-gradient(ellipse_55%_45%_at_80%_70%,rgba(13,148,136,0.05),transparent_70%)]" aria-hidden="true"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold font-mono text-amethyst uppercase tracking-wider block mb-2">
        Cinq familles d'accessibilité &bull; Confidentialité dès la conception
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold font-heading text-midnight">
        Outils logiciels, événements en direct et guides libres
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-600">
        Explorez nos cinq grandes familles de technologies d'assistance et de services, chacune conçue pour respecter la vie privée, la dignité et l'accès universel sans barrière financière.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {features.map((feature) => (
        <div class="group bg-white rounded-3xl p-8 border border-slate-200/80 shadow-sm hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class={`w-12 h-12 rounded-2xl ${feature.color} text-white flex items-center justify-center shadow-md`}>
                {feature.icon === 'captions' && (
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h6m-6 4h8M5 4h14a2 2 0 012 2v12a2 2 0 01-2 2H5a2 2 0 01-2-2V6a2 2 0 012-2z" />
                  </svg>
                )}
                {feature.icon === 'chat' && (
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                  </svg>
                )}
                {feature.icon === 'book' && (
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
