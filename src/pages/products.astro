---
import BaseLayout from '../layouts/BaseLayout.astro';
import ZipDashboard from '../components/ZipDashboard.astro';
import FaqSection from '../components/FaqSection.astro';

const productsFaqs = [
  {
    question: "How do I know whether we can just use your free self-serve web apps ($0) or if we should book your live event team?",
    answer: "If you are captioning a classroom lesson, weekly church service, clinic desk, or standard OBS/vMix stream with a single clear microphone, our self-serve Zip Captions web app ($0 Free Forever, or $5–$30/mo for AI) and free printable checklists are all you need. Book our Custom Live Event or Hybrid Production team when you have high-stakes auditorium keynotes, multi-track breakout rooms, remote hybrid panelists, or scripted live theatre surtitles where you want dedicated technical engineering."
  },
  {
    question: "Commercial AV integrators quoted us $15,000+ for an assistive listening system. How does your 'install-your-own' AV consultancy model work?",
    answer: "Many churches, community theatres, and schools get priced out by heavy markups on proprietary hardware racks. Through our Assistive Listening & AV Consultancy, we audit your room acoustics and existing soundboard, then give you an exact off-the-shelf hardware shopping list (such as Phonak Roger or low-latency Wi-Fi assistive listening) and wiring blueprint so your local team or electrician can install it at a fraction of traditional integrator quotes."
  },
  {
    question: "Can our school district push your Chrome extensions (EquiBrowse, ZipPanel, Zip Speech) to student Chromebooks via Google Admin Console?",
    answer: "Yes. All of our browser extensions are published on the official Chrome Web Store and Google Workspace Marketplace using Manifest V3, so district IT administrators can allowlist or force-install them by extension ID across organizational units (OUs) in minutes—with zero student data collection."
  },
  {
    question: "Where do you provide on-site consultancy and event production versus remote support?",
    answer: "We are based in Greater Montreal, Quebec, Canada. We provide on-site event production, live captioning/surtitling, digital sound & architectural lighting (ETC Mosaic) integration, and in-person educator PD across Montreal, Quebec, and Canada—and deliver remote consultancy, virtual event production, and browser apps worldwide."
  }
];

const productsPageSchema = {
  "@type": "CollectionPage",
  "@id": "https://zipsolutions.org/products#collection",
  "name": "All Accessibility Tools, Captioning Software & Event Services | Zip Solutions",
  "url": "https://zipsolutions.org/products",
  "description": "Complete catalog of 18 free browser-based accessibility web apps, AAC communication tools, broadcast integrations, in-person & hybrid event production, custom live event captioning, educator PD, and AV consultancy services by Zip Solutions.",
  "about": {
    "@id": "https://zipsolutions.org/#organization"
  },
  "mainEntity": {
    "@type": "ItemList",
    "name": "Zip Solutions Products & Services",
    "numberOfItems": 18,
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Zip Captions — Free Browser Live Captioning ($0 Free / Optional AI $5-$30 USD/mo)", "url": "https://zipsolutions.org/zipcaptions" },
      { "@type": "ListItem", "position": 2, "name": "Zip Captions for vMix — Live Broadcast Integration ($0 Free)", "url": "https://zipsolutions.org/zipvmix" },
      { "@type": "ListItem", "position": 3, "name": "Zip Captions Companion — Stream Deck & Bitfocus Bridge ($0 Free)", "url": "https://zipsolutions.org/zipcaptionscompanion" },
      { "@type": "ListItem", "position": 4, "name": "ZipPanel — Floating Chrome Caption Overlay ($0 Free)", "url": "https://zipsolutions.org/zippanel" },
      { "@type": "ListItem", "position": 5, "name": "Zip Connect — Twitch & Multi-Device Caption Bridge ($0 Free)", "url": "https://zipsolutions.org/zipconnect" },
      { "@type": "ListItem", "position": 6, "name": "Custom Zip Captions Live Event Solutions & Theatre Surtitles (Custom Quote — Montreal, QC, Canada & Worldwide)", "url": "https://zipsolutions.org/live-event-quotes" },
      { "@type": "ListItem", "position": 7, "name": "Zip EasySpeak — Browser & Mobile AAC App ($0 Free & Open Source)", "url": "https://zipsolutions.org/easyspeak" },
      { "@type": "ListItem", "position": 8, "name": "Zip EasySpeak AI — Offline On-Device AI AAC App ($0 Free)", "url": "https://zipsolutions.org/easyspeak" },
      { "@type": "ListItem", "position": 9, "name": "Zip EasySpeak for Education — Educator AAC Dashboard ($0 Free)", "url": "https://zipsolutions.org/easyspeak" },
      { "@type": "ListItem", "position": 10, "name": "Zip Speech — AAC Microphone Injection for Google Meet ($0 Free)", "url": "https://zipsolutions.org/zipspeech" },
      { "@type": "ListItem", "position": 11, "name": "EquiBrowse — Text-to-Speech, Highlighting & Picture Dictionary Chrome Extension ($0 Free)", "url": "https://zipsolutions.org/equibrowse" },
      { "@type": "ListItem", "position": 12, "name": "EquiAssess — Accessible Summative Assessment Platform (Free for Educators)", "url": "https://equiassess.zipsolutions.org" },
      { "@type": "ListItem", "position": 13, "name": "Zip Solutions Remediator — AI Formative Math Assessment for Google Workspace ($0 Free BYOK)", "url": "https://zipsolutions.org/zipmath" },
      { "@type": "ListItem", "position": 14, "name": "In-Person & Hybrid Event Organisation & Google for Education Educator PD (Custom Quote — Montreal, QC, Canada & Worldwide)", "url": "https://zipsolutions.org/events" },
      { "@type": "ListItem", "position": 15, "name": "Assistive Listening System Consultancy (Custom Quote — Montreal, QC, Canada & Remote)", "url": "https://zipsolutions.org/contact-us" },
      { "@type": "ListItem", "position": 16, "name": "Digital Sound & Architectural Lighting Systems Consultancy (Custom Quote — Montreal, QC & Canada)", "url": "https://zipsolutions.org/contact-us" },
      { "@type": "ListItem", "position": 17, "name": "Captioning & Theatre Surtitle Consultancy (Custom Quote — Montreal, QC, Canada & Worldwide)", "url": "https://zipsolutions.org/contact-us" },
      { "@type": "ListItem", "position": 18, "name": "Free Resources for Listening Accessibility ($0 Open Knowledge Base)", "url": "https://resources.zipsolutions.org" }
    ]
  }
};
---

<BaseLayout 
  title="Accessibility Tools, AAC Apps & Live Event Captioning Services | Zip Solutions"
  description="Discover Zip Solutions' suite of free accessibility tools, browser live captioning, offline AAC apps, Google Workspace classroom tools, and hybrid event production services."
  schema={productsPageSchema}
  faqs={productsFaqs}
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-white to-slate-50 border-b border-slate-200/80 pt-12 pb-14 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-sm font-bold text-amethyst tracking-wide uppercase mb-3 font-heading">
        Ecosystem &amp; Services
      </p>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-midnight font-heading">
        Products, Services &amp; Event Solutions
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        From groundbreaking accessible software to full in-person event organisation, hybrid convention streaming, and custom live captioning deployments, we deliver complete accessibility solutions.
      </p>
    </div>
  </section>

  <!-- PROMINENT FEATURED SERVICES: Event Organisation & Custom Live Captions -->
  <section class="py-12 bg-white border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-10">
        <p class="text-xs sm:text-sm font-bold text-teal-brand tracking-wide uppercase mb-2 font-heading">
          Institutional &amp; Enterprise Services
        </p>
        <h2 class="text-2xl sm:text-4xl font-extrabold font-heading text-midnight">
          Featured Event &amp; Professional Services
        </h2>
        <p class="mt-3 text-slate-600 text-sm sm:text-base">
          Specialized technical direction, in-person event management, and bespoke captioning infrastructure backed by dedicated engineering support.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        
        <!-- Service 1: In-Person Event Organisation & Professional Development -->
        <div class="bg-gradient-to-br from-slate-50 to-white rounded-3xl p-8 sm:p-10 border border-slate-200 shadow-sm hover:shadow-lg transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-4 mb-5">
              <span class="p-3.5 rounded-2xl bg-amethyst text-white shadow-md shrink-0">
                <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
              </span>
              <h3 class="text-xl sm:text-2xl font-bold font-heading text-midnight leading-snug">
                In-Person &amp; Hybrid Event Organisation
              </h3>
            </div>

            <p class="text-slate-600 text-sm sm:text-base leading-relaxed mb-4">
              We provide full-spectrum event organisation for educational institutions, conventions, and non-profit organisations. From technical infrastructure to live streaming and attendee engagement, we handle every detail so your team can focus on programming.
            </p>

            <div class="space-y-3 mb-6">
              <div class="p-4 rounded-2xl bg-white border border-slate-200 text-xs sm:text-sm text-slate-700">
                <strong class="text-midnight block mb-1">Large-Scale Hybrid & Virtual Conferences:</strong>
                Running complex hybrid and virtual sessions with multi-room live streaming, remote presenter integration, and synchronized real-time accessibility feeds.
              </div>

              <div class="p-4 rounded-2xl bg-white border border-slate-200 text-xs sm:text-sm text-slate-700">
                <strong class="text-midnight block mb-1">Google for Education Training &amp; Custom PD:</strong>
                Tailored professional development workshops for educators, administrative teams, and businesses covering Google Workspace, Gemini AI, and accessible classroom tools—led directly by Google Certified Trainers and Innovators.
              </div>
            </div>
          </div>

          <div class="pt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-4">
            <a 
              href="/events" 
              class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-coral hover:bg-rose-600 text-white font-heading font-bold text-sm rounded-xl shadow-sm transition-all"
            >
              <span>Learn More &amp; Plan</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
            <span class="text-xs font-semibold text-slate-500">Hybrid • Virtual • In-Person</span>
          </div>
        </div>

        <!-- Service 2: Custom Zip Captions Solutions for Live Events -->
        <div class="bg-gradient-to-br from-slate-50 to-white rounded-3xl p-8 sm:p-10 border border-slate-200 shadow-sm hover:shadow-lg transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-4 mb-5">
              <span class="p-3.5 rounded-2xl bg-teal-brand text-white shadow-md shrink-0">
                <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
              </span>
              <h3 class="text-xl sm:text-2xl font-bold font-heading text-midnight leading-snug">
                Custom Zip Captions for Live Events
              </h3>
            </div>

            <p class="text-slate-600 text-sm sm:text-base leading-relaxed mb-4">
              Need reliable, flexible live captioning for an auditorium keynote, theater production, community gathering, or conference? We help you set up and operate Zip Captions tailored to your venue setup.
            </p>

            <div class="space-y-3 mb-6">
              <div class="p-4 rounded-2xl bg-white border border-slate-200 text-xs sm:text-sm text-slate-700">
                <strong class="text-midnight block mb-1">Tailored Stage &amp; Broadcast Surtitles:</strong>
                Custom display styling for venue screens, auditorium confidence monitors, broadcast lower-thirds, or personalized attendee smartphone web relays.
              </div>

              <div class="p-4 rounded-2xl bg-white border border-slate-200 text-xs sm:text-sm text-slate-700">
                <strong class="text-midnight block mb-1">Customised Quotations:</strong>
                We provide tailored quotes based on event duration, audience size, and display requirements.
              </div>
            </div>
          </div>

          <div class="pt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-4">
            <a 
              href="/live-event-quotes" 
              class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-teal-brand hover:bg-teal-dark text-white font-heading font-bold text-sm rounded-xl shadow-sm transition-all"
            >
              <span>Explore Captions &amp; Quotes</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
            <span class="text-xs font-semibold text-slate-500">Auditoriums • Theatre • Streams</span>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- Complete Interactive Directory -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="mb-8">
      <h2 class="text-2xl sm:text-3xl font-bold font-heading text-midnight">
        Browse All Products &amp; Solutions
      </h2>
      <p class="text-slate-600 text-sm sm:text-base mt-1">
        Search and filter through our full catalog of web applications, AI tools, extensions, and consulting programs.
      </p>
    </div>
    <ZipDashboard />
  </section>

  <FaqSection
    faqs={productsFaqs}
    title="Choosing Between Self-Serve Tools, School Rollouts & Managed Services"
    subtitle="Real-World Implementation Questions"
    groupName="faq-products"
  />
</BaseLayout>
