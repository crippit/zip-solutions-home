---
import ProductLayout from '../layouts/ProductLayout.astro';

const zipCaptionsSchema = [
  {
    "@type": "SoftwareApplication",
    "name": "Zip Captions",
    "description": "Free, browser-based real-time speech-to-text live captioning for classrooms, places of worship, conferences, OBS Studio, vMix, and live streaming.",
    "applicationCategory": "EducationalApplication, UtilitiesApplication, MultimediaApplication",
    "operatingSystem": "All (Web, Windows, macOS, Linux, ChromeOS, iOS, Android)",
    "url": "https://zipsolutions.org/zipcaptions",
    "award": [
      "University of Portsmouth 2025 Alumni Impact Award Winner",
      "Virginia Society for Technology in Education (VSTE) Accessibility Demo Slam Winner"
    ],
    "funder": [
      {
        "@type": "Organization",
        "name": "Dell Technologies Education Canada Innovation Accelerator"
      },
      {
        "@type": "Organization",
        "name": "Microsoft for Startups Founders Hub"
      }
    ],
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "5",
      "reviewCount": 3,
      "bestRating": "5",
      "worstRating": "1"
    },
    "review": [
      {
        "@type": "Review",
        "author": {
          "@type": "Person",
          "name": "Dr. Brian Friedlander"
        },
        "reviewRating": {
          "@type": "Rating",
          "ratingValue": "5",
          "bestRating": "5",
          "worstRating": "1"
        },
        "reviewBody": "ZipCaptions is a free captioning tool that could be really helpful for students with language-based learning disabilities, auditory processing disabilities, or students who are hard of hearing."
      },
      {
        "@type": "Review",
        "author": {
          "@type": "Person",
          "name": "Tracey Green"
        },
        "reviewRating": {
          "@type": "Rating",
          "ratingValue": "5",
          "bestRating": "5",
          "worstRating": "1"
        },
        "reviewBody": "For those with hearing loss, it empowers them. This fosters autonomy and independence, so you do not have to ask for help all the time."
      },
      {
        "@type": "Review",
        "author": {
          "@type": "Person",
          "name": "Kevin Bouwman"
        },
        "reviewRating": {
          "@type": "Rating",
          "ratingValue": "5",
          "bestRating": "5",
          "worstRating": "1"
        },
        "reviewBody": "Zip Captions makes it very easy to add live open captions to our service broadcasts for our livestream and our leased cable tv channel."
      }
    ],
    "offers": {
      "@type": "Offer",
      "price": "0.00",
      "priceCurrency": "USD",
      "availability": "https://schema.org/InStock"
    }
  },
  {
    "@type": "VideoObject",
    "name": "Broadcast Live Captions Anywhere with Zip Captions",
    "description": "How to broadcast real-time captions to personal smartphones, tablets, and laptops using static share codes in Zip Captions.",
    "thumbnailUrl": "https://i.ytimg.com/vi/OXpaiEtECmI/hqdefault.jpg",
    "uploadDate": "2024-06-01",
    "embedUrl": "https://www.youtube.com/embed/OXpaiEtECmI"
  },
  {
    "@type": "VideoObject",
    "name": "Transcribe and Export SRT/VTT Transcripts with Zip Captions",
    "description": "How to transcribe speech in your browser and export instant SRT, VTT, or plain text transcripts with Zip Captions.",
    "thumbnailUrl": "https://i.ytimg.com/vi/sF7n1X1oIFY/hqdefault.jpg",
    "uploadDate": "2024-06-01",
    "embedUrl": "https://www.youtube.com/embed/sF7n1X1oIFY"
  },
  {
    "@type": "VideoObject",
    "name": "Live Streaming with OBS Studio and Zip Captions",
    "description": "How to connect Zip Captions directly into OBS Studio via WebSockets for real-time open captions on Twitch and YouTube Live.",
    "thumbnailUrl": "https://i.ytimg.com/vi/QYz4Brh66YA/hqdefault.jpg",
    "uploadDate": "2024-06-01",
    "embedUrl": "https://www.youtube.com/embed/QYz4Brh66YA"
  }
];

const capabilities = [
  {
    title: "100% Free and Browser-Based",
    description: "No subscription, software installation, or sign-up required. Works directly in any modern browser on desktop, tablet, and mobile."
  },
  {
    title: "Real-Time Broadcaster",
    description: "Share live captions with remote viewers anywhere in the world using static share codes on their personal devices."
  },
  {
    title: "Private Local Browser Storage",
    description: "Your transcripts stay in your browser and are never saved on external servers. Full privacy for schools, healthcare, and boardrooms."
  },
  {
    title: "OBS and Stream Integration",
    description: "Connect via WebSockets directly into OBS Studio and vMix to overlay captions onto your live streams in real time."
  },
  {
    title: "Instant Exporting",
    description: "Save transcripts instantly formatted as industry-standard SRT, VTT, or plain text files ready for AI summaries and video post-production."
  },
  {
    title: "Picture-in-Picture Floating Mode",
    description: "Pop live captions out into a resizable, always-on-top floating window that stays visible over slides, documents, coding environments, and desktop apps."
  },
  {
    title: "Free Real-Time Translation & Dialects",
    description: "Translate live captions instantaneously in Google Chrome using local On-Device AI at zero cost, alongside support for dozens of languages and optional Azure AI transcription."
  }
];

const specs = [
  { label: "Where it runs", value: "Works directly in your web browser on laptops, phones, and tablets with zero software to install." },
  { label: "Browser compatibility", value: "Fully tested and supported on Chrome, Safari, Edge, Brave, and Opera." },
  { label: "Live stream setups", value: "Connects via WebSockets straight into OBS Studio, vMix, and digital video switchers." },
  { label: "Saving transcripts", value: "Download complete transcripts whenever you finish as industry-standard SRT, VTT, or plain text files." }
];

const faqs = [
  {
    question: "Is Zip Captions really 100% free?",
    answer: "Yes. Standard browser-based live captioning in Zip Captions is 100% free forever with unlimited usage, no account registration required, and no credit card needed. Optional monthly Patreon tiers starting at $5/month are available if you want access to enhanced cloud AI transcription engines."
  },
  {
    question: "How do I add live captions to OBS Studio or vMix?",
    answer: "Zip Captions integrates directly with OBS Studio via WebSockets to send real-time closed or open captions to Twitch and YouTube Live. For vMix productions, our free Zip vMix Connector bridges real-time caption text directly into any vMix title graphic or lower-third overlay."
  },
  {
    question: "Can students or event attendees view live captions on their own phones?",
    answer: "Yes. Using Zip Captions Broadcast mode, you can share a static room code or QR link so students, congregation members, or conference attendees can follow live captions on their own smartphones, tablets, or laptops—and customize their own font size, Lexend dyslexia-friendly typeface, and high-contrast colors."
  },
  {
    question: "Are my classroom or meeting transcripts kept private?",
    answer: "Yes. Zip Captions processes speech transiently and holds your running transcript locally inside your web browser memory. We do not store or archive your transcripts on external servers, making it safe for schools, universities, healthcare settings, and boardrooms."
  },
  {
    question: "What file formats can I export my transcripts to?",
    answer: "At the end of any session, you can download your transcript with a single click as time-coded SRT subtitles, WebVTT (.vtt) captions for video post-production, or clean plain text (.txt) ready for study notes and AI summaries."
  }
];
---

<ProductLayout
  title="Zip Captions"
  seoTitle="Zip Captions — Free Browser-Based Live Captioning & Speech-to-Text"
  subtitle="Flagship Live Captioning"
  description="Free, private, browser-based live captioning and real-time speech-to-text transcription for classrooms, churches, conferences, OBS Studio, and vMix."
  actions={[
    { text: "Launch Zip Captions", url: "https://zipcaptions.app", primary: true, external: true },
    { text: "View AI Pricing", url: "/pricing" },
    { text: "Help & Community", url: "https://help.zipcaptions.app", external: true }
  ]}
  heroImage="/images/zippreview.png"
  heroImageAlt="Zip Captions in action on laptop and mobile"
  capabilities={capabilities}
  specs={specs}
  faqs={faqs}
  ctaTitle="Experience effortless live captioning"
  ctaDescription="Start captioning your classroom, meeting, church service, or livestream in seconds with no setup required."
  ctaAction={{ text: "Launch Zip Captions Free", url: "https://zipcaptions.app", external: true }}
  schema={zipCaptionsSchema}
>
  
  <!-- Mission & Architecture Overview (Zero Pills) -->
  <div class="bg-gradient-to-br from-slate-900 via-midnight to-slate-950 rounded-3xl p-8 sm:p-12 text-white border border-slate-800 shadow-xl mt-8">
    <div class="max-w-3xl space-y-4">
      <span class="text-xs font-bold uppercase tracking-wider text-teal-brand font-heading block">
        Our Flagship Architecture
      </span>
      <h2 class="text-2xl sm:text-3xl font-extrabold font-heading tracking-tight">
        Free, Private, and Dignified Captions for Everyone
      </h2>
      <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
        Zip Captions was created directly out of classroom necessity. Traditional speech-to-text systems are often burdened by rigid licensing fees, complex proprietary hardware, and invasive audio telemetry. We believe that live communication access is a universal right, not a luxury add-on.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-4 border-t border-slate-800">
        <div>
          <h3 class="text-sm font-bold font-heading text-white mb-1">Zero Cost Barrier</h3>
          <p class="text-xs text-slate-400 leading-relaxed">100% free forever for core live captioning with zero subscriptions or credit card requirements.</p>
        </div>
        <div>
          <h3 class="text-sm font-bold font-heading text-white mb-1">Runs Everywhere</h3>
          <p class="text-xs text-slate-400 leading-relaxed">Zero installation needed. Launches instantly inside any modern browser on laptops, Chromebooks, and phones.</p>
        </div>
        <div>
          <h3 class="text-sm font-bold font-heading text-white mb-1">Total Privacy</h3>
          <p class="text-xs text-slate-400 leading-relaxed">Audio is processed transiently and transcripts are held locally in your browser memory.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Award-Winning Recognition & Social Proof Grid (Zero Pills) -->
  <div class="mt-12 bg-white rounded-3xl border border-slate-200 shadow-sm p-6 sm:p-10 space-y-8">
    <div class="border-b border-slate-100 pb-4">
      <span class="text-xs font-bold font-mono text-amethyst uppercase tracking-wider block mb-1">
        Recognized for Educational Impact
      </span>
      <h2 class="text-2xl sm:text-3xl font-bold font-heading text-midnight">
        Award-Winning Accessibility, Backed by Educators
      </h2>
      <p class="text-xs sm:text-sm text-slate-600 mt-1">
        Celebrated by universities, school boards, and assistive technology consultants worldwide.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Award 1: Portsmouth -->
      <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-3 flex flex-col justify-between">
        <div>
          <span class="text-xs font-bold font-mono text-amethyst uppercase tracking-wider block">
            Higher Ed Innovation
          </span>
          <h3 class="text-base font-bold font-heading text-midnight mt-1">
            2025 Alumni Impact Award
          </h3>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            University of Portsmouth Student Impact Awards honored Zip Captions for revolutionizing accessibility in education, aiding over 1,500 users worldwide.
          </p>
        </div>
        <a href="/press" class="text-xs font-bold text-teal-brand hover:text-teal-700 transition-colors inline-flex items-center gap-1 pt-2">
          <span>Read Award Citation &rarr;</span>
        </a>
      </div>

      <!-- Award 2: VSTE Demo Slam -->
      <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-3 flex flex-col justify-between">
        <div>
          <span class="text-xs font-bold font-mono text-teal-brand uppercase tracking-wider block">
            VSTE Winner
          </span>
          <h3 class="text-base font-bold font-heading text-midnight mt-1">
            Accessibility Demo Slam
          </h3>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            Winning presentation by Katie Fielding (Book Creator) showcasing Lexend font support and dark mode contrast for emerging readers and deaf students.
          </p>
        </div>
        <a href="/testimonial" class="text-xs font-bold text-teal-brand hover:text-teal-700 transition-colors inline-flex items-center gap-1 pt-2">
          <span>Watch Showcase &rarr;</span>
        </a>
      </div>

      <!-- Endorsement 3: Classroom Autonomy -->
      <div class="p-5 rounded-2xl bg-purple-50/40 border border-purple-100 space-y-3 flex flex-col justify-between">
        <div>
          <span class="text-xs font-bold font-mono text-amethyst uppercase tracking-wider block">
            Teacher of the Deaf
          </span>
          <h3 class="text-base font-bold font-heading text-midnight mt-1">
            Student Independence
          </h3>
          <p class="text-xs text-slate-700 mt-2 italic leading-relaxed">
            "For those with hearing loss, it empowers them. This fosters autonomy and independence, so you do not have to ask for help all the time."
          </p>
          <p class="text-xs text-slate-500 font-semibold mt-1">
            : Tracey Green, MOSD
          </p>
        </div>
        <a href="/press" class="text-xs font-bold text-amethyst hover:text-amethyst-dark transition-colors inline-flex items-center gap-1 pt-2">
          <span>Featured in Inspirations &rarr;</span>
        </a>
      </div>

    </div>
  </div>

  <!-- Video Showcases -->
  <div class="space-y-16 mt-12">
    
    <!-- Video 1: Broadcasting -->
    <div class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
      <div class="space-y-4">
        <h2 class="text-2xl font-bold font-heading text-midnight">
          Broadcast Your Captions Anywhere
        </h2>
        <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
          Broadcasting allows viewers in the same auditorium or across the globe to follow along with your spoken words in real time on their own smartphones, tablets, or laptops.
        </p>
        <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
          Viewers can independently customize font sizing, contrast, and layout to fit their unique accessibility needs without altering your main display screen.
        </p>
      </div>
      <div class="aspect-video rounded-2xl overflow-hidden border border-slate-200 shadow-md">
        <iframe 
          class="w-full h-full"
          src="https://www.youtube.com/embed/OXpaiEtECmI?si=f2T4ORGnv7TEPyf9" 
          title="Broadcast Captions with Zip Captions" 
          frameborder="0" 
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
          allowfullscreen
        ></iframe>
      </div>
    </div>

    <!-- Video 2: Transcribe what you say -->
    <div class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
      <div class="order-2 lg:order-1 aspect-video rounded-2xl overflow-hidden border border-slate-200 shadow-md">
        <iframe 
          class="w-full h-full"
          src="https://www.youtube.com/embed/sF7n1X1oIFY?si=v1gFJ-SZGtZjVd9c" 
          title="Transcribe What You Say" 
          frameborder="0" 
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
          allowfullscreen
        ></iframe>
      </div>
      <div class="order-1 lg:order-2 space-y-4">
        <h2 class="text-2xl font-bold font-heading text-midnight">
          Transcribe and Archive Your Words
        </h2>
        <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
          Whether you need meeting minutes, lecture transcripts, or study notes, Zip Captions creates continuous transcripts stored securely in local browser memory.
        </p>
        <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
          When your session finishes, download your transcription in standard subtitle formats (SRT, VTT) or plain text with one click, or export into AI tools like ChatGPT or NotebookLM for instant study summaries.
        </p>
      </div>
    </div>

    <!-- Video 3: OBS Live Streaming -->
    <div class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
      <div class="space-y-4">
        <h2 class="text-2xl font-bold font-heading text-midnight">
          Native Live Streaming with OBS Studio
        </h2>
        <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
          Integrate directly with OBS Studio using WebSockets. Captions appear automatically on your live stream output with zero latency.
        </p>
        <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
          Reach deaf and hard-of-hearing viewers on Twitch, YouTube Live, and social streams effortlessly, with full support for hardware switchers via Bitfocus Companion.
        </p>
      </div>
      <div class="aspect-video rounded-2xl overflow-hidden border border-slate-200 shadow-md">
        <iframe 
          class="w-full h-full"
          src="https://www.youtube.com/embed/QYz4Brh66YA?si=SuBN-KoPIw7t6YdA" 
          title="Live Streaming with OBS and Zip Captions" 
          frameborder="0" 
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
          allowfullscreen
        ></iframe>
      </div>
    </div>

    <!-- Comparison Table: Zip Captions vs Traditional Solutions -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="px-6 sm:px-8 py-6 border-b border-slate-100 bg-slate-50/60">
        <span class="text-xs font-bold uppercase tracking-wider text-amethyst font-heading block mb-1">
          Why Educators &amp; Producers Switch
        </span>
        <h2 class="text-xl sm:text-2xl font-extrabold font-heading text-midnight">
          How Zip Captions Compares to Traditional Live Captioning
        </h2>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse min-w-[640px]">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-200 text-xs uppercase tracking-wider text-slate-500">
              <th class="p-4 sm:px-6 font-bold">Capability</th>
              <th class="p-4 sm:px-6 font-bold text-amethyst bg-purple-50/50">Zip Captions</th>
              <th class="p-4 sm:px-6 font-bold">Paid Cloud Captioning SaaS</th>
              <th class="p-4 sm:px-6 font-bold">Hardware Caption Encoders</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-xs sm:text-sm">
            <tr>
              <td class="p-4 sm:px-6 font-semibold text-midnight">Core Live Captioning Cost</td>
              <td class="p-4 sm:px-6 font-bold text-teal-brand bg-purple-50/20">100% Free Forever ($0)</td>
              <td class="p-4 sm:px-6 text-slate-600">Per-minute or high monthly seat fees</td>
              <td class="p-4 sm:px-6 text-slate-600">Thousands in upfront hardware costs</td>
            </tr>
            <tr>
              <td class="p-4 sm:px-6 font-semibold text-midnight">Setup &amp; Installation</td>
              <td class="p-4 sm:px-6 font-semibold text-midnight bg-purple-50/20">Instant in any web browser (Zero install)</td>
              <td class="p-4 sm:px-6 text-slate-600">Account registration &amp; desktop agents</td>
              <td class="p-4 sm:px-6 text-slate-600">Dedicated SDI/HDMI rack integration</td>
            </tr>
            <tr>
              <td class="p-4 sm:px-6 font-semibold text-midnight">Personal Device Broadcasting</td>
              <td class="p-4 sm:px-6 font-semibold text-midnight bg-purple-50/20">Built-in room codes with user font/contrast controls</td>
              <td class="p-4 sm:px-6 text-slate-600">Often locked to enterprise tiers</td>
              <td class="p-4 sm:px-6 text-slate-600">In-room screen display only</td>
            </tr>
            <tr>
              <td class="p-4 sm:px-6 font-semibold text-midnight">OBS Studio, vMix &amp; Stream Deck</td>
              <td class="p-4 sm:px-6 font-semibold text-midnight bg-purple-50/20">Native WebSockets, vMix Connector &amp; Companion</td>
              <td class="p-4 sm:px-6 text-slate-600">Requires paid API keys or plugins</td>
              <td class="p-4 sm:px-6 text-slate-600">Hardware SDI closed captions only</td>
            </tr>
            <tr>
              <td class="p-4 sm:px-6 font-semibold text-midnight">Transcript Privacy</td>
              <td class="p-4 sm:px-6 font-semibold text-midnight bg-purple-50/20">Held locally in browser memory (GDPR friendly)</td>
              <td class="p-4 sm:px-6 text-slate-600">Stored on third-party cloud servers</td>
              <td class="p-4 sm:px-6 text-slate-600">Varies by vendor</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Zip Captions Does Even More -->
    <div class="bg-white rounded-3xl p-8 sm:p-10 border border-slate-200 shadow-sm space-y-6">
      <h2 class="text-2xl font-bold font-heading text-midnight">
        Zip Captions Does Even More
      </h2>
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm text-slate-700 font-medium">
        <li class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-sm bg-amethyst"></span>
          Choose a dialect to get more accurate captioning
        </li>
        <li class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-sm bg-amethyst"></span>
          Choose from our AI powered captioning engine to get even better results
        </li>
        <li class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-sm bg-amethyst"></span>
          Change the layout to make it suit your needs
        </li>
        <li class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-sm bg-amethyst"></span>
          Caption in many languages
        </li>
      </ul>
      <div class="pt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-4 text-sm font-semibold">
        <a href="https://help.zipcaptions.app" target="_blank" rel="noopener noreferrer" class="text-amethyst hover:text-amethyst-dark inline-flex items-center gap-1">
          <span>See what is new and get help with Zip Captions &rarr;</span>
        </a>
        <a href="/pricing" class="text-teal-brand hover:text-teal-dark inline-flex items-center gap-1">
          <span>Check out our Pricing for AI based captions &rarr;</span>
        </a>
      </div>
    </div>

  </div>

</ProductLayout>
