---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';

const tiers = [
  {
    name: "Regular",
    price: "$0",
    period: "forever",
    description: "Standard browser-based captioning for individual use.",
    highlight: false,
    ctaText: "Start Now",
    ctaLink: "https://zipcaptions.app",
    external: true,
  },
  {
    name: "Free Tier",
    price: "$0",
    period: "with Patreon",
    description: "Join our free Patreon community for updates and assistance.",
    highlight: false,
    ctaText: "Join Free",
    ctaLink: "https://patreon.com/zipcaptions",
    external: true,
  },
  {
    name: "Essential Tier",
    price: "$5",
    period: "per month",
    description: "Unlock 5 hours of AI-powered captioning every month.",
    highlight: false,
    ctaText: "Choose Essential",
    ctaLink: "https://www.patreon.com/zipcaptions/membership",
    external: true,
  },
  {
    name: "Premium Tier",
    price: "$15",
    period: "per month",
    description: "Best for regular meetings, classes, and church broadcasts (10 hours AI).",
    highlight: true,
    badge: "Most Popular",
    ctaText: "Choose Premium",
    ctaLink: "https://patreon.com/zipcaptions/membership",
    external: true,
  },
  {
    name: "Platinum Tier",
    price: "$30",
    period: "per month",
    description: "Maximum AI captioning capacity (25 hours) plus SWAG & dedicated priority.",
    highlight: false,
    ctaText: "Choose Platinum",
    ctaLink: "https://patreon.com/zipcaptions/membership",
    external: true,
  },
];

const features = [
  { name: "Regular Captioning", values: ["Unlimited", "Unlimited", "Unlimited", "Unlimited", "Unlimited"] },
  { name: "Browser Support", values: ["WebSpeech Browsers²", "WebSpeech Browsers²", "Any Browser¹", "Any Browser¹", "Any Browser¹"] },
  { name: "Picture-in-Picture (PiP) Mode", values: ["Chromium (Chrome, Edge)⁸", "Chromium (Chrome, Edge)⁸", "Chromium (Chrome, Edge)⁸", "Chromium (Chrome, Edge)⁸", "Chromium (Chrome, Edge)⁸"] },
  { name: "Real-Time Translation", values: ["Chrome On-Device AI⁹", "Chrome On-Device AI⁹", "Chrome On-Device AI⁹", "Chrome On-Device AI⁹", "Chrome On-Device AI⁹"] },
  { name: "AI Captioning (/month)³", values: ["—", "Request⁷", "5 hours³", "10 hours³", "25 hours³"] },
  { name: "Transcription & Export", values: ["Yes", "Yes", "Yes", "Yes", "Yes"] },
  { name: "Customizable Appearance", values: ["Yes", "Yes", "Yes", "Yes", "Yes"] },
  { name: "Android Mobile App⁴", values: ["Yes", "Yes", "Yes", "Yes", "Yes"] },
  { name: "Mobile Browser Support", values: ["Yes", "Yes", "Yes", "Yes", "Yes"] },
  { name: "Windows App Available²", values: ["Yes", "Yes", "Yes", "Yes", "Yes"] },
  { name: "Support Available⁵", values: ["Discord Group", "Discord Group", "Priority Support", "Priority Support", "Priority Support"] },
  { name: "GDPR Compliant", values: ["Yes", "Yes", "Yes", "Yes", "Yes"] },
  { name: "Exclusive SWAG Pack", values: ["—", "—", "—", "—", "Yes"] },
];

const faqs = [
  {
    question: "What happens if our church, classroom, or livestream runs out of AI captioning hours right in the middle of a sermon or lecture? Does the screen go blank?",
    answer: "Never. We never cut off an active speaker or leave a deaf or hard-of-hearing viewer staring at a blank screen. If your monthly AI hour allocation (5 hrs on Essential, 10 hrs on Premium, or 25 hrs on Platinum) is reached mid-session, you can immediately switch to unlimited $0 Regular browser-based captioning in one click without losing your Broadcast Room Code or OBS/vMix connection."
  },
  {
    question: "When do I actually need paid AI Captioning ($5–$30/mo) versus the $0 Regular browser engine?",
    answer: "If you are using Google Chrome, Safari, or Edge in a quiet room with a good lapel or headset microphone, the $0 Regular tier (browser WebSpeech API) gives you unlimited live captions forever at zero cost. Paid AI Captioning (powered by Microsoft Azure AI) is built for tougher real-world conditions: distant podium mics, echoey sanctuaries, speakers with strong regional accents, specialized medical/academic terminology, or browsers that lack built-in WebSpeech support."
  },
  {
    question: "Do we have to pay extra when 50 students or 300 conference attendees scan our Broadcast QR code to read captions on their phones?",
    answer: "No. Audience viewing via Broadcast Room Codes and QR codes is 100% free and unlimited across every tier—including the $0 Regular tier. You never pay per viewer, per student, or per connected mobile device."
  },
  {
    question: "Our school district, university, or municipality cannot use Patreon or monthly credit cards. Can we purchase via invoice/PO, or get donated hours if we have zero budget?",
    answer: "Yes to both. If your school board, church, or organization requires an official invoice, purchase order (PO), or custom high-hour allocation for a multi-day conference, contact us directly through our Contact or Live Event Quotes page and we will set it up outside Patreon. And if you are an educator, non-profit, or community group with zero budget, apply to our Giving Back program to receive community-donated AI captioning hours at no cost."
  },
  {
    question: "Are EasySpeak AAC, EquiBrowse, and Zip Solutions Remediator included for free, or do they require a Patreon subscription?",
    answer: "All of our sister tools—including Zip EasySpeak & EasySpeak AI (offline AAC), EquiBrowse, Zip Speech for Google Meet, ZipPanel, Zip Connect, and Zip Captions for vMix—are 100% free ($0) with no Patreon subscription required. Zip Solutions Remediator for Google Workspace is also free from us and uses a Bring-Your-Own-Key (BYOK) Google Gemini API key so schools never pay per-student software markups."
  }
];
const pricingSchema = {
  "@type": "SoftwareApplication",
  "@id": "https://zipsolutions.org/pricing#software",
  "name": "Zip Captions",
  "applicationCategory": "EducationalApplication, UtilitiesApplication, MultimediaApplication",
  "operatingSystem": "All (Web Browser, Windows, macOS, Linux, ChromeOS, iOS, Android)",
  "url": "https://zipcaptions.app",
  "publisher": {
    "@id": "https://zipsolutions.org/#organization"
  },
  "offers": [
    {
      "@type": "Offer",
      "name": "Regular Tier (Browser Live Captioning)",
      "price": "0.00",
      "priceCurrency": "USD",
      "description": "100% free forever browser-based live captioning with unlimited usage, room broadcast codes, and OBS/vMix integration.",
      "availability": "https://schema.org/InStock",
      "url": "https://zipcaptions.app"
    },
    {
      "@type": "Offer",
      "name": "Free Tier (Patreon Community)",
      "price": "0.00",
      "priceCurrency": "USD",
      "description": "Free Patreon community membership with updates, Discord community support, and full access to standard browser captioning.",
      "availability": "https://schema.org/InStock",
      "url": "https://patreon.com/zipcaptions"
    },
    {
      "@type": "Offer",
      "name": "Essential Tier (5 Hours/Month AI Captions)",
      "price": "5.00",
      "priceCurrency": "USD",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": "5.00",
        "priceCurrency": "USD",
        "billingDuration": "P1M"
      },
      "description": "Unlocks 5 hours of enhanced cloud AI-powered live captioning every month.",
      "availability": "https://schema.org/InStock",
      "url": "https://www.patreon.com/zipcaptions/membership"
    },
    {
      "@type": "Offer",
      "name": "Premium Tier (10 Hours/Month AI Captions)",
      "price": "15.00",
      "priceCurrency": "USD",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": "15.00",
        "priceCurrency": "USD",
        "billingDuration": "P1M"
      },
      "description": "Unlocks 10 hours of enhanced cloud AI-powered live captioning every month for regular classes, meetings, and worship broadcasts.",
      "availability": "https://schema.org/InStock",
      "url": "https://www.patreon.com/zipcaptions/membership"
    },
    {
      "@type": "Offer",
      "name": "Platinum Tier (25 Hours/Month AI Captions + SWAG)",
      "price": "30.00",
      "priceCurrency": "USD",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": "30.00",
        "priceCurrency": "USD",
        "billingDuration": "P1M"
      },
      "description": "Unlocks 25 hours of enhanced cloud AI-powered live captioning every month plus supporter SWAG.",
      "availability": "https://schema.org/InStock",
      "url": "https://www.patreon.com/zipcaptions/membership"
    }
  ]
};
---

<BaseLayout 
  title="Zip Captions Pricing — Free Browser Live Captions & AI Transcription Plans" 
  description="Zip Captions is 100% free forever for standard browser-based live captioning. Explore affordable monthly Patreon tiers starting at $5/mo for enhanced AI transcription."
  schema={pricingSchema}
  faqs={faqs}
>
  
  <section class="bg-gradient-to-b from-white to-slate-50 border-b border-slate-200/80 pt-12 pb-14 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-sm font-bold text-amethyst tracking-wide uppercase mb-3 font-heading">
        Fair & Transparent
      </p>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-midnight font-heading">
        Zip Captions Pricing
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Zip Captions will always have a 100% free core tier. Choose an optional paid membership to unlock advanced AI captioning engines and support development.
      </p>
    </div>
  </section>

  <!-- Pricing Cards (Mobile & Tablet) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 mb-16">
      {tiers.map((tier) => (
        <div class={`rounded-3xl p-6 flex flex-col justify-between transition-all duration-200 ${
          tier.highlight 
            ? 'bg-midnight text-white ring-2 ring-amethyst shadow-xl relative' 
            : 'bg-white text-midnight border border-slate-200 shadow-sm hover:shadow-md'
        }`}>
          <div>
            {tier.badge && (
              <span class="inline-block mb-3 px-2.5 py-1 rounded-md text-xs font-bold uppercase tracking-wider bg-amethyst text-white">
                {tier.badge}
              </span>
            )}
            <h2 class={`text-lg font-bold font-heading mb-1 ${tier.highlight ? 'text-white' : 'text-midnight'}`}>
              {tier.name}
            </h2>
            <p class={`text-xs mb-4 min-h-[32px] ${tier.highlight ? 'text-slate-300' : 'text-slate-500'}`}>
              {tier.description}
            </p>
            <div class="mb-6">
              <span class={`text-3xl sm:text-4xl font-extrabold font-heading ${tier.highlight ? 'text-white' : 'text-midnight'}`}>
                {tier.price}
              </span>
              <span class={`text-xs ml-1 ${tier.highlight ? 'text-slate-300' : 'text-slate-500'}`}>
                / {tier.period}
              </span>
            </div>
          </div>

          <a 
            href={tier.ctaLink}
            target={tier.external ? "_blank" : undefined}
            rel={tier.external ? "noopener noreferrer" : undefined}
            class={`w-full py-2.5 px-4 rounded-xl text-center text-xs font-bold font-heading transition-colors ${
              tier.highlight
                ? 'bg-amethyst hover:bg-amethyst-dark text-white'
                : 'bg-slate-100 hover:bg-slate-200 text-midnight'
            }`}
          >
            {tier.ctaText}
          </a>
        </div>
      ))}
    </div>

    <!-- Comparison Table (Desktop & Scrollable) -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden mb-12">
      <div class="px-6 py-5 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between">
        <h2 class="text-xl font-bold font-heading text-midnight">Feature Matrix Comparison</h2>
        <span class="text-xs text-slate-500">Scroll horizontally on smaller screens</span>
      </div>
      
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse min-w-[700px]">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-200 text-xs uppercase tracking-wider text-slate-500">
              <th class="p-4 font-bold">Feature</th>
              {tiers.map((t) => (
                <th class={`p-4 font-bold text-center ${t.highlight ? 'bg-purple-50/60 text-amethyst' : ''}`}>
                  {t.name}
                </th>
              ))}
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-sm">
            {features.map((feat) => (
              <tr class="hover:bg-slate-50/60 transition-colors">
                <td class="p-4 font-medium text-slate-800">
                  {feat.name}
                </td>
                {feat.values.map((val, idx) => (
                  <td class={`p-4 text-center ${tiers[idx].highlight ? 'bg-purple-50/30 font-semibold text-midnight' : 'text-slate-600'}`}>
                    {val === "Yes" ? (
                      <span class="inline-flex items-center text-teal-brand font-semibold">
                        <svg class="w-4 h-4 mr-1 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                        </svg>
                        Yes
                      </span>
                    ) : (
                      val
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Footnotes -->
    <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200 text-xs text-slate-600 space-y-2 leading-relaxed">
      <p><b>1.</b> The paid tiers technically support any modern browser (including Chrome, Edge, Safari, Firefox, Opera, and Brave) because caption audio is processed in the cloud by Azure AI rather than browser-specific speech engines.</p>
      <p><b>2.</b> Regular free captioning works in any browser that supports the WebSpeech API (such as Google Chrome and Safari; Edge is supported when Zip Captions is installed from the Microsoft Store).</p>
      <p><b>3.</b> The number of hours are based on token usage. The tokens are awarded based on your Patreon tier, and are reliant upon you having an active Patreon subscription. Token allocation is subject to change at any point and is currently subsidized by our membership to the Microsoft Founders Hub.</p>
      <p><b>4.</b> You can install Zip Captions from the Google Play Store, but it will also run on iOS, either as an installable Progressive Web App, or in the browser.</p>
      <p><b>5.</b> Dedicated support is available for all tiers, however, response times will vary, and the lower tiers rely mainly on community support.</p>
      <p><b>6.</b> The price is stated in USD. The price can be changed at any time.</p>
      <p><b>7.</b> Requests can be made at any time by qualifying groups. <a href="/givingback" class="text-teal-brand font-medium underline">Read more about our giving back initiative</a>.</p>
      <p><b>8.</b> Picture-in-Picture (PiP) floating captions are supported in desktop Chromium-based browsers (Google Chrome, Microsoft Edge, Brave, and Opera) via the native Document Picture-in-Picture API. Browsers such as Firefox and Safari do not currently support Document Picture-in-Picture.</p>
      <p><b>9.</b> Free real-time live caption translation is powered by Google Chrome's built-in On-Device AI models, running locally inside Google Chrome with a one-click language download and zero cloud subscription costs.</p>
    </div>

  </div>

  <FaqSection faqs={faqs} groupName="faq-pricing" />

</BaseLayout>
