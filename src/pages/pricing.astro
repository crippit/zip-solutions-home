---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';

const tiers = [
  {
    name: "Regular",
    price: "$0",
    period: "forever",
    description: "Standard browser-based captioning for individual use.",
    highlight: false,
    ctaText: "Start Now",
    ctaLink: "https://zipcaptions.app",
    external: true,
  },
  {
    name: "Free Tier",
    price: "$0",
    period: "with Patreon",
    description: "Join our free Patreon community for updates and assistance.",
    highlight: false,
    ctaText: "Join Free",
    ctaLink: "https://patreon.com/zipcaptions",
    external: true,
  },
  {
    name: "Essential Tier",
    price: "$5",
    period: "per month",
    description: "Unlock 5 hours of AI-powered captioning every month.",
    highlight: false,
    ctaText: "Choose Essential",
    ctaLink: "https://www.patreon.com/zipcaptions/membership",
    external: true,
  },
  {
    name: "Premium Tier",
    price: "$15",
    period: "per month",
    description: "Best for individual educators, creators, and personal sessions (10 hours AI).",
    highlight: true,
    badge: "Most Popular",
    ctaText: "Choose Premium",
    ctaLink: "https://patreon.com/zipcaptions/membership",
    external: true,
  },
  {
    name: "Platinum Tier",
    price: "$30",
    period: "per month",
    description: "Maximum personal AI captioning capacity (25 hours) plus SWAG & priority.",
    highlight: false,
    ctaText: "Choose Platinum",
    ctaLink: "https://patreon.com/zipcaptions/membership",
    external: true,
  },
];

const features = [
  { name: "Regular Captioning", values: ["Unlimited", "Unlimited", "Unlimited", "Unlimited", "Unlimited"] },
  { name: "Browser Support (Captioning)", values: ["Chrome, Safari & Edge²", "Chrome, Safari & Edge²", "Any Browser¹", "Any Browser¹", "Any Browser¹"] },
  { name: "Broadcast / QR Viewing", values: ["Any Browser¹", "Any Browser¹", "Any Browser¹", "Any Browser¹", "Any Browser¹"] },
  { name: "Picture-in-Picture (PiP) Mode", values: ["Chromium (Chrome, Edge)⁸", "Chromium (Chrome, Edge)⁸", "Chromium (Chrome, Edge)⁸", "Chromium (Chrome, Edge)⁸", "Chromium (Chrome, Edge)⁸"] },
  { name: "Real-Time Translation", values: ["Chrome On-Device AI⁹", "Chrome On-Device AI⁹", "Chrome On-Device AI⁹", "Chrome On-Device AI⁹", "Chrome On-Device AI⁹"] },
  { name: "AI Captioning (/month)³", values: ["—", "Request⁷", "5 hours³", "10 hours³", "25 hours³"] },
  { name: "Transcription & Export", values: ["Yes", "Yes", "Yes", "Yes", "Yes"] },
  { name: "Customizable Appearance", values: ["Yes", "Yes", "Yes", "Yes", "Yes"] },
  { name: "Android Mobile App⁴", values: ["Yes", "Yes", "Yes", "Yes", "Yes"] },
  { name: "Mobile Browser Support", values: ["Yes", "Yes", "Yes", "Yes", "Yes"] },
  { name: "Windows App Available", values: ["Yes", "Yes", "Yes", "Yes", "Yes"] },
  { name: "Support Available⁵", values: ["Discord Group", "Discord Group", "Priority Support", "Priority Support", "Priority Support"] },
  { name: "GDPR Compliant", values: ["Yes", "Yes", "Yes", "Yes", "Yes"] },
  { name: "Exclusive SWAG Pack", values: ["—", "—", "—", "—", "Yes"] },
];

const faqs = [
  {
    question: "What happens if our church, classroom, or livestream runs out of AI captioning hours right in the middle of a sermon or lecture? Does the screen go blank?",
    answer: "Never. We never cut off an active speaker or leave a deaf or hard-of-hearing viewer staring at a blank screen. If your monthly AI hour allocation (5 hrs on Essential, 10 hrs on Premium, or 25 hrs on Platinum) is reached mid-session, you can immediately switch to unlimited $0 Regular free captioning in one click (in Chrome, Safari, or Edge) without losing your Broadcast Room Code or OBS/vMix connection."
  },
  {
    question: "When do I actually need paid AI Captioning ($5–$30/mo) versus $0 Regular free captioning?",
    answer: "If you are using Google Chrome, Apple Safari, or Microsoft Edge in a quiet room with a good lapel or headset microphone, the $0 Regular tier gives you unlimited live captions forever at zero cost. Paid AI Captioning (powered by Microsoft Azure AI) is built for tougher real-world conditions: distant podium mics, echoey sanctuaries, speakers with strong regional accents, specialized medical/academic terminology, or capturing captions in browsers that do not support free captioning (such as Firefox, Brave, or Opera). Viewing shared Broadcast or QR code streams works for free in any browser."
  },
  {
    question: "Do we have to pay extra when 50 students or 300 conference attendees scan our Broadcast QR code to read captions on their phones?",
    answer: "No. Audience viewing via Broadcast Room Codes and QR codes is 100% free and unlimited across every tier—including the $0 Regular tier. You never pay per viewer, per student, or per connected mobile device."
  },
  {
    question: "Our school district, university, or enterprise cannot use Patreon or needs dedicated event support. How does Enterprise pricing work?",
    answer: "Patreon memberships are designed for personal or individual usage. For enterprise deployments, multi-room conferences, or institutions requiring dedicated support and official Purchase Order (PO) invoicing, our enterprise pricing is $1,000 for Day 1 (includes 1 room), $250 for each additional day, and $200 per day for each additional room. Use our Enterprise Pricing Calculator (/enterprise-pricing) to configure your exact schedule and submit a custom quote request."
  },
  {
    question: "Are EasySpeak AAC, EquiBrowse, and Zip Solutions Remediator included for free, or do they require a Patreon subscription?",
    answer: "All of our sister tools—including Zip EasySpeak & EasySpeak AI (offline AAC), EquiBrowse, Zip Speech for Google Meet, ZipPanel, Zip Connect, and Zip Captions for vMix—are 100% free ($0) with no Patreon subscription required. Zip Solutions Remediator for Google Workspace is also free from us and uses a Bring-Your-Own-Key (BYOK) Google Gemini API key so schools never pay per-student software markups."
  }
];
const pricingSchema = {
  "@type": "SoftwareApplication",
  "@id": "https://zipsolutions.org/pricing#software",
  "name": "Zip Captions",
  "applicationCategory": "EducationalApplication, UtilitiesApplication, MultimediaApplication",
  "operatingSystem": "All (Web Browser, Windows, macOS, Linux, ChromeOS, iOS, Android)",
  "url": "https://zipcaptions.app",
  "publisher": {
    "@id": "https://zipsolutions.org/#organization"
  },
  "offers": [
    {
      "@type": "Offer",
      "name": "Regular Tier (Browser Live Captioning)",
      "price": "0.00",
      "priceCurrency": "USD",
      "description": "100% free forever browser-based live captioning with unlimited usage, room broadcast codes, and OBS/vMix integration.",
      "availability": "https://schema.org/InStock",
      "url": "https://zipcaptions.app"
    },
    {
      "@type": "Offer",
      "name": "Free Tier (Patreon Community)",
      "price": "0.00",
      "priceCurrency": "USD",
      "description": "Free Patreon community membership with updates, Discord community support, and full access to standard browser captioning.",
      "availability": "https://schema.org/InStock",
      "url": "https://patreon.com/zipcaptions"
    },
    {
      "@type": "Offer",
      "name": "Essential Tier (5 Hours/Month AI Captions)",
      "price": "5.00",
      "priceCurrency": "USD",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": "5.00",
        "priceCurrency": "USD",
        "billingDuration": "P1M"
      },
      "description": "Unlocks 5 hours of enhanced cloud AI-powered live captioning every month.",
      "availability": "https://schema.org/InStock",
      "url": "https://www.patreon.com/zipcaptions/membership"
    },
    {
      "@type": "Offer",
      "name": "Premium Tier (10 Hours/Month AI Captions)",
      "price": "15.00",
      "priceCurrency": "USD",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": "15.00",
        "priceCurrency": "USD",
        "billingDuration": "P1M"
      },
      "description": "Unlocks 10 hours of enhanced cloud AI-powered live captioning every month for regular classes, meetings, and worship broadcasts.",
      "availability": "https://schema.org/InStock",
      "url": "https://www.patreon.com/zipcaptions/membership"
    },
    {
      "@type": "Offer",
      "name": "Platinum Tier (25 Hours/Month AI Captions + SWAG)",
      "price": "30.00",
      "priceCurrency": "USD",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": "30.00",
        "priceCurrency": "USD",
        "billingDuration": "P1M"
      },
      "description": "Unlocks 25 hours of enhanced cloud AI-powered live captioning every month plus supporter SWAG.",
      "availability": "https://schema.org/InStock",
      "url": "https://www.patreon.com/zipcaptions/membership"
    }
  ]
};
---

<BaseLayout 
  title="Zip Captions Pricing — Free Browser Live Captions & AI Transcription Plans" 
  description="Zip Captions is 100% free forever for standard browser-based live captioning. Explore affordable monthly Patreon tiers starting at $5/mo for enhanced AI transcription."
  schema={pricingSchema}
  faqs={faqs}
>
  
  <section class="bg-gradient-to-b from-white to-slate-50 border-b border-slate-200/80 pt-12 pb-14 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-sm font-bold text-amethyst tracking-wide uppercase mb-3 font-heading">
        Fair & Transparent
      </p>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-midnight font-heading">
        Zip Captions Pricing
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Zip Captions will always have a 100% free core tier. Patreon memberships are designed for <strong>personal or individual usage</strong>, while organizations and events requiring dedicated support can build a tailored quote with our <strong>Enterprise Pricing Calculator</strong>.
      </p>

      <!-- Usage Track Selector Cards -->
      <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4 text-left max-w-3xl mx-auto">
        <a 
          href="#personal-plans" 
          class="p-5 rounded-2xl bg-white border-2 border-amethyst/40 hover:border-amethyst shadow-xs transition-all flex flex-col justify-between group"
        >
          <div>
            <span class="text-xs font-bold font-mono uppercase tracking-wider text-amethyst block mb-1">
              Personal &amp; Individual Usage
            </span>
            <h2 class="text-base sm:text-lg font-bold font-heading text-midnight">
              Free &amp; Patreon Monthly Tiers ($0–$30/mo)
            </h2>
            <p class="text-xs text-slate-600 mt-1 leading-relaxed">
              Self-serve browser captioning and monthly AI hour packs via Patreon for individual users, solo teachers, and personal streams.
            </p>
          </div>
          <span class="mt-3 text-xs font-bold text-amethyst group-hover:underline inline-flex items-center gap-1">
            <span>View Individual Plans Below</span>
            <span aria-hidden="true">&darr;</span>
          </span>
        </a>

        <a 
          href="/enterprise-pricing" 
          class="p-5 rounded-2xl bg-midnight text-white border-2 border-midnight hover:border-teal-brand shadow-md transition-all flex flex-col justify-between group"
        >
          <div>
            <span class="text-xs font-bold font-mono uppercase tracking-wider text-teal-light block mb-1">
              Enterprise &amp; Supported Events
            </span>
            <h2 class="text-base sm:text-lg font-bold font-heading text-white">
              Custom Enterprise Quote Calculator
            </h2>
            <p class="text-xs text-slate-300 mt-1 leading-relaxed">
              $1,000 Day 1 • +$250 each additional day • +$200/day per additional room. Includes dedicated support &amp; invoice/PO billing.
            </p>
          </div>
          <span class="mt-3 text-xs font-bold text-teal-light group-hover:underline inline-flex items-center gap-1">
            <span>Build an Enterprise Quote</span>
            <span aria-hidden="true">&rarr;</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Pricing Cards (Mobile & Tablet) -->
  <div id="personal-plans" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 scroll-mt-20">
    <div class="mb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div>
        <span class="text-xs font-bold font-mono uppercase tracking-wider text-amethyst block mb-1">
          Self-Serve Individual Memberships
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold font-heading text-midnight">
          Personal &amp; Individual Usage Plans (via Patreon)
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 mt-1">
          Patreon support tiers are intended for personal or individual usage. Need enterprise deployment, multi-room support, or PO invoicing? <a href="/enterprise-pricing" class="text-teal-brand font-bold underline hover:text-teal-dark">Use the Enterprise Pricing Calculator &rarr;</a>
        </p>
      </div>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 mb-16">
      {tiers.map((tier) => (
        <div class={`rounded-3xl p-6 flex flex-col justify-between transition-all duration-200 ${
          tier.highlight 
            ? 'bg-midnight text-white ring-2 ring-amethyst shadow-xl relative' 
            : 'bg-white text-midnight border border-slate-200 shadow-sm hover:shadow-md'
        }`}>
          <div>
            {tier.badge && (
              <span class="inline-block mb-3 px-2.5 py-1 rounded-md text-xs font-bold uppercase tracking-wider bg-amethyst text-white">
                {tier.badge}
              </span>
            )}
            <h2 class={`text-lg font-bold font-heading mb-1 ${tier.highlight ? 'text-white' : 'text-midnight'}`}>
              {tier.name}
            </h2>
            <p class={`text-xs mb-4 min-h-[32px] ${tier.highlight ? 'text-slate-300' : 'text-slate-500'}`}>
              {tier.description}
            </p>
            <div class="mb-6">
              <span class={`text-3xl sm:text-4xl font-extrabold font-heading ${tier.highlight ? 'text-white' : 'text-midnight'}`}>
                {tier.price}
              </span>
              <span class={`text-xs ml-1 ${tier.highlight ? 'text-slate-300' : 'text-slate-500'}`}>
                / {tier.period}
              </span>
            </div>
          </div>

          <a 
            href={tier.ctaLink}
            target={tier.external ? "_blank" : undefined}
            rel={tier.external ? "noopener noreferrer" : undefined}
            class={`w-full py-2.5 px-4 rounded-xl text-center text-xs font-bold font-heading transition-colors ${
              tier.highlight
                ? 'bg-amethyst hover:bg-amethyst-dark text-white'
                : 'bg-slate-100 hover:bg-slate-200 text-midnight'
            }`}
          >
            {tier.ctaText}
          </a>
        </div>
      ))}
    </div>

    <!-- Comparison Table (Desktop & Scrollable) -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden mb-12">
      <div class="px-6 py-5 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between">
        <h2 class="text-xl font-bold font-heading text-midnight">Feature Matrix Comparison</h2>
        <span class="text-xs text-slate-500">Scroll horizontally on smaller screens</span>
      </div>
      
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse min-w-[700px]">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-200 text-xs uppercase tracking-wider text-slate-500">
              <th class="p-4 font-bold">Feature</th>
              {tiers.map((t) => (
                <th class={`p-4 font-bold text-center ${t.highlight ? 'bg-purple-50/60 text-amethyst' : ''}`}>
                  {t.name}
                </th>
              ))}
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-sm">
            {features.map((feat) => (
              <tr class="hover:bg-slate-50/60 transition-colors">
                <td class="p-4 font-medium text-slate-800">
                  {feat.name}
                </td>
                {feat.values.map((val, idx) => (
                  <td class={`p-4 text-center ${tiers[idx].highlight ? 'bg-purple-50/30 font-semibold text-midnight' : 'text-slate-600'}`}>
                    {val === "Yes" ? (
                      <span class="inline-flex items-center text-teal-brand font-semibold">
                        <svg class="w-4 h-4 mr-1 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                        </svg>
                        Yes
                      </span>
                    ) : (
                      val
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Enterprise & Supported Events Callout Card -->
    <div class="bg-gradient-to-br from-midnight to-slate-900 text-white rounded-3xl p-8 sm:p-10 border border-slate-800 shadow-xl mb-12 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8">
      <div class="space-y-3 max-w-2xl">
        <span class="text-xs font-bold font-mono uppercase tracking-wider text-teal-light block">
          Enterprise &amp; Supported Live Events
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold font-heading text-white">
          Need Zip Captions for Enterprise or Multi-Room Events with Dedicated Support?
        </h2>
        <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
          While Patreon tiers are built for personal and individual usage, our Enterprise model includes dedicated technical support, custom AI vocabulary setup, multi-room QR relays, and official Invoice/PO billing:
        </p>
        <div class="flex flex-wrap gap-3 pt-1 text-xs font-mono">
          <span class="px-3 py-1.5 rounded-xl bg-white/10 border border-white/15 text-white font-bold">
            1 Day = $1,000
          </span>
          <span class="px-3 py-1.5 rounded-xl bg-white/10 border border-white/15 text-teal-light font-bold">
            Each Additional Day = +$250
          </span>
          <span class="px-3 py-1.5 rounded-xl bg-white/10 border border-white/15 text-coral-light font-bold">
            Additional Rooms = +$200 / room / day
          </span>
        </div>
      </div>
      <div class="shrink-0 w-full lg:w-auto">
        <a 
          href="/enterprise-pricing" 
          class="w-full lg:w-auto inline-flex items-center justify-center gap-2 px-7 py-4 rounded-xl font-heading font-bold text-white bg-teal-brand hover:bg-teal-light hover:text-midnight shadow-md transition-all text-sm sm:text-base"
        >
          <span>Open Enterprise Quote Calculator</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>

    <!-- Footnotes -->
    <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200 text-xs text-slate-600 space-y-2 leading-relaxed">
      <p><b>1.</b> Paid AI captioning and Broadcast / QR room viewing work in any modern web browser (including Google Chrome, Microsoft Edge, Apple Safari, Mozilla Firefox, Opera, and Brave).</p>
      <p><b>2.</b> Regular free captioning (microphone capture) is supported in Google Chrome, Apple Safari, and Microsoft Edge. Browsers such as Firefox, Brave, and Opera require a paid AI tier to capture captions, though viewing shared Broadcast / QR streams works for free in any browser.</p>
      <p><b>3.</b> The number of hours are based on token usage. The tokens are awarded based on your Patreon tier, and are reliant upon you having an active Patreon subscription. Token allocation is subject to change at any point and is currently subsidized by our membership to the Microsoft Founders Hub.</p>
      <p><b>4.</b> You can install Zip Captions from the Google Play Store, but it will also run on iOS, either as an installable Progressive Web App, or in the browser.</p>
      <p><b>5.</b> Dedicated support is available for all tiers, however, response times will vary, and the lower tiers rely mainly on community support.</p>
      <p><b>6.</b> The price is stated in USD. The price can be changed at any time.</p>
      <p><b>7.</b> Requests can be made at any time by qualifying groups. <a href="/givingback" class="text-teal-brand font-medium underline">Read more about our giving back initiative</a>.</p>
      <p><b>8.</b> Picture-in-Picture (PiP) floating captions are supported in desktop Chromium-based browsers (Google Chrome, Microsoft Edge, Brave, and Opera) via the native Document Picture-in-Picture API. Browsers such as Firefox and Safari do not currently support Document Picture-in-Picture.</p>
      <p><b>9.</b> Free real-time live caption translation is powered by Google Chrome's built-in On-Device AI models, running locally inside Google Chrome with a one-click language download and zero cloud subscription costs.</p>
    </div>

  </div>

  <FaqSection faqs={faqs} groupName="faq-pricing" />

</BaseLayout>
