---
import BaseLayout from '../layouts/BaseLayout.astro';

const features = [
  {
    title: "Zip Captions",
    details: "We are the creators of Zip Captions, a totally free to use, privacy focused, Live Captioning tool that runs in any modern browser.",
    icon: "captions",
    badge: "Flagship",
    color: "bg-amethyst",
  },
  {
    title: "Privacy Focused",
    details: "We only collect the data that we need, and nothing more. We never track you, and we don't sell your data. Your audio stays private.",
    icon: "shield",
    badge: "Core Value",
    color: "bg-teal-brand",
  },
  {
    title: "Dignity",
    details: "Zip Solutions is committed to providing a private, seamless, and dignified live captioning and communication experience for all users.",
    icon: "heart",
    badge: "Philosophy",
    color: "bg-coral",
  },
  {
    title: "Inclusivity & Accessibility",
    details: "Creating tools which allow everyone to be included—in the classroom, lecture hall, theatre, place of worship, or wider community.",
    icon: "users",
    badge: "Mission",
    color: "bg-indigo-600",
  },
  {
    title: "Community",
    details: "Building open community is just as vital as building software. We collaborate closely with educators, d/Deaf mentors, and advocates.",
    icon: "messages",
    badge: "Open Source",
    color: "bg-teal-dark",
  },
  {
    title: "Respect",
    details: "We respect our users and their unique needs. If there's an adaptation or feature you need to succeed, our advisory team is here.",
    icon: "check",
    badge: "Commitment",
    color: "bg-amethyst-dark",
  }
];
---

<BaseLayout 
  title="Zip Solutions | The Home of Accessibility"
  description="Zip Solutions creates open, private, and dignified accessibility tools including Zip Captions, EasySpeak AAC, and assistive listening integrations."
>

  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-12 sm:pt-20 pb-20 sm:pb-28 bg-gradient-to-b from-white via-slate-50 to-alabaster border-b border-slate-200/80">
    
    <!-- Subtle background pattern accents -->
    <div class="absolute inset-0 pointer-events-none opacity-40">
      <div class="absolute -top-40 -right-40 w-96 h-96 rounded-full bg-amethyst/10 blur-3xl"></div>
      <div class="absolute -bottom-40 -left-40 w-96 h-96 rounded-full bg-teal-brand/10 blur-3xl"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      

      <!-- Main Logo Banner -->
      <div class="flex justify-center mb-8">
        <img 
          src="/images/zipsolutions_logo.png" 
          alt="ZipSolutions" 
          class="h-16 sm:h-24 md:h-28 w-auto object-contain drop-shadow-sm" 
          width="400"
          height="96"
        />
      </div>

      <!-- Hero Heading -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-midnight font-heading max-w-4xl mx-auto leading-[1.1]">
        The Home of <span class="bg-gradient-to-r from-amethyst via-purple-600 to-teal-brand bg-clip-text text-transparent">Accessibility</span>
      </h1>

      <!-- Subtitle -->
      <p class="mt-6 text-lg sm:text-xl md:text-2xl text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Empowering communication with real-time live captions, AAC tools, and inclusive educational technology.
      </p>

      <!-- CTA Buttons -->
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4 max-w-md mx-auto">
        <a 
          href="/products" 
          class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 rounded-2xl font-heading font-bold text-base text-white bg-midnight hover:bg-slate-800 shadow-md hover:shadow-xl transition-all duration-200 focus-visible:ring-2 focus-visible:ring-midnight"
        >
          Explore All Tools
        </a>
        <a 
          href="https://zipcaptions.app" 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-2xl font-heading font-bold text-base text-amethyst hover:text-white bg-purple-50 hover:bg-amethyst border border-amethyst/30 hover:border-amethyst transition-all duration-200 focus-visible:ring-2 focus-visible:ring-amethyst"
        >
          <span>Launch Zip Captions</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>

      <!-- Quick Trust Indicators -->
      <div class="mt-12 flex flex-wrap items-center justify-center gap-6 sm:gap-10 text-xs font-semibold uppercase tracking-wider text-slate-500">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-teal-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
          100% Free Live Captioning
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-teal-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
          Zero User Tracking
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-teal-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
          Classroom & Broadcast Ready
        </div>
      </div>

    </div>
  </section>

  <!-- Core Features / Pillars Section -->
  <section class="py-20 sm:py-28 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl sm:text-4xl font-extrabold font-heading text-midnight">
        Built on Values That Matter
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-600">
        Every tool we design is engineered to respect individual privacy, dignity, and universal access without barriers.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {features.map((feature) => (
        <div class="group bg-white rounded-3xl p-8 border border-slate-200/80 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class={`inline-block w-12 h-12 rounded-2xl ${feature.color} text-white flex items-center justify-center shadow-md`}>
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </span>
              <span class="text-xs font-mono font-bold uppercase tracking-wider text-slate-500">
                {feature.badge}
              </span>
            </div>
            
            <h3 class="text-xl font-bold font-heading text-midnight mb-3 group-hover:text-amethyst transition-colors">
              {feature.title}
            </h3>

            <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
              {feature.details}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-100 flex items-center text-xs font-bold text-teal-brand">
            <span>Learn how we uphold this &rarr;</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Featured Spotlight: Zip Captions & EasySpeak -->
  <section class="py-16 bg-white border-y border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        
        <!-- Left: Image / Preview Card -->
        <div class="relative bg-slate-50 rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm overflow-hidden">
          <div class="absolute -right-8 -bottom-8 w-48 h-48 rounded-full bg-teal-brand/10 blur-2xl"></div>
          <img 
            src="/images/zippreview.png" 
            alt="Zip Captions in action" 
            class="rounded-2xl shadow-md border border-slate-200 w-full h-auto object-cover" 
          />
        </div>

        <!-- Right: Description & Highlights -->
        <div class="space-y-6">
          <p class="text-sm font-bold text-teal-brand tracking-wide uppercase font-heading">
            Featured Tool
          </p>
          <h2 class="text-3xl sm:text-4xl font-extrabold font-heading text-midnight">
            Zip Captions: Real-Time Captions for Everyone
          </h2>
          <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
            Zip Captions turns any web browser into a high-accuracy, private live transcription hub. With static share links, your viewers can follow along from their own phones, tablets, or laptops in real-time.
          </p>
          <ul class="space-y-3 text-sm sm:text-base text-slate-700">
            <li class="flex items-center gap-3">
              <span class="w-5 h-5 rounded-lg bg-teal-brand/10 text-teal-brand flex items-center justify-center text-xs font-bold">✓</span>
              Broadcast captions to remote viewers via unique share codes
            </li>
            <li class="flex items-center gap-3">
              <span class="w-5 h-5 rounded-lg bg-teal-brand/10 text-teal-brand flex items-center justify-center text-xs font-bold">✓</span>
              Built-in live streaming OBS websockets integration
            </li>
            <li class="flex items-center gap-3">
              <span class="w-5 h-5 rounded-lg bg-teal-brand/10 text-teal-brand flex items-center justify-center text-xs font-bold">✓</span>
              Download instant transcripts as SRT, VTT, or plain TXT
            </li>
          </ul>
          <div class="pt-2 flex flex-wrap gap-4">
            <a 
              href="/zipcaptions" 
              class="px-6 py-3 rounded-xl bg-midnight text-white text-sm font-bold font-heading hover:bg-slate-800 transition-colors"
            >
              Explore Zip Captions
            </a>
            <a 
              href="/pricing" 
              class="px-6 py-3 rounded-xl bg-slate-100 text-slate-800 text-sm font-bold font-heading hover:bg-slate-200 transition-colors"
            >
              View AI Pricing
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Testimonial Quote Callout -->
  <section class="py-20 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="bg-gradient-to-br from-purple-50/60 to-teal-50/60 rounded-3xl p-8 sm:p-12 border border-purple-100 shadow-sm relative overflow-hidden">
      <div class="text-amethyst/30 text-6xl font-serif leading-none absolute top-4 left-6 select-none">“</div>
      <blockquote class="text-lg sm:text-2xl font-medium text-slate-800 leading-relaxed mb-6 italic relative z-10">
        “When sound is available but not understood, it’s as if you are listening to a foreign language. With this closed caption I can follow the service and hear The Message. What a wonderful experience!”
      </blockquote>
      <div class="relative z-10">
        <p class="font-heading font-bold text-midnight text-base">Doris</p>
        <p class="text-xs sm:text-sm text-slate-500">Congregation Member, Rock Valley First Reformed Church</p>
      </div>
    </div>
  </section>

  <!-- CTA Consultation & Event Services Banner -->
  <section class="py-16 bg-midnight text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row items-center justify-between gap-8 text-center lg:text-left">
        <div class="space-y-3">
          <p class="text-xs font-bold uppercase tracking-wider text-teal-brand font-heading">
            Live Events • Hybrid Production • Professional Development
          </p>
          <h2 class="text-2xl sm:text-4xl font-extrabold font-heading text-white">
            Planning an In-Person or Hybrid Event?
          </h2>
          <p class="text-slate-300 text-sm sm:text-base max-w-2xl leading-relaxed">
            We provide full in-person and hybrid event organisation for educational institutions and organizations, including multi-track virtual sessions accompanied by <strong>Custom Professional Development</strong>. We also architect custom Zip Captions live solutions and provide tailored quotes.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3.5 shrink-0">
          <a 
            href="/contact-us" 
            class="inline-flex items-center justify-center px-8 py-4 rounded-2xl font-heading font-bold text-sm sm:text-base text-midnight bg-white hover:bg-alabaster shadow-lg transition-all"
          >
            Get a Custom Quote
          </a>
          <a 
            href="/products" 
            class="inline-flex items-center justify-center px-7 py-4 rounded-2xl font-heading font-bold text-sm sm:text-base text-white border border-slate-700 hover:bg-slate-800/80 transition-all"
          >
            Explore Services
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
