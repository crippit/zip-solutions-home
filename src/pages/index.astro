---
import BaseLayout from '../layouts/BaseLayout.astro';

const homeSchema = [
  {
    "@type": "WebSite",
    "@id": "https://zipsolutions.org/#website",
    "url": "https://zipsolutions.org",
    "name": "Zip Solutions",
    "description": "The Home of Accessibility: Empowering connection with live captioning, AAC tools, in-person and hybrid event organisation, and accessible learning.",
    "publisher": {
      "@id": "https://zipsolutions.org/#organization"
    }
  },
  {
    "@type": "EducationalOrganization",
    "@id": "https://zipsolutions.org/#organization",
    "name": "Zip Solutions",
    "url": "https://zipsolutions.org",
    "award": [
      "University of Portsmouth 2025 Alumni Impact Award Winner",
      "Virginia Society for Technology in Education (VSTE) Accessibility Demo Slam Winner"
    ],
    "funder": [
      {
        "@type": "Organization",
        "name": "Dell Technologies Education Canada Innovation Accelerator"
      },
      {
        "@type": "Organization",
        "name": "Microsoft for Startups Founders Hub"
      }
    ]
  }
];

const features = [
  {
    title: "Zip Captions",
    details: "We are the creators of Zip Captions, a totally free to use, privacy focused, Live Captioning tool that runs in any modern browser.",
    icon: "ear",
    badge: "Flagship",
    color: "bg-amethyst",
    href: "/zipcaptions",
    linkText: "Explore Zip Captions",
  },
  {
    title: "Privacy Focused",
    details: "We only collect the data that we need, and nothing more. We never track you, and we don't sell your data. Your audio stays private.",
    icon: "shield",
    badge: "Core Value",
    color: "bg-teal-brand",
    href: "/privacy",
    linkText: "Read our Privacy Architecture",
  },
  {
    title: "Dignity",
    details: "Zip Solutions is committed to providing a private, seamless, and dignified live captioning and communication experience for all users.",
    icon: "heart",
    badge: "Philosophy",
    color: "bg-coral",
    href: "/story",
    linkText: "Discover our Story & Philosophy",
  },
  {
    title: "Inclusivity & Accessibility",
    details: "Creating tools which allow everyone to be included: in the classroom, lecture hall, theatre, place of worship, or wider community.",
    icon: "users",
    badge: "Mission",
    color: "bg-indigo-600",
    href: "/products",
    linkText: "Explore Accessibility Solutions",
  },
  {
    title: "Community",
    details: "Building open community is just as vital as building software. We collaborate closely with educators, d/Deaf mentors, and advocates.",
    icon: "chat",
    badge: "Open Source",
    color: "bg-teal-dark",
    href: "/advisory",
    linkText: "Meet our Advisory Board",
    secondaryHref: "https://discord.gg/5Hyu7sQTHv",
    secondaryLinkText: "Discord Forum",
  },
  {
    title: "Respect",
    details: "We respect our users and their unique needs. Share your suggestions, feedback, and accommodation requests directly on our forum.",
    icon: "hand",
    badge: "Commitment",
    color: "bg-amethyst-dark",
    href: "https://discord.gg/5Hyu7sQTHv",
    linkText: "Join our Discord Forum",
    external: true,
  }
];
---

<BaseLayout 
  title="Zip Solutions | The Home of Accessibility"
  description="Empowering communication with free real-time live captions, AAC tools, and inclusive educational technology. Winner of the 2025 University of Portsmouth Alumni Impact Award."
  schema={homeSchema}
>
  
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-12 sm:pt-20 pb-16 sm:pb-24 bg-gradient-to-b from-white via-slate-50 to-alabaster border-b border-slate-200/80">
    
    <!-- Subtle background pattern accents -->
    <div class="absolute inset-0 pointer-events-none opacity-40">
      <div class="absolute -top-40 -right-40 w-96 h-96 rounded-full bg-amethyst/10 blur-3xl"></div>
      <div class="absolute -bottom-40 -left-40 w-96 h-96 rounded-full bg-teal-brand/10 blur-3xl"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      
      <!-- Main Logo Banner -->
      <div class="flex justify-center mb-8">
        <img 
          src="/images/zipsolutions_logo.svg" 
          alt="Zip Solutions" 
          class="h-16 sm:h-24 md:h-28 w-auto object-contain drop-shadow-sm" 
          width="400"
          height="96"
        />
      </div>

      <!-- Hero Heading -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-midnight font-heading max-w-4xl mx-auto leading-[1.1]">
        The Home of <span class="bg-gradient-to-r from-amethyst via-purple-600 to-teal-brand bg-clip-text text-transparent">Accessibility</span>
      </h1>

      <!-- Subtitle -->
      <p class="mt-6 text-lg sm:text-xl md:text-2xl text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Empowering communication with real-time live captions, AAC tools, and inclusive educational technology.
      </p>

      <!-- CTA Buttons -->
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4 max-w-md mx-auto">
        <a 
          href="/products" 
          class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 rounded-2xl font-heading font-bold text-base text-white bg-midnight hover:bg-slate-800 shadow-md hover:shadow-xl transition-all duration-200 focus-visible:ring-2 focus-visible:ring-midnight"
        >
          Explore All Tools
        </a>
        <a 
          href="https://zipcaptions.app" 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-2xl font-heading font-bold text-base text-amethyst hover:text-white bg-purple-50 hover:bg-amethyst border border-amethyst/30 hover:border-amethyst transition-all duration-200 focus-visible:ring-2 focus-visible:ring-amethyst"
        >
          <span>Launch Zip Captions</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>

      <!-- Quick Trust Indicators -->
      <div class="mt-12 flex flex-wrap items-center justify-center gap-6 sm:gap-10 text-xs font-semibold uppercase tracking-wider text-slate-500">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-teal-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
          100% Free Live Captioning
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-teal-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
          Zero User Tracking
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-teal-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
          Classroom and Broadcast Ready
        </div>
      </div>

    </div>
  </section>

  <!-- Institutional Accolades & Partners Section (Two-Tier, Zero Pills) -->
  <section class="bg-slate-50/80 border-b border-slate-200 py-16 sm:py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto space-y-12">
      
      <!-- Section Header: Centered Typographic Hierarchy -->
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="text-xs font-bold font-mono text-amethyst uppercase tracking-wider block">
          Accolades and Institutional Partners
        </span>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-midnight tracking-tight font-heading">
          Recognized Across Higher Education, School Boards, and Innovation Programs
        </h2>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
          From university research honors to provincial school districts and live streaming communities, discover how Zip Captions levels the playing field.
        </p>
      </div>

      <!-- Tier 1: Two Featured Award Cards (Zero Pills: Clean Left-Aligned Header) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
        
        <!-- Card 1: University of Portsmouth -->
        <div class="bg-white border border-slate-200 hover:border-amethyst/50 rounded-2xl p-6 sm:p-8 transition-all shadow-sm hover:shadow-md flex flex-col justify-between group">
          <div class="space-y-4">
            <div class="flex items-center gap-4">
              <a 
                href="https://myport.port.ac.uk/news-events-and-blogs/news/students-contribution-to-the-community-celebrated-at-the-2025-student-impact-awards" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="w-16 h-16 rounded-2xl bg-white p-2.5 border border-slate-200 flex items-center justify-center shadow-xs shrink-0 hover:border-amethyst/50 transition-colors"
                title="Read University of Portsmouth Official Citation"
              >
                <img src="/images/logos/portsmouth.svg" alt="University of Portsmouth Official Logo" class="h-11 w-auto object-contain" loading="lazy" />
              </a>
              <div>
                <span class="text-xs font-bold font-mono text-amethyst uppercase tracking-wider block">
                  Alumni Impact Award Winner (May 2025)
                </span>
                <h3 class="text-lg font-bold text-midnight font-heading leading-tight">
                  <a 
                    href="https://myport.port.ac.uk/news-events-and-blogs/news/students-contribution-to-the-community-celebrated-at-the-2025-student-impact-awards" 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="hover:text-amethyst transition-colors"
                  >
                    University of Portsmouth
                  </a>
                </h3>
                <p class="text-xs text-slate-500 font-medium mt-0.5">
                  Student Impact Awards
                </p>
              </div>
            </div>

            <div class="pt-2">
              <h4 class="text-base font-bold text-midnight font-heading">
                Revolutionizing Accessibility in Education
              </h4>
              <p class="text-slate-600 text-xs sm:text-sm mt-1 leading-relaxed">
                Honoring exceptional innovation and service. Awarded to co-founder Chris Webb for creating Zip Captions: an open-source tool providing real-time live captioning aiding over 1,500 global users.
              </p>
            </div>

            <blockquote class="border-l-4 border-amethyst pl-3 py-1.5 text-xs text-slate-600 italic bg-purple-50/50 rounded-r-xl">
              "Chris's innovative work embodies the University's values, making education accessible for all."
            </blockquote>
          </div>

          <div class="pt-5 mt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3">
            <a href="/press#portsmouth" class="text-xs text-slate-500 hover:text-midnight font-medium transition-colors">
              Higher Education Impact &bull; Press
            </a>
            <a 
              href="https://myport.port.ac.uk/news-events-and-blogs/news/students-contribution-to-the-community-celebrated-at-the-2025-student-impact-awards" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="text-xs font-bold text-teal-brand hover:text-teal-700 inline-flex items-center gap-1 group-hover:translate-x-0.5 transition-transform"
            >
              <span>Read Official Citation</span>
              <svg class="w-3.5 h-3.5 ml-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Card 2: VSTE Accessibility Demo Slam -->
        <div class="bg-white border border-slate-200 hover:border-teal-300 rounded-2xl p-6 sm:p-8 transition-all shadow-sm hover:shadow-md flex flex-col justify-between group">
          <div class="space-y-4">
            <div class="flex items-center gap-4">
              <a 
                href="https://www.youtube.com/watch?v=u2wNoSQz0Zk" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="w-16 h-16 rounded-2xl bg-white p-2.5 border border-slate-200 flex items-center justify-center shadow-xs shrink-0 hover:border-teal-300 transition-colors"
                title="Watch VSTE Winning Demo on YouTube"
              >
                <img src="/images/logos/vste.png" alt="Virginia Society for Technology in Education Logo" class="h-8 w-auto object-contain" loading="lazy" />
              </a>
              <div>
                <span class="text-xs font-bold font-mono text-teal-brand uppercase tracking-wider block">
                  Accessibility Demo Slam Winner
                </span>
                <h3 class="text-lg font-bold text-midnight font-heading leading-tight">
                  <a 
                    href="https://www.youtube.com/watch?v=u2wNoSQz0Zk" 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="hover:text-teal-brand transition-colors"
                  >
                    Virginia Society for Tech in Ed
                  </a>
                </h3>
                <p class="text-xs text-slate-500 font-medium mt-0.5">
                  Universal Design for Learning
                </p>
              </div>
            </div>

            <div class="pt-2">
              <h4 class="text-base font-bold text-midnight font-heading">
                Universal Design for Learning in Classrooms
              </h4>
              <p class="text-slate-600 text-xs sm:text-sm mt-1 leading-relaxed">
                Presented by Katie Fielding (Book Creator, VSTE Coach of the Year) showcasing how Zip Captions supports emerging readers, ELL students, and hearing-impaired learners with Lexend font options and dark contrast.
              </p>
            </div>

            <blockquote class="border-l-4 border-teal-brand pl-3 py-1.5 text-xs text-slate-600 italic bg-teal-50/50 rounded-r-xl">
              "A really powerful way to live caption your class that supports all learners in your classroom."
            </blockquote>
          </div>

          <div class="pt-5 mt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3">
            <a href="/testimonial#katie-fielding" class="text-xs text-slate-500 hover:text-midnight font-medium transition-colors">
              Katie Fielding &bull; Testimonial
            </a>
            <a 
              href="https://www.youtube.com/watch?v=u2wNoSQz0Zk" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="text-xs font-bold text-teal-brand hover:text-teal-700 inline-flex items-center gap-1 group-hover:translate-x-0.5 transition-transform"
            >
              <span>Watch Winning Demo</span>
              <svg class="w-3.5 h-3.5 ml-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>

      </div>

      <!-- Tier 2: Institutional & Program Partners Logo Bar (Zero Pills) -->
      <div class="pt-8 border-t border-slate-200 space-y-6">
        <div class="text-center">
          <span class="text-xs font-bold font-mono text-slate-400 uppercase tracking-wider">
            Innovation Accelerators, District Partners and Publications
          </span>
        </div>

        <!-- 6-Logo Clean Grid with Official Sourced Logos -->
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 items-stretch">
          
          <!-- Logo 1: Dell Technologies -->
          <div class="p-4 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-xs transition-all flex flex-col items-center justify-between text-center group">
            <div class="h-12 w-full flex items-center justify-center">
              <img src="/images/logos/dell.svg" alt="Dell Technologies Official Logo" class="h-6 max-w-[80%] object-contain opacity-75 group-hover:opacity-100 transition-opacity" loading="lazy" />
            </div>
            <span class="text-xs text-slate-500 font-medium mt-2">Innovation Accelerator</span>
          </div>

          <!-- Logo 2: Microsoft for Startups -->
          <div class="p-4 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-xs transition-all flex flex-col items-center justify-between text-center group">
            <div class="h-12 w-full flex items-center justify-center">
              <img src="/images/logos/microsoft.svg" alt="Microsoft Official Logo" class="h-6 max-w-[80%] object-contain opacity-75 group-hover:opacity-100 transition-opacity" loading="lazy" />
            </div>
            <span class="text-xs text-slate-500 font-medium mt-2">Founders Program</span>
          </div>

          <!-- Logo 3: EMSB Inspirations -->
          <div class="p-4 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-xs transition-all flex flex-col items-center justify-between text-center group">
            <div class="h-12 w-full flex items-center justify-center">
              <img src="/images/logos/emsb.svg" alt="English Montreal School Board Logo" class="h-8 max-w-[90%] object-contain opacity-80 group-hover:opacity-100 transition-opacity" loading="lazy" />
            </div>
            <span class="text-xs text-slate-500 font-medium mt-2">Inspirations Newspaper</span>
          </div>

          <!-- Logo 4: Lester B. Pearson -->
          <div class="p-4 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-xs transition-all flex flex-col items-center justify-between text-center group">
            <div class="h-12 w-full flex items-center justify-center">
              <img src="/images/logos/pearson.svg" alt="Lester B. Pearson School Board Logo" class="h-9 max-w-[80%] object-contain opacity-75 group-hover:opacity-100 transition-opacity" loading="lazy" />
            </div>
            <span class="text-xs text-slate-500 font-medium mt-2">The Pearson News</span>
          </div>

          <!-- Logo 5: Hear Entendre Quebec -->
          <div class="p-4 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-xs transition-all flex flex-col items-center justify-between text-center group">
            <div class="h-12 w-full flex items-center justify-center">
              <img src="/images/logos/hear_quebec.png" alt="Hear Entendre Quebec Logo" class="h-8 max-w-[90%] object-contain opacity-75 group-hover:opacity-100 transition-opacity" loading="lazy" />
            </div>
            <span class="text-xs text-slate-500 font-medium mt-2">Hear Hear! Magazine</span>
          </div>

          <!-- Logo 6: Audition Quebec -->
          <div class="p-4 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-xs transition-all flex flex-col items-center justify-between text-center group">
            <div class="h-12 w-full flex items-center justify-center">
              <img src="/images/logos/audition_quebec.png" alt="Audition Quebec Logo" class="h-9 max-w-[80%] object-contain opacity-75 group-hover:opacity-100 transition-opacity" loading="lazy" />
            </div>
            <span class="text-xs text-slate-500 font-medium mt-2">Revue Technologique</span>
          </div>

        </div>
      </div>

    </div>
  </section>

  <!-- Core Features / Pillars Section -->
  <section class="py-20 sm:py-28 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl sm:text-4xl font-extrabold font-heading text-midnight">
        Built on Values That Matter
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-600">
        Every tool we design is engineered to respect individual privacy, dignity, and universal access without barriers.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {features.map((feature) => (
        <div class="group bg-white rounded-3xl p-8 border border-slate-200/80 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class={`w-12 h-12 rounded-2xl ${feature.color} text-white flex items-center justify-center shadow-md`}>
                {feature.icon === 'ear' && (
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 100-6 3 3 0 000 6z" />
                  </svg>
                )}
                {feature.icon === 'shield' && (
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                )}
                {feature.icon === 'heart' && (
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                  </svg>
                )}
                {feature.icon === 'users' && (
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                  </svg>
                )}
                {feature.icon === 'chat' && (
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                  </svg>
                )}
                {feature.icon === 'hand' && (
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5" />
                  </svg>
                )}
              </span>
              <span class="text-xs font-bold font-mono tracking-wider text-slate-400 uppercase">
                {feature.badge}
              </span>
            </div>

            <h3 class="text-xl font-bold font-heading text-midnight group-hover:text-amethyst transition-colors">
              {feature.title}
            </h3>
            
            <p class="mt-3 text-slate-600 text-sm leading-relaxed">
              {feature.details}
            </p>
          </div>

          <div class="mt-8 pt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2">
            <a 
              href={feature.href} 
              class="inline-flex items-center text-xs font-bold text-teal-brand hover:text-teal-700 transition-colors"
            >
              <span>{feature.linkText}</span>
              <svg class="w-3.5 h-3.5 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
