---
import BaseLayout from '../layouts/BaseLayout.astro';

const homeSchema = [
  {
    "@type": "WebPage",
    "@id": "https://zipsolutions.org/#webpage",
    "url": "https://zipsolutions.org/",
    "name": "Zip Solutions — The Home of Accessibility",
    "description": "Free browser-based live captioning (Zip Captions), offline AI AAC tools (EasySpeak), formative math assessment (Remediator), hybrid event production, custom live event captioning, Google for Education training, and assistive listening consultancy.",
    "isPartOf": {
      "@id": "https://zipsolutions.org/#website"
    },
    "about": {
      "@id": "https://zipsolutions.org/#organization"
    },
    "mainEntity": {
      "@id": "https://zipsolutions.org/#organization"
    }
  },
  {
    "@type": "SoftwareApplication",
    "@id": "https://zipsolutions.org/#zipcaptions",
    "name": "Zip Captions",
    "url": "https://zipcaptions.app",
    "applicationCategory": "EducationalApplication, UtilitiesApplication, MultimediaApplication",
    "operatingSystem": "All (Web Browser, Windows, macOS, Linux, ChromeOS, iOS, Android)",
    "publisher": {
      "@id": "https://zipsolutions.org/#organization"
    },
    "offers": [
      {
        "@type": "Offer",
        "name": "Regular Tier — Browser Live Captioning (Free Forever)",
        "price": "0.00",
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://zipcaptions.app"
      },
      {
        "@type": "Offer",
        "name": "Essential Tier — 5 Hours/Month AI Captions",
        "price": "5.00",
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://zipsolutions.org/pricing"
      },
      {
        "@type": "Offer",
        "name": "Premium Tier — 10 Hours/Month AI Captions",
        "price": "15.00",
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://zipsolutions.org/pricing"
      },
      {
        "@type": "Offer",
        "name": "Platinum Tier — 25 Hours/Month AI Captions + SWAG",
        "price": "30.00",
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://zipsolutions.org/pricing"
      }
    ]
  }
];

const features = [
  {
    title: "Live Captioning & Broadcast",
    details: "Browser-based real-time transcription with Zip Captions, plus native vMix Bridge, Stream Deck Companion, ZipPanel, and Zip Connect integrations.",
    icon: "captions",
    badge: "Family 01 • Flagship",
    color: "bg-amethyst",
    href: "/zipcaptions",
    linkText: "Explore Zip Captions",
    secondaryHref: "https://zipcaptions.app",
    secondaryLinkText: "Launch App ↗",
    secondaryExternal: true,
  },
  {
    title: "AAC & Speech Synthesis",
    details: "Dignified communication with Zip EasySpeak, offline on-device AI prediction, classroom printable boards, and Zip Speech for Google Meet.",
    icon: "chat",
    badge: "Family 02 • Offline AI",
    color: "bg-teal-brand",
    href: "/easyspeak",
    linkText: "Explore EasySpeak AAC",
    secondaryHref: "/zipspeech",
    secondaryLinkText: "Zip Speech",
  },
  {
    title: "Equitable Reading & K-13 Learning",
    details: "Bionic reading, dyslexia-friendly fonts, and tint overlays via EquiBrowse, alongside our free BYOK Gemini math assessment remediator for Google Workspace.",
    icon: "book",
    badge: "Family 03 • K-13 & Workspace",
    color: "bg-indigo-600",
    href: "/zipmath",
    linkText: "Zip Math Remediator",
    secondaryHref: "/equibrowse",
    secondaryLinkText: "EquiBrowse",
  },
  {
    title: "Event Production & Educator PD",
    details: "Turnkey in-person, hybrid, and virtual conference production, stage surtitle displays, mobile QR attendee relays, and Google for Education Certified Trainer PD.",
    icon: "calendar",
    badge: "Family 04 • Events & PD",
    color: "bg-coral",
    href: "/events",
    linkText: "Events & Certified PD",
    secondaryHref: "/enterprise-pricing",
    secondaryLinkText: "Instant Quote",
  },
  {
    title: "AV Consultancy & Printable Kits",
    details: "Vendor-neutral assistive listening blueprints (Phonak Roger, Wi-Fi audio), theatre sound and lighting, plus free bilingual Printable Sector Kits.",
    icon: "headphones",
    badge: "Family 05 • Open Blueprints",
    color: "bg-teal-dark",
    href: "/use-cases",
    linkText: "Browse Sector Kits",
    secondaryHref: "https://resources.zipsolutions.org",
    secondaryLinkText: "Knowledge Base ↗",
    secondaryExternal: true,
  },
  {
    title: "Privacy & Dignity by Design",
    details: "Zero user tracking, no audio recording, 100% Free Forever core browser tools, and co-design governance with d/Deaf mentors, clinicians, and educators.",
    icon: "shield",
    badge: "Core Architecture",
    color: "bg-midnight",
    href: "/privacy",
    linkText: "Privacy Architecture",
    secondaryHref: "/advisory",
    secondaryLinkText: "Advisory Board",
  }
];

---

<BaseLayout 
  title="Zip Solutions | Free Live Captions, AAC Tools & Events"
  description="Free browser-based live captioning, offline AAC tools, hybrid event production and inclusive classroom tech. 2025 Portsmouth Alumni Impact Award winner."
  schema={homeSchema}
>
  
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-12 sm:pt-20 pb-16 sm:pb-24 bg-gradient-to-b from-white via-slate-50 to-alabaster border-b border-slate-200/80">
    
    <!-- Isometric micro-dot grid (drifts slowly behind content) + soft top wash -->
    <div class="absolute inset-0 pointer-events-none bg-[radial-gradient(ellipse_60%_45%_at_50%_0%,rgba(139,92,246,0.06),transparent_80%)]" aria-hidden="true"></div>
    <div class="iso-dots iso-mask-hero parallax-hero-bg absolute inset-x-0 -top-12 -bottom-4 pointer-events-none" aria-hidden="true"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      
      <!-- Hero Eyebrow -->
      <p class="text-xs sm:text-sm font-bold font-mono uppercase tracking-wider text-amethyst mb-4">
        Open-Source Assistive Tech &bull; Free Live Captions, AAC &amp; Event Production
      </p>

      <!-- Hero Heading -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-midnight font-heading max-w-4xl mx-auto leading-[1.1]">
        The Home of <span class="bg-gradient-to-r from-amethyst via-purple-600 to-teal-brand bg-clip-text text-transparent">Accessibility</span>
      </h1>

      <!-- Subtitle -->
      <p class="mt-6 text-lg sm:text-xl md:text-2xl text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Empowering communication with real-time live captions, AAC tools, and inclusive educational technology.
      </p>

      <!-- CTA Buttons -->
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4 max-w-md mx-auto">
        <a 
          href="/products" 
          class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 rounded-2xl font-heading font-bold text-base text-white bg-midnight hover:bg-slate-800 shadow-md hover:shadow-xl transition-all duration-200 focus-visible:ring-2 focus-visible:ring-midnight"
        >
          Explore All Tools
        </a>
        <a 
          href="https://zipcaptions.app" 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-2xl font-heading font-bold text-base text-amethyst hover:text-white bg-purple-50 hover:bg-amethyst border border-amethyst/30 hover:border-amethyst transition-all duration-200 focus-visible:ring-2 focus-visible:ring-amethyst"
        >
          <span>Launch Zip Captions</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>

      <!-- Quick Trust Indicators -->
      <div class="mt-12 flex flex-wrap items-center justify-center gap-6 sm:gap-10 text-xs font-semibold uppercase tracking-wider text-slate-500">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-teal-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
          100% Free Live Captioning
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-teal-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
          Zero User Tracking
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-teal-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
          Classroom and Broadcast Ready
        </div>
      </div>

    </div>
  </section>

  <!-- Institutional Accolades & Partners Section (Two-Tier, Zero Pills) -->
  <section class="bg-slate-50/80 border-b border-slate-200 py-16 sm:py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto space-y-12">
      
      <!-- Section Header: Centered Typographic Hierarchy -->
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="text-xs font-bold font-mono text-amethyst uppercase tracking-wider block">
          Accolades and Institutional Partners
        </span>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-midnight tracking-tight font-heading">
          Recognized Across Higher Education, School Boards, and Innovation Programs
        </h2>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
          From university research honors to provincial school districts and live streaming communities, discover how Zip Captions levels the playing field.
        </p>
      </div>

      <!-- Tier 1: Two Featured Award Cards (Zero Pills: Clean Left-Aligned Header) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
        
        <!-- Card 1: University of Portsmouth -->
        <div class="bg-white border border-slate-200 hover:border-amethyst/50 rounded-2xl p-6 sm:p-8 transition-all shadow-sm hover:shadow-md flex flex-col justify-between group">
          <div class="space-y-4">
            <div class="flex items-center gap-4">
              <div class="w-16 h-16 rounded-2xl bg-white p-2.5 border border-slate-200 flex items-center justify-center shadow-xs shrink-0">
                <img src="/images/logos/portsmouth.svg" alt="University of Portsmouth Official Logo" class="h-11 w-auto object-contain" loading="lazy" />
              </div>
              <div>
                <span class="text-xs font-bold font-mono text-amethyst uppercase tracking-wider block">
                  Alumni Impact Award Winner (May 2025)
                </span>
                <h3 class="text-lg font-bold text-midnight font-heading leading-tight">
                  University of Portsmouth
                </h3>
                <p class="text-xs text-slate-600 font-medium mt-0.5">
                  Student Impact Awards
                </p>
              </div>
            </div>

            <div class="pt-2">
              <h4 class="text-base font-bold text-midnight font-heading">
                Revolutionizing Accessibility in Education
              </h4>
              <p class="text-slate-600 text-xs sm:text-sm mt-1 leading-relaxed">
                Honoring exceptional innovation and service. Awarded to co-founder Chris Webb for creating Zip Captions: an open-source tool providing real-time live captioning aiding over 1,500 global users.
              </p>
            </div>

            <blockquote class="p-3.5 text-xs text-slate-700 italic bg-purple-50/60 border border-purple-200/70 rounded-xl">
              "Chris's innovative work embodies the University's values, making education accessible for all."
            </blockquote>
          </div>

          <div class="pt-5 mt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3">
            <a href="/press#portsmouth" class="py-1.5 text-xs text-slate-600 hover:text-midnight font-medium transition-colors">
              Higher Education Impact &bull; Press
            </a>
            <a 
              href="https://www.port.ac.uk/news-events-and-blogs/news/students-contribution-to-the-community-celebrated-at-the-2025-student-impact-awards" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="py-1.5 text-xs font-bold text-teal-brand hover:text-teal-700 inline-flex items-center gap-1 group-hover:translate-x-0.5 transition-transform"
            >
              <span>Read Official Citation</span>
              <svg class="w-3.5 h-3.5 ml-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Card 2: VSTE Accessibility Demo Slam -->
        <div class="bg-white border border-slate-200 hover:border-teal-300 rounded-2xl p-6 sm:p-8 transition-all shadow-sm hover:shadow-md flex flex-col justify-between group">
          <div class="space-y-4">
            <div class="flex items-center gap-4">
              <div class="w-16 h-16 rounded-2xl bg-white p-2.5 border border-slate-200 flex items-center justify-center shadow-xs shrink-0">
                <img src="/images/logos/vste.png" alt="Virginia Society for Technology in Education Logo" class="h-8 w-auto object-contain" loading="lazy" />
              </div>
              <div>
                <span class="text-xs font-bold font-mono text-teal-brand uppercase tracking-wider block">
                  Accessibility Demo Slam Winner
                </span>
                <h3 class="text-lg font-bold text-midnight font-heading leading-tight">
                  Virginia Society for Tech in Ed
                </h3>
                <p class="text-xs text-slate-600 font-medium mt-0.5">
                  Universal Design for Learning
                </p>
              </div>
            </div>

            <div class="pt-2">
              <h4 class="text-base font-bold text-midnight font-heading">
                Universal Design for Learning in Classrooms
              </h4>
              <p class="text-slate-600 text-xs sm:text-sm mt-1 leading-relaxed">
                Presented by Katie Fielding (Book Creator, VSTE Coach of the Year) showcasing how Zip Captions supports emerging readers, ELL students, and hearing-impaired learners with Lexend font options and dark contrast.
              </p>
            </div>

            <blockquote class="p-3.5 text-xs text-slate-700 italic bg-teal-50/60 border border-teal-200/70 rounded-xl">
              "A really powerful way to live caption your class that supports all learners in your classroom."
            </blockquote>
          </div>

          <div class="pt-5 mt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3">
            <a href="/testimonial#katie-fielding" class="py-1.5 text-xs text-slate-600 hover:text-midnight font-medium transition-colors">
              Katie Fielding &bull; Testimonial
            </a>
            <a 
              href="https://www.youtube.com/watch?v=u2wNoSQz0Zk" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="py-1.5 text-xs font-bold text-teal-brand hover:text-teal-700 inline-flex items-center gap-1 group-hover:translate-x-0.5 transition-transform"
            >
              <span>Watch Winning Demo</span>
              <svg class="w-3.5 h-3.5 ml-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>

      </div>

      <!-- Tier 2: Institutional & Program Partners Logo Bar (Zero Pills) -->
      <div class="pt-8 border-t border-slate-200 space-y-6">
        <div class="text-center">
          <span class="text-xs font-bold font-mono text-slate-600 uppercase tracking-wider">
            Innovation Accelerators, District Partners and Publications
          </span>
        </div>

        <!-- 6-Logo Clean Grid with Official Sourced Logos -->
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 items-stretch">
          
          <!-- Logo 1: Dell Technologies -->
          <div class="p-4 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-xs transition-all flex flex-col items-center justify-between text-center group">
            <div class="h-12 w-full flex items-center justify-center">
              <img src="/images/logos/dell.svg" alt="Dell Technologies Official Logo" class="h-6 max-w-[80%] object-contain opacity-75 group-hover:opacity-100 transition-opacity" loading="lazy" />
            </div>
            <span class="text-xs text-slate-500 font-medium mt-2">Innovation Accelerator</span>
          </div>

          <!-- Logo 2: Microsoft for Startups -->
          <div class="p-4 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-xs transition-all flex flex-col items-center justify-between text-center group">
            <div class="h-12 w-full flex items-center justify-center">
              <img src="/images/logos/microsoft.svg" alt="Microsoft Official Logo" class="h-6 max-w-[80%] object-contain opacity-75 group-hover:opacity-100 transition-opacity" loading="lazy" />
            </div>
            <span class="text-xs text-slate-500 font-medium mt-2">Founders Program</span>
          </div>

          <!-- Logo 3: EMSB Inspirations -->
          <div class="p-4 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-xs transition-all flex flex-col items-center justify-between text-center group">
            <div class="h-12 w-full flex items-center justify-center">
              <img src="/images/logos/emsb.svg" alt="English Montreal School Board Logo" class="h-8 max-w-[90%] object-contain opacity-80 group-hover:opacity-100 transition-opacity" loading="lazy" />
            </div>
            <span class="text-xs text-slate-500 font-medium mt-2">Inspirations Newspaper</span>
          </div>

          <!-- Logo 4: Lester B. Pearson -->
          <div class="p-4 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-xs transition-all flex flex-col items-center justify-between text-center group">
            <div class="h-12 w-full flex items-center justify-center">
              <img src="/images/logos/pearson.svg" alt="Lester B. Pearson School Board Logo" class="h-9 max-w-[80%] object-contain opacity-75 group-hover:opacity-100 transition-opacity" loading="lazy" />
            </div>
            <span class="text-xs text-slate-500 font-medium mt-2">The Pearson News</span>
          </div>

          <!-- Logo 5: Hear Entendre Quebec -->
          <div class="p-4 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-xs transition-all flex flex-col items-center justify-between text-center group">
            <div class="h-12 w-full flex items-center justify-center">
              <img src="/images/logos/hear_quebec.png" alt="Hear Entendre Quebec Logo" class="h-8 max-w-[90%] object-contain opacity-75 group-hover:opacity-100 transition-opacity" loading="lazy" />
            </div>
            <span class="text-xs text-slate-500 font-medium mt-2">Hear Hear! Magazine</span>
          </div>

          <!-- Logo 6: Audition Quebec -->
          <div class="p-4 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-xs transition-all flex flex-col items-center justify-between text-center group">
            <div class="h-12 w-full flex items-center justify-center">
              <img src="/images/logos/audition_quebec.png" alt="Audition Quebec Logo" class="h-9 max-w-[80%] object-contain opacity-75 group-hover:opacity-100 transition-opacity" loading="lazy" />
            </div>
            <span class="text-xs text-slate-500 font-medium mt-2">Revue Technologique</span>
          </div>

        </div>
      </div>

    </div>
  </section>

  <!-- 5-Family Product & Service Hub + Privacy Architecture Section -->
  <section class="py-20 sm:py-28 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold font-mono text-amethyst uppercase tracking-wider block mb-2">
        Five Accessibility Families &bull; Privacy by Design
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold font-heading text-midnight">
        Tools, Live Events, and Open Blueprints
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-600">
        Explore our five assistive technology and service families—every one engineered to respect individual privacy, dignity, and universal access without barriers.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {features.map((feature) => (
        <div class="group bg-white rounded-3xl p-8 border border-slate-200/80 shadow-sm hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class={`w-12 h-12 rounded-2xl ${feature.color} text-white flex items-center justify-center shadow-md`}>
                {feature.icon === 'captions' && (
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h6m-6 4h8M5 4h14a2 2 0 012 2v12a2 2 0 01-2 2H5a2 2 0 01-2-2V6a2 2 0 012-2z" />
                  </svg>
                )}
                {feature.icon === 'chat' && (
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                  </svg>
                )}
                {feature.icon === 'book' && (
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                  </svg>
                )}
                {feature.icon === 'calendar' && (
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                )}
                {feature.icon === 'headphones' && (
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 00-14 0v6a2 2 0 002 2h1a1 1 0 001-1v-4a1 1 0 00-1-1H6v-2a5 5 0 0110 0v2h-2a1 1 0 00-1 1v4a1 1 0 001 1h1a2 2 0 002-2v-6z" />
                  </svg>
                )}
                {feature.icon === 'shield' && (
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                )}
              </span>
              <span class="text-xs font-bold font-mono tracking-wider text-slate-600 uppercase">
                {feature.badge}
              </span>
            </div>

            <h3 class="text-xl font-bold font-heading text-midnight group-hover:text-amethyst transition-colors">
              {feature.title}
            </h3>
            
            <p class="mt-3 text-slate-600 text-sm leading-relaxed">
              {feature.details}
            </p>
          </div>

          <div class="mt-8 pt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2">
            <a 
              href={feature.href} 
              class="py-1.5 inline-flex items-center text-xs font-bold text-teal-brand hover:text-teal-700 transition-colors"
            >
              <span>{feature.linkText}</span>
              <svg class="w-3.5 h-3.5 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
            {feature.secondaryHref && (
              <a 
                href={feature.secondaryHref} 
                target={feature.secondaryExternal ? "_blank" : undefined}
                rel={feature.secondaryExternal ? "noopener noreferrer" : undefined}
                class="py-1.5 inline-flex items-center text-xs font-semibold text-slate-600 hover:text-midnight transition-colors"
              >
                <span>{feature.secondaryLinkText}</span>
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

