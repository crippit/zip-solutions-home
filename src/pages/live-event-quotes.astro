---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import FaqSection from '../components/FaqSection.astro';

const displayOptions = [
  {
    title: "Attendee Personal Device Relay (via QR Code)",
    description: "The simplest and most accessible option. We provide a unique QR code you can display on stage or in programs. Attendees scan it to follow real-time captions directly on their own phone, tablet, or laptop at their seat.",
    icon: "qrcode",
    recommended: true
  },
  {
    title: "Stage Screens & Venue Displays",
    description: "Display live captions directly on an auditorium projector, confidence monitor, or side TV with clean, readable, high-contrast formatting that works with your room lighting.",
    icon: "projector"
  },
  {
    title: "Live Stream Integration (vMix & OBS)",
    description: "Connect captions directly into your broadcast switcher. With our vMix extension or standard browser source inputs, you get clean, digital on-screen titles without fuzzy desktop screen captures.",
    icon: "stream"
  },
  {
    title: "Scripted Theatre Surtitles",
    description: "Experience implementing and cueing scripted surtitles for live theatre, plays, and musical performances, keeping text synchronized with actors' line delivery.",
    icon: "theatre"
  }
];

const quoteChecklist = [
  "Event date, time, and expected duration",
  "Event format (in-person, virtual, or hybrid)",
  "How you want captions displayed (QR attendee relay, projector screen, vMix stream, or theatre surtitles)",
  "Venue location and any specific audio-visual questions"
];

const liveCaptionsServiceSchema = {
  "@type": "Service",
  "@id": "https://zipsolutions.org/live-event-quotes#service",
  "name": "Custom Live Event Captions, QR Code Relay & Theatre Surtitles",
  "provider": {
    "@id": "https://zipsolutions.org/#organization"
  },
  "serviceType": "Live Event Captioning & Theatrical Surtitling",
  "description": "Flexible, browser-powered live captions for conferences, auditorium presentations, QR code personal device relays, broadcast streams (vMix & OBS), and scripted theatre surtitles. Serving Montreal, Quebec, Canada on-site and events worldwide.",
  "url": "https://zipsolutions.org/live-event-quotes",
  "areaServed": [
    { "@type": "City", "name": "Montreal" },
    { "@type": "AdministrativeArea", "name": "Quebec" },
    { "@type": "Country", "name": "Canada" },
    { "@type": "Country", "name": "United States" },
    { "@type": "Country", "name": "United Kingdom" },
    { "@type": "Place", "name": "Worldwide" }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Live Event Captioning & Surtitle Packages",
    "itemListElement": [
      {
        "@type": "Offer",
        "name": "Attendee Personal Device Relay (via QR Code)",
        "description": "Custom event quote. Real-time live captions streamed directly to attendee smartphones, tablets, and laptops via a scannable QR code."
      },
      {
        "@type": "Offer",
        "name": "Stage Screens, Venue Displays & vMix/OBS Stream Overlays",
        "description": "Custom event quote. High-contrast auditorium projection displays and direct digital title overlays for vMix and OBS Studio broadcasts."
      },
      {
        "@type": "Offer",
        "name": "Scripted Theatre Surtitles",
        "description": "Custom production quote. Pre-loaded and live-cued theatrical surtitles synchronized with live stage actors and musical performances."
      }
    ]
  }
};

const quoteFaqs = [
  {
    question: "Why can't we just run automatic speech-to-text for a live theatre play, musical, or scripted ceremony?",
    answer: "Automated speech-to-text struggles in live theatre because actors project dramatically, overlap dialogue, sing over musical accompaniment, and rely on split-second comedic or dramatic timing—a two-second AI lag or misheard word ruins a punchline or spoils a scene. For theatre and scripted shows, we pre-load your script and manually cue surtitles live in real time to match the actors' exact delivery on stage screens or attendee smartphones."
  },
  {
    question: "Our conference has 4 breakout rooms running at the same time and no budget to put giant LED caption screens in every room. How do we make all 4 rooms accessible?",
    answer: "That is exactly what our QR Code Attendee Personal Device Relay is built for. Instead of renting extra projectors and screens for every breakout room, we assign each room a static QR code poster at the door and on the presenter's opening slide. Attendees scan the room's QR code with their phone or laptop to read real-time captions right at their seat, with zero app downloads."
  },
  {
    question: "What does our venue AV tech actually need to hand you on the day of the event?",
    answer: "Just two things: a clean line-level audio feed of the speaking microphones from the venue soundboard (XLR, 1/4-inch TRS, or USB audio interface—with walk-in music and crowd mics excluded) and a standard power outlet. If you also want captions on a stage monitor or vMix/OBS livestream, we connect via HDMI or local network WebSockets/HTTP in minutes."
  },
  {
    question: "What if our keynote speakers use heavy industry acronyms, French/English bilingual switches, or specialized proper nouns?",
    answer: "Before your event, send us your agenda, speaker names, organization acronyms, and slide decks. We configure custom vocabulary lists and language profiles (including English and Canadian French) so proper nouns, sponsor names, and technical terms transcribe accurately."
  },
  {
    question: "How quickly do you turn around live event quotes, and what areas do you serve on-site vs. remotely?",
    answer: "We respond within one business day with a clear setup recommendation and transparent quote. We provide on-site event captioning and theatre surtitling across Greater Montreal, Quebec, and Canada, and support virtual or hybrid conference streams worldwide."
  }
];
---

<BaseLayout 
  title="Live Event Captions, QR Relay & Theatre Surtitles Quotes | Zip Solutions" 
  description="Request a custom quote for browser-powered live event captions: conference QR code phone relays, auditorium screens, vMix/OBS broadcast streams, and theatre surtitles."
  schema={liveCaptionsServiceSchema}
  faqs={quoteFaqs}
>
  <Fragment slot="head">
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  </Fragment>

  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-white to-slate-50 border-b border-slate-200/80 pt-14 pb-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-sm font-bold text-teal-brand tracking-wide uppercase mb-3 font-heading">
        Live Event Captions &amp; Surtitles
      </p>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-midnight font-heading leading-tight">
        Live Captions &amp; Surtitles Tailored for Your Event
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Flexible, browser-powered live captions for conferences, auditorium presentations, broadcast streams, and scripted theatre.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href="/enterprise-pricing" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl font-heading font-bold text-white bg-teal-brand hover:bg-teal-dark shadow-md hover:shadow-lg transition-all text-sm"
        >
          <span>Calculate Instant Enterprise Quote</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        <a 
          href="#quote-form" 
          class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-3.5 rounded-xl font-heading font-bold text-midnight hover:text-amethyst bg-white border border-slate-300 hover:border-amethyst transition-colors text-sm"
        >
          Request a Custom Quote
        </a>
        <a 
          href="#display-options" 
          class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-3.5 rounded-xl font-heading font-bold text-slate-700 hover:text-midnight bg-slate-100 hover:bg-slate-200 transition-colors text-sm"
        >
          View Display Options
        </a>
      </div>
    </div>
  </section>

  <!-- Versatile Display Options Grid -->
  <section id="display-options" class="py-16 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <p class="text-xs font-bold uppercase tracking-wider text-amethyst font-heading mb-2">
        Flexible Display Modes
      </p>
      <h2 class="text-2xl sm:text-4xl font-extrabold font-heading text-midnight">
        Versatile Ways to Display Captions
      </h2>
      <p class="mt-3 text-slate-600 text-sm sm:text-base leading-relaxed">
        Choose the display arrangement that fits your venue architecture and audience workflow.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {displayOptions.map((option) => (
        <div class="bg-white rounded-3xl p-8 sm:p-10 border border-slate-200 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-6">
              <div class="w-12 h-12 rounded-2xl bg-teal-brand/10 text-teal-brand flex items-center justify-center">
                {option.icon === 'qrcode' && (
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
                  </svg>
                )}
                {option.icon === 'projector' && (
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                )}
                {option.icon === 'stream' && (
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                  </svg>
                )}
                {option.icon === 'theatre' && (
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z" />
                  </svg>
                )}
              </div>
              {option.recommended && (
                <span class="text-xs font-semibold text-teal-brand tracking-wide uppercase">
                  Most Popular
                </span>
              )}
            </div>

            <h3 class="text-xl font-bold font-heading text-midnight mb-3">
              {option.title}
            </h3>

            <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
              {option.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Privacy Guarantee Card -->
  <section class="pb-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-gradient-to-r from-purple-50 via-slate-50 to-teal-50/50 rounded-3xl p-8 sm:p-10 border border-slate-200">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-wider text-amethyst font-heading block mb-2">
          Privacy Commitment
        </span>
        <h3 class="text-xl sm:text-2xl font-bold font-heading text-midnight mb-3">
          100% Private by Design
        </h3>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
          Audio processed through Zip Captions stays private. Audio is not saved, stored, or sold. Your presenters, attendees, and discussions remain confidential.
        </p>
      </div>
    </div>
  </section>

  <!-- Quote Information & Form -->
  <section id="quote-form" class="py-16 bg-slate-50 border-t border-slate-200/80 scroll-mt-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      
      <div class="text-center max-w-2xl mx-auto">
        <span class="text-xs font-bold uppercase tracking-wider text-teal-brand font-heading block mb-2">
          Tailored Consultation
        </span>
        <h2 class="text-2xl sm:text-4xl font-extrabold font-heading text-midnight">
          Request a Custom Live Event Quote
        </h2>
        <p class="mt-3 text-slate-600 text-sm sm:text-base leading-relaxed">
          Every venue and production has different requirements. Fill out your event parameters below to receive a clear, personalized proposal.
        </p>
      </div>

      <!-- Quote Checklist Banner -->
      <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-4">
        <h3 class="text-base font-bold font-heading text-midnight">
          Information that helps us prepare your estimate:
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {quoteChecklist.map((item) => (
            <div class="flex items-start gap-3 p-3 rounded-2xl bg-slate-50 border border-slate-100 text-xs sm:text-sm text-slate-700">
              <span class="w-5 h-5 rounded-full bg-teal-brand/10 text-teal-brand flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">✓</span>
              <span>{item}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Interactive Quote Request Form -->
      <QuoteForm id="event-quote-request-form" />

      <div class="text-center text-xs text-slate-500 pt-2">
        <p>
          Need general help or partnership info instead? Visit our <a href="/contact-us" class="text-teal-brand font-semibold hover:underline">General Contact Page</a>.
        </p>
      </div>

    </div>
  </section>

  <FaqSection 
    title="Live Event Captioning & Surtitling FAQ"
    subtitle="Quick answers on quote turnaround times, display combinations, and theatrical surtitling."
    faqs={quoteFaqs}
  />

</BaseLayout>
