---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Advisory Board | Zip Solutions" 
  description="Meet the accessibility advocates, educators of the deaf, and community leaders who guide Zip Solutions."
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-white via-alabaster to-slate-100 border-b border-slate-200/80 pt-16 pb-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <!-- Top Navigation Tabs (Zero Pills) -->
      <div class="inline-flex p-1 bg-slate-200/70 rounded-xl mb-8">
        <a 
          href="/about-us" 
          class="px-5 py-2 rounded-lg text-xs font-bold font-heading text-slate-600 hover:text-midnight transition-colors"
        >
          Core Team
        </a>
        <a 
          href="/advisory" 
          class="px-5 py-2 rounded-lg text-xs font-bold font-heading bg-white text-midnight shadow-sm"
        >
          Advisory Board
        </a>
      </div>

      <p class="text-xs font-bold uppercase tracking-wider text-teal-brand font-heading mb-4">
        Guiding Light • Lived Experience • Advocacy
      </p>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-midnight font-heading tracking-tight leading-tight">
        Meet Our Advisory Board
      </h1>
      <p class="mt-4 text-base sm:text-xl text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Our Advisory Board unites educators of the deaf, community broadcasters, and advocates with lived experiences. They guide our product development, hold us accountable to accessibility standards, and champion Zip Captions worldwide.
      </p>
    </div>
  </section>

  <!-- Main Content -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20 space-y-16">

    <!-- Community & Lived Experience Overview (Connecting from Homepage) -->
    <div class="bg-gradient-to-br from-slate-900 via-midnight to-slate-950 rounded-3xl p-8 sm:p-12 text-white border border-slate-800 shadow-xl">
      <div class="max-w-3xl space-y-4">
        <span class="text-xs font-bold uppercase tracking-wider text-teal-brand font-heading block">
          Community Co-Design
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold font-heading tracking-tight">
          Rooted in Community &amp; Lived Experience
        </h2>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
          Meaningful accessibility cannot be engineered in a corporate vacuum. We believe that software design must be guided directly by the educators, specialists, and individuals who navigate accessibility challenges every single day.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-4 border-t border-slate-800">
          <div>
            <h3 class="text-sm font-bold font-heading text-white mb-1">Pedagogical Rigor</h3>
            <p class="text-xs text-slate-400 leading-relaxed">Counsel from certified teachers of the deaf to ensure evidence-based classroom efficacy.</p>
          </div>
          <div>
            <h3 class="text-sm font-bold font-heading text-white mb-1">Lived Perspectives</h3>
            <p class="text-xs text-slate-400 leading-relaxed">Direct accountability to individuals with hearing loss and auditory-verbal lived experiences.</p>
          </div>
          <div>
            <h3 class="text-sm font-bold font-heading text-white mb-1">Broadcast Reliability</h3>
            <p class="text-xs text-slate-400 leading-relaxed">Real-world guidance from volunteer broadcast directors and community producers.</p>
          </div>
        </div>

        <div class="pt-4 flex flex-wrap items-center gap-4 border-t border-slate-800/80">
          <a 
            href="https://discord.gg/5Hyu7sQTHv" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-heading font-bold text-xs text-midnight bg-teal-brand hover:bg-teal-300 shadow-md transition-all"
          >
            <span>Join Our Discord Community Forum</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
          <span class="text-xs text-slate-400">Share feedback, request features, and connect with fellow educators &amp; advocates.</span>
        </div>
      </div>
    </div>

    <!-- Board Members List -->
    <div class="space-y-10">

      <!-- Member 1: Andrea Lepore -->
      <article class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 sm:p-10 lg:p-12 transition-all hover:border-amethyst/40">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <div class="lg:col-span-4 flex flex-col items-center sm:items-start text-center sm:text-left space-y-4">
            <div class="relative">
              <img 
                src="/images/Andrea_Circle.png" 
                alt="Andrea Lepore" 
                class="w-36 h-36 sm:w-44 sm:h-44 rounded-2xl object-cover border-2 border-purple-100 shadow-md"
                loading="lazy"
              />
            </div>

            <div>
              <h2 class="text-2xl font-bold font-heading text-midnight">Andrea Lepore</h2>
              <p class="text-amethyst font-semibold text-sm font-heading mt-0.5">
                Teacher of the Deaf & Hard of Hearing
              </p>
              <p class="text-xs text-slate-500 font-mono mt-1">Montreal, Quebec, Canada</p>
            </div>

            <ul class="text-xs font-medium text-slate-500 font-mono space-y-1 pt-1 text-left inline-block sm:block">
              <li>• IAAP Professional</li>
              <li>• CAEDHH Director</li>
              <li>• Hear/Entendre QC Board</li>
            </ul>
          </div>

          <div class="lg:col-span-8 space-y-4 text-slate-700 text-sm sm:text-base leading-relaxed">
            <p>
              Andrea is a certified Teacher of the Deaf and Hard of Hearing at the Montreal Oral School for the Deaf (MOSD). She has extensive experience working as both a classroom teacher and an itinerant educational specialist providing individual educational and listening and spoken language support to mainstream students with hearing loss.
            </p>
            <p>
              At 10 years of age, Andrea was diagnosed with a progressive sensorineural hearing loss and fitted with bilateral hearing aids. She now uses cochlear implants to help her listen and communicate. These personal and professional experiences deeply fuel her dedication to accessibility, self-advocacy, and inclusive universal design.
            </p>
            <p>
              Andrea holds a Bachelor of Arts Specialization in Early Childhood and Elementary Education from Concordia University and a Master of Education of the Deaf from Smith College / Clarke Schools for Hearing and Speech. She serves as Quebec Regional Director on the National Executive of the Canadian Association of Educators of the Deaf and Hard of Hearing (CAEDHH), sits on the Board of Directors at Hear/Entendre Québec, and volunteers as a mentor with the Canadian Hard of Hearing Association (CHHA).
            </p>
          </div>
        </div>
      </article>

      <!-- Member 2: Kevin Bouwman -->
      <article class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 sm:p-10 lg:p-12 transition-all hover:border-teal-200">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <div class="lg:col-span-4 flex flex-col items-center sm:items-start text-center sm:text-left space-y-4">
            <div class="relative">
              <img 
                src="/images/Kevin_Circle.png" 
                alt="Kevin Bouwman" 
                class="w-36 h-36 sm:w-44 sm:h-44 rounded-2xl object-cover border-2 border-teal-100 shadow-md"
                loading="lazy"
              />
            </div>

            <div>
              <h2 class="text-2xl font-bold font-heading text-midnight">Kevin Bouwman</h2>
              <p class="text-teal-brand font-semibold text-sm font-heading mt-0.5">
                Community Broadcast Accessibility Champion
              </p>
              <p class="text-xs text-slate-500 font-mono mt-1">Iowa, United States</p>
            </div>

            <ul class="text-xs font-medium text-slate-500 font-mono space-y-1 pt-1 text-left inline-block sm:block">
              <li>• Cable TV & Live Stream</li>
              <li>• Church Leadership</li>
            </ul>
          </div>

          <div class="lg:col-span-8 space-y-4 text-slate-700 text-sm sm:text-base leading-relaxed">
            <p>
              Kevin is a proud husband to his wife of 40 years and father of four adult children. He owns and operates a dairy farm equipment business his parents established in 1982, along with a manufacturing company he launched in 2016.
            </p>
            <p>
              Active in his local church community across multiple leadership responsibilities, Kevin began receiving urgent inquiries from homebound individuals regarding audio intelligibility on the church’s weekly cable television broadcasts. This prompted him to study audio and video engineering solutions for worship spaces, culminating in the deployment of real-time open captions across cable broadcasts, online livestreams, and sanctuary screens.
            </p>
            <p>
              When WebCaptioner was retired, Kevin adopted ZipCaptions. Recognizing the power of its free, open architecture and the commitment of its creators, he became an active patron and an invaluable member of the advisory board, ensuring our live broadcast tools meet the highest standards of reliability.
            </p>
          </div>
        </div>
      </article>

      <!-- Member 3: Tracey Green -->
      <article class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 sm:p-10 lg:p-12 transition-all hover:border-amethyst/40">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <div class="lg:col-span-4 flex flex-col items-center sm:items-start text-center sm:text-left space-y-4">
            <div class="relative">
              <img 
                src="/images/Tracey_Circle.png" 
                alt="Tracey Green" 
                class="w-36 h-36 sm:w-44 sm:h-44 rounded-2xl object-cover border-2 border-purple-100 shadow-md"
                loading="lazy"
              />
            </div>

            <div>
              <h2 class="text-2xl font-bold font-heading text-midnight">Tracey Green</h2>
              <p class="text-amethyst font-semibold text-sm font-heading mt-0.5">
                Accessibility Advisor & Certified Teacher of the Deaf
              </p>
              <p class="text-xs text-slate-500 font-mono mt-1">Montreal, Quebec, Canada</p>
            </div>

            <ul class="text-xs font-medium text-slate-500 font-mono space-y-1 pt-1 text-left inline-block sm:block">
              <li>• LSLS Cert AVed</li>
              <li>• M.A. Child Studies</li>
              <li>• Auditory-Verbal Specialist</li>
            </ul>
          </div>

          <div class="lg:col-span-8 space-y-4 text-slate-700 text-sm sm:text-base leading-relaxed">
            <p>
              Tracey is a certified Teacher of the Deaf (LSLS cert AVed) with extensive experience teaching children with hearing loss to listen, speak, and develop robust self-determination and academic competence in mainstream educational settings.
            </p>
            <p>
              Tracey holds a Master of Arts in Child Studies and Education and has taught in elementary classrooms. She is a Google for Education Certified Teacher and holds distinguished graduate certificates in Auditory-Verbal Studies and Educational Leadership.
            </p>
            <p>
              Based in Montreal, Tracey provides rigorous pedagogical counsel to Zip Solutions, ensuring that our classroom integrations, speech-to-text displays, and assistive tools adhere to evidence-based auditory and linguistic accessibility standards.
            </p>
          </div>
        </div>
      </article>

    </div>

    <!-- Join the Advisory Board / Inquiry CTA -->
    <section class="bg-midnight rounded-3xl p-8 sm:p-12 text-white border border-slate-800 shadow-xl text-center relative overflow-hidden">
      <div class="max-w-2xl mx-auto space-y-4">
        <span class="text-xs font-bold uppercase tracking-wider text-teal-brand font-heading block">
          Shape the Future
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold font-heading">
          Interested in Joining Our Advisory Board?
        </h2>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
          We welcome educators, assistive technology specialists, and individuals with lived experiences surrounding accessibility to contribute their perspectives to our product roadmaps.
        </p>
        <div class="pt-4 flex flex-wrap justify-center gap-4">
          <a 
            href="/contact-us" 
            class="px-8 py-3.5 rounded-xl font-heading font-bold text-sm text-midnight bg-white hover:bg-alabaster shadow-md transition-all"
          >
            Get in Touch With Us
          </a>
          <a 
            href="/about-us" 
            class="px-7 py-3.5 rounded-xl font-heading font-bold text-sm text-white border border-slate-700 hover:bg-slate-800 transition-all"
          >
            Learn About the Team
          </a>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>
