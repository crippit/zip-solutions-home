---
import BaseLayout from '../layouts/BaseLayout.astro';

const pressReleaseSchema = [
  {
    "@type": "CollectionPage",
    "@id": "https://zipsolutions.org/pressrelease#webpage",
    "url": "https://zipsolutions.org/pressrelease",
    "name": "Official Press Releases | Zip Solutions",
    "description": "Official press announcements and media statements from Zip Solutions and Zip Captions.",
    "isPartOf": {
      "@id": "https://zipsolutions.org/#website"
    },
    "hasPart": [
      {
        "@type": "NewsArticle",
        "headline": "Zip Solutions Launches Free Real-Time Translation in Zip Captions Powered by Chrome On-Device AI",
        "datePublished": "2026-10-21T09:00:00-04:00",
        "url": "https://zipsolutions.org/pressrelease#realtime-translation",
        "publisher": {
          "@id": "https://zipsolutions.org/#organization"
        },
        "inLanguage": "en",
        "video": {
          "@type": "VideoObject",
          "name": "Zip Captions Real-Time Translation Walkthrough",
          "description": "Demonstration of free real-time live caption translation inside Zip Captions powered by Google Chrome's On-Device AI.",
          "thumbnailUrl": "https://i.ytimg.com/vi/WVt2UjV5LFk/hqdefault.jpg",
          "uploadDate": "2026-10-21",
          "embedUrl": "https://www.youtube.com/embed/WVt2UjV5LFk",
          "contentUrl": "https://youtu.be/WVt2UjV5LFk"
        }
      },
      {
        "@type": "NewsArticle",
        "headline": "Zip Solutions Launches Picture-in-Picture Mode for Zip Captions, Bringing Floating Live Captions to Any Screen or Application",
        "datePublished": "2026-10-17T09:00:00-04:00",
        "url": "https://zipsolutions.org/pressrelease#picture-in-picture",
        "publisher": {
          "@id": "https://zipsolutions.org/#organization"
        },
        "inLanguage": "en"
      },
      {
        "@type": "NewsArticle",
        "headline": "Zip Captions Revolutionizes Accessibility with AI-Powered Live Captions",
        "datePublished": "2025-02-01T09:00:00-05:00",
        "url": "https://zipsolutions.org/pressrelease#ai-captions",
        "publisher": {
          "@id": "https://zipsolutions.org/#organization"
        },
        "inLanguage": "en"
      }
    ]
  }
];
---

<BaseLayout 
  title="Press Releases | Zip Solutions" 
  description="Official press announcements and media statements from Zip Solutions and Zip Captions."
  schema={pressReleaseSchema}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-white via-alabaster to-slate-100 border-b border-slate-200/80 pt-16 pb-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <!-- Top Navigation Tabs (Zero Pills) -->
      <div class="inline-flex p-1 bg-slate-200/70 rounded-xl mb-8">
        <a 
          href="/press" 
          class="px-5 py-2 rounded-lg text-xs font-bold font-heading text-slate-600 hover:text-midnight transition-colors"
        >
          Awards and News Coverage
        </a>
        <a 
          href="/pressrelease" 
          class="px-5 py-2 rounded-lg text-xs font-bold font-heading bg-white text-midnight shadow-sm"
        >
          Official Press Releases
        </a>
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-midnight font-heading tracking-tight leading-tight">
        Official Press Releases
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Direct announcements, product milestones, and media resources from the Zip Solutions team.
      </p>
    </div>
  </section>

  <!-- Main Press Release Documents Container -->
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20 space-y-16">

    <!-- Release Quick Jump / Archive Index -->
    <div class="bg-white rounded-2xl border border-slate-200/80 p-4 sm:p-5 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-center gap-2.5">
        <span class="w-2.5 h-2.5 rounded-full bg-teal-brand animate-pulse"></span>
        <span class="text-xs font-bold uppercase tracking-wider text-slate-600 font-mono">Press Release Archive</span>
      </div>
      <div class="flex flex-wrap items-center gap-2 sm:gap-3 text-xs font-bold font-heading">
        <a 
          href="#realtime-translation" 
          class="px-3.5 py-1.5 rounded-lg bg-teal-50 text-teal-800 hover:bg-teal-100 border border-teal-200/60 transition-all flex items-center gap-1.5"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-teal-600"></span>
          <span>Latest: Real-Time Translation (Oct 2026)</span>
        </a>
        <a 
          href="#picture-in-picture" 
          class="px-3.5 py-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200 border border-slate-200/70 transition-all flex items-center gap-1.5"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
          <span>Picture-in-Picture Mode (Oct 2026)</span>
        </a>
        <a 
          href="#ai-captions" 
          class="px-3.5 py-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200 border border-slate-200/70 transition-all flex items-center gap-1.5"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
          <span>AI-Powered Live Captions (Feb 2025)</span>
        </a>
      </div>
    </div>

    <!-- PRESS RELEASE 1 (LATEST): REAL-TIME TRANSLATION -->
    <article id="realtime-translation" class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden scroll-mt-24">
      <!-- Release Top Metadata Bar -->
      <div class="bg-slate-50 border-b border-slate-200 px-6 sm:px-10 py-4 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-2">
          <span class="text-coral text-xs font-bold font-mono tracking-wider uppercase">
            For Immediate Release
          </span>
          <span class="text-slate-400">•</span>
          <span class="text-xs text-slate-500 font-medium">
            Montreal, Quebec • October 2026
          </span>
        </div>

        <a 
          href="/files/Press Release - Real-Time Translation.pdf" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-midnight hover:bg-slate-800 text-white text-xs font-bold font-heading shadow-sm transition-all"
        >
          <svg class="w-4 h-4 text-teal-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>Download Official PDF</span>
        </a>
      </div>

      <!-- Release Document Body -->
      <div class="p-6 sm:p-10 lg:p-14 space-y-8">
        <div>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-midnight font-heading tracking-tight leading-tight mb-4">
            Zip Solutions Launches Free Real-Time Translation in Zip Captions Powered by Chrome On-Device AI
          </h2>
          <p class="text-lg sm:text-xl font-medium text-amethyst">
            New update eliminates paywalls and cloud privacy concerns for classrooms, live events, and everyday accessibility.
          </p>
        </div>

        <hr class="border-slate-100" />

        <div class="prose prose-slate max-w-none text-slate-700 text-base sm:text-lg leading-relaxed space-y-6">
          <p>
            <strong class="text-midnight uppercase tracking-wide text-sm font-heading">Montreal, QC (October 2026) -</strong> 
            Zip Solutions today announced the launch of real-time live caption translation inside Zip Captions, its browser-based live captioning platform. By leveraging Google Chrome's built-in On-Device AI models, Zip Captions now allows users to translate live captions into multiple languages instantaneously at zero cost.
          </p>

          <p>
            While real-time translation has long been one of the most requested accessibility features in education and live production, high cloud-computing costs have historically forced software providers to lock translation behind expensive enterprise subscriptions. Zip Captions bypasses this barrier by running the translation models locally within the user's Chrome browser.
          </p>

          <blockquote class="border-l-4 border-amethyst pl-6 py-4 italic text-slate-800 font-medium bg-purple-50/40 rounded-r-2xl my-6 space-y-3">
            <p class="text-base sm:text-lg leading-relaxed">
              "True accessibility means removing both communication barriers and financial barriers," said Chris Webb, CEO and Co-Founder of Zip Solutions. "By harnessing Chrome's On-Device AI, we can give teachers, students, and organizations unlimited real-time translation without charging them a dime, while keeping their data private and right on their own device."
            </p>
            <div class="flex items-center gap-3 not-italic pt-1">
              <img 
                src="/images/Chris_Circle.png" 
                alt="Chris Webb" 
                class="w-10 h-10 rounded-full object-cover border border-purple-200"
                loading="lazy"
              />
              <div>
                <div class="font-bold font-heading text-sm text-midnight">Chris Webb</div>
                <div class="text-xs text-slate-500 font-medium">CEO and Co-Founder, Zip Solutions</div>
              </div>
            </div>
          </blockquote>

          <blockquote class="border-l-4 border-teal-brand pl-6 py-4 italic text-slate-800 font-medium bg-teal-50/40 rounded-r-2xl my-6 space-y-3">
            <p class="text-base sm:text-lg leading-relaxed">
              "We're building equity for our community, not for shareholders," said James Petersen, CTO and Co-Founder of Zip Solutions.
            </p>
            <div class="flex items-center gap-3 not-italic pt-1">
              <img 
                src="/images/James_Circle.png" 
                alt="James Petersen" 
                class="w-10 h-10 rounded-full object-cover border border-teal-200"
                loading="lazy"
              />
              <div>
                <div class="font-bold font-heading text-sm text-midnight">James Petersen</div>
                <div class="text-xs text-slate-500 font-medium">CTO and Co-Founder, Zip Solutions</div>
              </div>
            </div>
          </blockquote>

          <h3 class="text-xl sm:text-2xl font-bold font-heading text-midnight pt-4">
            Key Highlights of the Zip Captions Translation Update
          </h3>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 not-prose">
            <div class="p-5 sm:p-6 rounded-2xl bg-alabaster border border-slate-200">
              <span class="text-xs font-bold uppercase tracking-wider text-teal-brand font-heading block mb-1">
                Zero Cost Barrier
              </span>
              <h4 class="font-bold text-midnight text-base font-heading mb-1.5">100% Free Access</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
                No subscription tiers, credit cards, or monthly minute limits. Real-time translation is immediately available to all users on the free tier.
              </p>
            </div>

            <div class="p-5 sm:p-6 rounded-2xl bg-alabaster border border-slate-200">
              <span class="text-xs font-bold uppercase tracking-wider text-amethyst font-heading block mb-1">
                Chrome Built-In AI
              </span>
              <h4 class="font-bold text-midnight text-base font-heading mb-1.5">Local On-Device Processing</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
                Powered by Chrome's native AI capabilities, ensuring ultra-low latency and high data privacy for sensitive educational and professional environments.
              </p>
            </div>

            <div class="p-5 sm:p-6 rounded-2xl bg-alabaster border border-slate-200">
              <span class="text-xs font-bold uppercase tracking-wider text-teal-brand font-heading block mb-1">
                One-Click Setup
              </span>
              <h4 class="font-bold text-midnight text-base font-heading mb-1.5">Seamless Browser Experience</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
                Works directly inside Google Chrome with a one-click language download for immediate use, requiring no external software installers or IT permissions.
              </p>
            </div>

            <div class="p-5 sm:p-6 rounded-2xl bg-alabaster border border-slate-200">
              <span class="text-xs font-bold uppercase tracking-wider text-amethyst font-heading block mb-1">
                Multilingual Inclusion
              </span>
              <h4 class="font-bold text-midnight text-base font-heading mb-1.5">Classroom & Event Ready</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
                Supports multilingual classrooms, language learners, community venues, and live events alongside both standard browser speech recognition and optional Azure AI captioning.
              </p>
            </div>
          </div>

          <p class="pt-4">
            The real-time translation feature is rolling out now and is immediately available to all Zip Captions users worldwide. To experience live translated captions or learn more, visit <a href="https://zipcaptions.app" target="_blank" rel="noopener noreferrer" class="font-bold text-teal-brand hover:underline">zipcaptions.app</a> or explore the organization's full suite of accessibility tools at <a href="/" class="font-bold text-teal-brand hover:underline">zipsolutions.org</a>.
          </p>

          <!-- Press Kit & Multimedia Assets Section -->
          <div class="mt-8 pt-8 border-t border-slate-200/80 not-prose space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-amethyst font-mono block mb-1">
                  Official Press Kit & Multimedia
                </span>
                <h3 class="text-xl sm:text-2xl font-bold font-heading text-midnight">
                  Video Walkthrough, Animated GIF & Media Bundle
                </h3>
                <p class="text-slate-600 text-xs sm:text-sm mt-1">
                  Journalists, bloggers, and educators are invited to embed the walkthrough video or download the animated GIF, logos, and executive headshots for editorial coverage.
                </p>
              </div>

              <a 
                href="/files/Zip Captions - Real-Time Translation Press Kit.zip" 
                download
                class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-amethyst hover:bg-amethyst-dark text-white text-xs font-bold font-heading shadow-sm transition-all shrink-0 self-start sm:self-auto"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                <span>Download Complete Press Kit (.ZIP)</span>
              </a>
            </div>

            <!-- Video & GIF Side-by-Side Showcase -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
              <!-- YouTube Video Card -->
              <div class="rounded-2xl border border-slate-200 bg-alabaster overflow-hidden flex flex-col justify-between shadow-xs">
                <div class="aspect-video w-full bg-slate-900">
                  <iframe 
                    class="w-full h-full"
                    src="https://www.youtube.com/embed/WVt2UjV5LFk" 
                    title="Zip Captions Real-Time Translation Walkthrough Video" 
                    frameborder="0" 
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                    referrerpolicy="strict-origin-when-cross-origin" 
                    allowfullscreen
                    loading="lazy"
                  ></iframe>
                </div>
                <div class="p-4 flex items-center justify-between gap-3 bg-white border-t border-slate-200/80">
                  <div>
                    <div class="text-xs font-bold font-heading text-midnight">Feature Walkthrough Video</div>
                    <div class="text-[11px] text-slate-500">YouTube Embed • Ready for editorial articles</div>
                  </div>
                  <a 
                    href="https://youtu.be/WVt2UjV5LFk?si=3MVOGbTe-pmf2PL8" 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-midnight text-xs font-bold font-heading transition-colors shrink-0"
                  >
                    <span>Watch on YouTube</span>
                    <svg class="w-3.5 h-3.5 text-coral" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                </div>
              </div>

              <!-- Animated GIF Card -->
              <div class="rounded-2xl border border-slate-200 bg-alabaster overflow-hidden flex flex-col justify-between shadow-xs">
                <div class="aspect-video w-full bg-slate-900 flex items-center justify-center overflow-hidden">
                  <img 
                    src="/images/Translate Feature.gif" 
                    alt="Animated demonstration of real-time live caption translation inside Zip Captions" 
                    class="w-full h-full object-contain"
                    loading="lazy"
                  />
                </div>
                <div class="p-4 flex items-center justify-between gap-3 bg-white border-t border-slate-200/80">
                  <div>
                    <div class="text-xs font-bold font-heading text-midnight">Real-Time Translation Demo (GIF)</div>
                    <div class="text-[11px] text-slate-500">High-resolution animated loop • 700 KB</div>
                  </div>
                  <a 
                    href="/images/Translate Feature.gif" 
                    download="Zip-Captions-Translate-Feature.gif"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-teal-50 hover:bg-teal-100 text-teal-800 border border-teal-200/60 text-xs font-bold font-heading transition-colors shrink-0"
                  >
                    <svg class="w-3.5 h-3.5 text-teal-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                    </svg>
                    <span>Download GIF</span>
                  </a>
                </div>
              </div>
            </div>

            <!-- Quick Individual Asset Downloads Bar -->
            <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 flex flex-wrap items-center justify-between gap-3 text-xs">
              <span class="font-bold font-heading text-midnight">Included in Press Kit:</span>
              <div class="flex flex-wrap items-center gap-2">
                <a href="/files/Press Release - Real-Time Translation.pdf" target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 hover:border-teal-brand text-slate-700 font-medium transition-colors">
                  Press Release (PDF)
                </a>
                <a href="/images/Translate Feature.gif" download="Zip-Captions-Translate-Feature.gif" class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 hover:border-teal-brand text-slate-700 font-medium transition-colors">
                  Translate Feature (GIF)
                </a>
                <a href="/images/zipsolutions_logo.svg" download class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 hover:border-teal-brand text-slate-700 font-medium transition-colors">
                  Zip Solutions Logo (SVG)
                </a>
                <a href="/images/zip_logo_blue_trans.png" download class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 hover:border-teal-brand text-slate-700 font-medium transition-colors">
                  Zip Captions Logo (PNG)
                </a>
                <a href="/images/Webb_Chris.jpg" download class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 hover:border-teal-brand text-slate-700 font-medium transition-colors">
                  Chris Webb Headshot (JPG)
                </a>
                <a href="/images/Petersen_James.jpg" download class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 hover:border-teal-brand text-slate-700 font-medium transition-colors">
                  James Petersen Headshot (JPG)
                </a>
              </div>
            </div>
          </div>

          <!-- About Zip Solutions Callout -->
          <div class="mt-8 pt-6 border-t border-slate-200/80 not-prose">
            <h4 class="text-base font-bold font-heading text-midnight mb-2">About Zip Solutions</h4>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
              Based near Montreal, Quebec, Zip Solutions ("The Home of Accessibility") creates intuitive, accessible, and privacy-focused web applications and browser extensions designed to empower educators, students, and communicators worldwide. Guided by an advisory board of certified educators of the deaf and community advocates, Zip Solutions develops open, barrier-free tools including <a href="/zipcaptions" class="text-teal-brand font-semibold hover:underline">Zip Captions</a>, <a href="/easyspeak" class="text-teal-brand font-semibold hover:underline">Easy Speak AAC</a>, <a href="/equibrowse" class="text-teal-brand font-semibold hover:underline">EquiBrowse</a>, <a href="/zipmath" class="text-teal-brand font-semibold hover:underline">Zip Solutions Remediator</a>, and broadcast integration bridges (<a href="/zipvmix" class="text-teal-brand font-semibold hover:underline">Zip Captions for vMix</a> and <a href="/zipcaptionscompanion" class="text-teal-brand font-semibold hover:underline">Stream Deck Companion</a>) for schools, workplaces, houses of worship, and live events.
            </p>
          </div>

          <!-- Media Contact Details -->
          <div class="mt-6 pt-4 border-t border-slate-100 text-xs text-slate-600 not-prose flex flex-wrap gap-x-6 gap-y-2">
            <div><strong class="text-midnight font-sans">Media Relations:</strong> Zip Solutions</div>
            <div><strong class="text-midnight font-sans">Email:</strong> <a href="mailto:media@zipcaptions.app" class="text-teal-brand hover:underline">media@zipcaptions.app</a></div>
            <div><strong class="text-midnight font-sans">Website:</strong> <a href="https://www.zipsolutions.org" class="text-teal-brand hover:underline">https://www.zipsolutions.org</a></div>
            <div><strong class="text-midnight font-sans">App Portal:</strong> <a href="https://zipcaptions.app" target="_blank" rel="noopener noreferrer" class="text-teal-brand hover:underline">https://zipcaptions.app</a></div>
          </div>
        </div>

        <!-- Document Bottom Download Bar -->
        <div class="pt-8 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="text-xs text-slate-500">
            Official Document ID: <code class="font-mono bg-slate-100 px-2 py-1 rounded text-slate-700">PR-2026-10-TRANSLATION</code>
          </div>

          <div class="flex flex-wrap items-center gap-3">
            <a 
              href="/files/Zip Captions - Real-Time Translation Press Kit.zip" 
              download
              class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-slate-100 hover:bg-slate-200 text-midnight text-sm font-bold font-heading transition-all"
            >
              <svg class="w-4 h-4 text-amethyst" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              <span>Download Press Kit (.ZIP)</span>
            </a>

            <a 
              href="/files/Press Release - Real-Time Translation.pdf" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-teal-brand hover:bg-teal-700 text-white text-sm font-bold font-heading shadow-sm transition-all"
            >
              <span>View Full Press Release (PDF)</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </article>

    <!-- PRESS RELEASE 2: PICTURE-IN-PICTURE MODE -->
    <article id="picture-in-picture" class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden scroll-mt-24">
      <!-- Release Top Metadata Bar -->
      <div class="bg-slate-50 border-b border-slate-200 px-6 sm:px-10 py-4 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-2">
          <span class="text-coral text-xs font-bold font-mono tracking-wider uppercase">
            For Immediate Release
          </span>
          <span class="text-slate-400">•</span>
          <span class="text-xs text-slate-500 font-medium">
            Montreal, Quebec • October 2026
