---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Press Releases | Zip Solutions" 
  description="Official press announcements and media statements from Zip Solutions and Zip Captions."
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-white via-alabaster to-slate-100 border-b border-slate-200/80 pt-16 pb-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <!-- Top Navigation Tabs (Zero Pills) -->
      <div class="inline-flex p-1 bg-slate-200/70 rounded-xl mb-8">
        <a 
          href="/press" 
          class="px-5 py-2 rounded-lg text-xs font-bold font-heading text-slate-600 hover:text-midnight transition-colors"
        >
          Featured News Coverage
        </a>
        <a 
          href="/pressrelease" 
          class="px-5 py-2 rounded-lg text-xs font-bold font-heading bg-white text-midnight shadow-sm"
        >
          Official Press Releases
        </a>
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-midnight font-heading tracking-tight leading-tight">
        Official Press Releases
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Direct announcements, product milestones, and media resources from the Zip Solutions team.
      </p>
    </div>
  </section>

  <!-- Main Press Release Document -->
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20 space-y-16">

    <!-- Press Release Article Card -->
    <article class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
      <!-- Release Top Metadata Bar -->
      <div class="bg-slate-50 border-b border-slate-200 px-6 sm:px-10 py-4 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-2">
          <span class="text-coral text-xs font-bold font-mono tracking-wider uppercase">
            For Immediate Release
          </span>
          <span class="text-slate-400">•</span>
          <span class="text-xs text-slate-500 font-medium">
            Montreal, Quebec • February 2025
          </span>
        </div>

        <a 
          href="/files/Press Release - AI Captions.pdf" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-midnight hover:bg-slate-800 text-white text-xs font-bold font-heading shadow-sm transition-all"
        >
          <svg class="w-4 h-4 text-teal-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>Download Official PDF</span>
        </a>
      </div>

      <!-- Release Document Body -->
      <div class="p-6 sm:p-10 lg:p-14 space-y-8">
        <div>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-midnight font-heading tracking-tight leading-tight mb-4">
            Zip Captions Revolutionizes Accessibility with AI-Powered Live Captions
          </h2>
          <p class="text-lg sm:text-xl font-medium text-amethyst">
            AI captions complement our existing totally free live captioning solutions.
          </p>
        </div>

        <hr class="border-slate-100" />

        <div class="prose prose-slate max-w-none text-slate-700 text-base sm:text-lg leading-relaxed space-y-6">
          <p>
            <strong class="text-midnight uppercase tracking-wide text-sm font-heading">Montreal, Quebec —</strong> 
            Zip Captions, a leading free live captioning solution, today announced the launch of its new AI-powered captioning feature, powered by Microsoft Azure. This significant upgrade will provide Patreon supporters with significantly more accurate live captions, resulting in a more seamless and comprehensible experience for individuals with hearing loss, ADHD, Auditory Processing disorders, ANSD, and more.
          </p>

          <p>
            The newly introduced AI engine processes speech through state-of-the-art acoustic and linguistic models, delivering extraordinary precision in challenging acoustic environments, noisy conference halls, and fast-paced academic lectures.
          </p>

          <blockquote class="border-l-4 border-amethyst pl-6 py-2 italic text-slate-800 font-medium bg-slate-50/60 rounded-r-2xl my-6">
            "Our primary mission has always been universal, dignified access to the spoken word. By introducing state-of-the-art AI captioning while keeping our foundation 100% free and open, we are opening up next-generation comprehension tools to classrooms, houses of worship, and live events without creating financial barriers."
          </blockquote>

          <h3 class="text-xl font-bold font-heading text-midnight pt-4">
            Key Highlights of the Release:
          </h3>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 not-prose">
            <div class="p-5 rounded-2xl bg-alabaster border border-slate-200">
              <span class="text-xs font-bold uppercase tracking-wider text-teal-brand font-heading block mb-1">
                Advanced Intelligence
              </span>
              <h4 class="font-bold text-midnight text-base font-heading mb-1">Azure AI Cognitive Speech</h4>
              <p class="text-slate-600 text-xs sm:text-sm">
                Industry-leading speech models provide deep contextual accuracy for specialized terminology, accents, and complex phrasing.
              </p>
            </div>

            <div class="p-5 rounded-2xl bg-alabaster border border-slate-200">
              <span class="text-xs font-bold uppercase tracking-wider text-amethyst font-heading block mb-1">
                Core Accessibility
              </span>
              <h4 class="font-bold text-midnight text-base font-heading mb-1">Free Tier Preserved</h4>
              <p class="text-slate-600 text-xs sm:text-sm">
                The browser-based on-device speech engine remains 100% free forever for all users with unlimited session durations.
              </p>
            </div>

            <div class="p-5 rounded-2xl bg-alabaster border border-slate-200">
              <span class="text-xs font-bold uppercase tracking-wider text-teal-brand font-heading block mb-1">
                Broad Hardware Support
              </span>
              <h4 class="font-bold text-midnight text-base font-heading mb-1">Cross-Platform Web Engine</h4>
              <p class="text-slate-600 text-xs sm:text-sm">
                Instant execution across Chromebooks, Windows, macOS, iPadOS, iOS, Android, and Linux with zero software installers.
              </p>
            </div>

            <div class="p-5 rounded-2xl bg-alabaster border border-slate-200">
              <span class="text-xs font-bold uppercase tracking-wider text-amethyst font-heading block mb-1">
                Professional Integration
              </span>
              <h4 class="font-bold text-midnight text-base font-heading mb-1">Broadcast & Stream Ready</h4>
              <p class="text-slate-600 text-xs sm:text-sm">
                Seamless compatibility with OBS Studio, vMix, Twitch, NDI feeds, and auditorium multi-display projection systems.
              </p>
            </div>
          </div>

          <p class="pt-4">
            The new AI captions are available immediately through the Zip Captions web portal for all active Patreon community patrons who support the continued open development of our assistive tools.
          </p>
        </div>

        <!-- Document Bottom Download Bar -->
        <div class="pt-8 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="text-xs text-slate-500">
            Official Document ID: <code class="font-mono bg-slate-100 px-2 py-1 rounded text-slate-700">PR-2025-02-AICAPTIONS</code>
          </div>

          <a 
            href="/files/Press Release - AI Captions.pdf" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-teal-brand hover:bg-teal-700 text-white text-sm font-bold font-heading shadow-sm transition-all"
          >
            <span>View Full Press Release (PDF)</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>
    </article>

    <!-- Media Kit & Press Inquiries -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Brand & Media Assets -->
      <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 sm:p-8 flex flex-col justify-between">
        <div class="space-y-3">
          <span class="text-xs font-bold font-mono text-slate-500 uppercase tracking-wider block">
            Brand Resources
          </span>
          <h3 class="text-xl font-bold font-heading text-midnight">
            Logos & Media Assets
          </h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Download official high-resolution vector logos, product screenshots, and executive headshots for use in editorial coverage and conference programs.
          </p>

          <div class="flex items-center gap-4 pt-2">
            <img 
              src="/images/zipsolutions_logo.png" 
              alt="Zip Solutions Logo" 
              class="h-10 w-auto object-contain p-1 border border-slate-200 rounded-lg bg-white"
            />
            <img 
              src="/images/zip_logo_blue_trans.png" 
              alt="Zip Captions Logo" 
              class="h-10 w-auto object-contain p-1 border border-slate-200 rounded-lg bg-slate-900"
            />
          </div>
        </div>

        <div class="pt-6 mt-6 border-t border-slate-100">
          <a 
            href="/contact-us" 
            class="inline-flex items-center gap-1.5 text-sm font-bold text-amethyst hover:text-amethyst-dark transition-colors"
          >
            <span>Request Media Kit Bundle</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Media Relations Contact -->
      <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 sm:p-8 flex flex-col justify-between">
        <div class="space-y-3">
          <span class="text-xs font-bold font-mono text-amethyst uppercase tracking-wider block">
            Direct Contact
          </span>
          <h3 class="text-xl font-bold font-heading text-midnight">
            Media Inquiries & Interviews
          </h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Our leadership and development team are available for technical interviews, commentary on digital accessibility standards, and broadcast event consultations.
          </p>
          <div class="space-y-1.5 text-xs text-slate-600 font-mono">
            <p><strong class="text-midnight font-sans">Location:</strong> Montreal, Quebec, Canada</p>
            <p><strong class="text-midnight font-sans">Turnaround:</strong> Within 24-48 business hours</p>
          </div>
        </div>

        <div class="pt-6 mt-6 border-t border-slate-100">
          <a 
            href="/contact-us" 
            class="inline-flex items-center gap-1.5 text-sm font-bold text-teal-brand hover:text-teal-700 transition-colors"
          >
            <span>Contact Media Relations</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>
