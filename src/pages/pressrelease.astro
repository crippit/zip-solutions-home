---
import BaseLayout from '../layouts/BaseLayout.astro';

const pressReleaseSchema = [
  {
    "@type": "CollectionPage",
    "@id": "https://zipsolutions.org/pressrelease#webpage",
    "url": "https://zipsolutions.org/pressrelease",
    "name": "Official Press Releases | Zip Solutions",
    "description": "Official press announcements and media statements from Zip Solutions and Zip Captions.",
    "isPartOf": {
      "@id": "https://zipsolutions.org/#website"
    },
    "hasPart": [
      {
        "@type": "NewsArticle",
        "headline": "Zip Solutions Launches Picture-in-Picture Mode for Zip Captions, Bringing Floating Live Captions to Any Screen or Application",
        "datePublished": "2026-10-17T09:00:00-04:00",
        "url": "https://zipsolutions.org/pressrelease#picture-in-picture",
        "publisher": {
          "@id": "https://zipsolutions.org/#organization"
        },
        "inLanguage": "en"
      },
      {
        "@type": "NewsArticle",
        "headline": "Zip Captions Revolutionizes Accessibility with AI-Powered Live Captions",
        "datePublished": "2025-02-01T09:00:00-05:00",
        "url": "https://zipsolutions.org/pressrelease#ai-captions",
        "publisher": {
          "@id": "https://zipsolutions.org/#organization"
        },
        "inLanguage": "en"
      }
    ]
  }
];
---

<BaseLayout 
  title="Press Releases | Zip Solutions" 
  description="Official press announcements and media statements from Zip Solutions and Zip Captions."
  schema={pressReleaseSchema}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-white via-alabaster to-slate-100 border-b border-slate-200/80 pt-16 pb-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <!-- Top Navigation Tabs (Zero Pills) -->
      <div class="inline-flex p-1 bg-slate-200/70 rounded-xl mb-8">
        <a 
          href="/press" 
          class="px-5 py-2 rounded-lg text-xs font-bold font-heading text-slate-600 hover:text-midnight transition-colors"
        >
          Featured News Coverage
        </a>
        <a 
          href="/pressrelease" 
          class="px-5 py-2 rounded-lg text-xs font-bold font-heading bg-white text-midnight shadow-sm"
        >
          Official Press Releases
        </a>
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-midnight font-heading tracking-tight leading-tight">
        Official Press Releases
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Direct announcements, product milestones, and media resources from the Zip Solutions team.
      </p>
    </div>
  </section>

  <!-- Main Press Release Documents Container -->
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20 space-y-16">

    <!-- Release Quick Jump / Archive Index -->
    <div class="bg-white rounded-2xl border border-slate-200/80 p-4 sm:p-5 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-center gap-2.5">
        <span class="w-2.5 h-2.5 rounded-full bg-teal-brand animate-pulse"></span>
        <span class="text-xs font-bold uppercase tracking-wider text-slate-600 font-mono">Press Release Archive</span>
      </div>
      <div class="flex flex-wrap items-center gap-2 sm:gap-3 text-xs font-bold font-heading">
        <a 
          href="#picture-in-picture" 
          class="px-3.5 py-1.5 rounded-lg bg-teal-50 text-teal-800 hover:bg-teal-100 border border-teal-200/60 transition-all flex items-center gap-1.5"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-teal-600"></span>
          <span>Latest: Picture-in-Picture Mode (Oct 2026)</span>
        </a>
        <a 
          href="#ai-captions" 
          class="px-3.5 py-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200 border border-slate-200/70 transition-all flex items-center gap-1.5"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
          <span>AI-Powered Live Captions (Feb 2025)</span>
        </a>
      </div>
    </div>

    <!-- PRESS RELEASE 1 (LATEST): PICTURE-IN-PICTURE MODE -->
    <article id="picture-in-picture" class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden scroll-mt-24">
      <!-- Release Top Metadata Bar -->
      <div class="bg-slate-50 border-b border-slate-200 px-6 sm:px-10 py-4 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-2">
          <span class="text-coral text-xs font-bold font-mono tracking-wider uppercase">
            For Immediate Release
          </span>
          <span class="text-slate-400">•</span>
          <span class="text-xs text-slate-500 font-medium">
            Montreal, Quebec • October 2026
          </span>
        </div>

        <a 
          href="/files/Press Release - Picture in Picture.pdf" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-midnight hover:bg-slate-800 text-white text-xs font-bold font-heading shadow-sm transition-all"
        >
          <svg class="w-4 h-4 text-teal-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>Download Official PDF</span>
        </a>
      </div>

      <!-- Release Document Body -->
      <div class="p-6 sm:p-10 lg:p-14 space-y-8">
        <div>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-midnight font-heading tracking-tight leading-tight mb-4">
            Zip Solutions Launches Picture-in-Picture Mode for Zip Captions, Bringing Floating Live Captions to Any Screen or Application
          </h2>
          <p class="text-lg sm:text-xl font-medium text-amethyst">
            The new browser-based feature eliminates "window juggling" for teachers, remote workers, and event organizers by allowing real-time captions to float seamlessly over presentations, documents, and full-screen software.
          </p>
        </div>

        <hr class="border-slate-100" />

        <div class="prose prose-slate max-w-none text-slate-700 text-base sm:text-lg leading-relaxed space-y-6">
          <p>
            <strong class="text-midnight uppercase tracking-wide text-sm font-heading">Montreal, QC —</strong> 
            Zip Solutions, the Quebec-based creator of accessible technology and communication tools, today announced the launch of Picture-in-Picture (PiP) mode for its flagship web application, Zip Captions. Available immediately and completely free of charge, the new feature allows users to pop live captions out of their web browser into a resizable, always-on-top floating window that stays visible over the top of the users desktop applications.
          </p>

          <p>
            For years, browser-based live captioning has come with a practical catch: the moment a user clicks into another program, opens a full-screen presentation, or starts taking notes in a separate window, the browser tab disappears, taking the captions with it. Users on a single laptop screen have historically been forced to awkwardly split their display in half or use multiple monitors just to read captions while working or teaching.
          </p>

          <p>
            With Zip Captions' new Picture-in-Picture feature, a single click detaches the live caption feed into an independent window that sits on top of the user's screen. Whether a user is presenting a PowerPoint deck, demonstrating software, editing a spreadsheet, or writing notes in a document, the captions remain pinned in view. Users can freely resize the box, move it to any corner of their display, and retain their personalized font and high-contrast visual settings.
          </p>

          <blockquote class="border-l-4 border-amethyst pl-6 py-4 italic text-slate-800 font-medium bg-purple-50/40 rounded-r-2xl my-6 space-y-3">
            <p class="text-base sm:text-lg leading-relaxed">
              "As a classroom teacher, I know firsthand that nobody teaches from a blank browser tab, you are constantly jumping between slide decks, PDFs, videos, and interactive tools. Until now, keeping live captions visible on a projector meant sacrificing screen space or dealing with complicated workarounds. Picture-in-Picture solves that immediately. You pop the captions out, place them where you want them, and just teach."
            </p>
            <div class="flex items-center gap-3 not-italic pt-1">
              <img 
                src="/images/Chris_Circle.png" 
                alt="Chris Webb" 
                class="w-10 h-10 rounded-full object-cover border border-purple-200"
                loading="lazy"
              />
              <div>
                <div class="font-bold font-heading text-sm text-midnight">Chris Webb</div>
                <div class="text-xs text-slate-500 font-medium">CEO and Co-Founder, Zip Solutions</div>
              </div>
            </div>
          </blockquote>

          <p>
            Because the feature is built directly into the Zip Captions web engine, it requires no software downloads, browser extensions, or IT administrator permissions. This is a critical advantage for locked-down school Chromebooks and corporate laptops.
          </p>

          <blockquote class="border-l-4 border-teal-brand pl-6 py-4 italic text-slate-800 font-medium bg-teal-50/40 rounded-r-2xl my-6 space-y-3">
            <p class="text-base sm:text-lg leading-relaxed">
              "Our goal with every update is to remove friction without compromising user privacy. By utilizing native browser Picture-in-Picture capabilities, we've given users a way to overlay captions across their entire operating system while keeping everything zero-install and locally processed in the browser."
            </p>
            <div class="flex items-center gap-3 not-italic pt-1">
              <img 
                src="/images/James_Circle.png" 
                alt="James Petersen" 
                class="w-10 h-10 rounded-full object-cover border border-teal-200"
                loading="lazy"
              />
              <div>
                <div class="font-bold font-heading text-sm text-midnight">James Petersen</div>
                <div class="text-xs text-slate-500 font-medium">CTO and Co-Founder, Zip Solutions</div>
              </div>
            </div>
          </blockquote>

          <h3 class="text-xl sm:text-2xl font-bold font-heading text-midnight pt-4">
            Transforming Accessibility Across Sectors
          </h3>
          <p class="text-slate-600 text-sm sm:text-base">
            The introduction of Picture-in-Picture opens up practical, everyday workflows across multiple environments:
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 not-prose">
            <div class="p-5 sm:p-6 rounded-2xl bg-alabaster border border-slate-200">
              <span class="text-xs font-bold uppercase tracking-wider text-teal-brand font-heading block mb-1">
                Classroom Workflows
              </span>
              <h4 class="font-bold text-midnight text-base font-heading mb-1.5">Classrooms & Lecture Halls</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
                Educators can display live captions directly on top of full-screen presentations, digital whiteboards, or coding environments without cutting off their visual materials. Students receiving broadcasted captions on their own devices can float the text right beside their digital notes.
              </p>
            </div>

            <div class="p-5 sm:p-6 rounded-2xl bg-alabaster border border-slate-200">
              <span class="text-xs font-bold uppercase tracking-wider text-amethyst font-heading block mb-1">
                Enterprise & Remote
              </span>
              <h4 class="font-bold text-midnight text-base font-heading mb-1.5">Workplaces & Remote Collaboration</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
                Employees who are d/Deaf, hard of hearing, or neurodivergent (such as those with ADHD or Auditory Processing Disorder) can follow live conversations while actively collaborating in shared documents, design tools, or data sheets on a single screen.
              </p>
            </div>

            <div class="p-5 sm:p-6 rounded-2xl bg-alabaster border border-slate-200">
              <span class="text-xs font-bold uppercase tracking-wider text-teal-brand font-heading block mb-1">
                Community AV
              </span>
              <h4 class="font-bold text-midnight text-base font-heading mb-1.5">Places of Worship & Community Venues</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
                Volunteer-run AV teams can easily drag a clean, readable caption bar over sermon slides, announcements, or video playback without needing specialized video switchers or complex broadcast software.
              </p>
            </div>

            <div class="p-5 sm:p-6 rounded-2xl bg-alabaster border border-slate-200">
              <span class="text-xs font-bold uppercase tracking-wider text-amethyst font-heading block mb-1">
                Live Presentations
              </span>
              <h4 class="font-bold text-midnight text-base font-heading mb-1.5">Conferences & Live Seminars</h4>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
                Presenters doing live software demonstrations can switch freely between applications on stage while the floating caption window remains anchored on the main auditorium display.
              </p>
            </div>
          </div>

          <p class="pt-4">
            True to Zip Solutions' core mission, the Picture-in-Picture update is available to all users on the free tier of Zip Captions, working seamlessly alongside both standard browser speech recognition and the platform's optional Azure AI-powered captioning engine. As with all Zip Captions sessions, audio is never recorded, and transcripts remain stored privately in the user's local browser memory.
          </p>

          <p>
            To try the new Picture-in-Picture feature or learn more about Zip Captions, visit <a href="https://zipcaptions.app" target="_blank" rel="noopener noreferrer" class="font-bold text-teal-brand hover:underline">zipcaptions.app</a> or explore the organization's full suite of accessibility tools at <a href="/" class="font-bold text-teal-brand hover:underline">zipsolutions.org</a>.
          </p>

          <!-- About Zip Solutions Callout -->
          <div class="mt-8 pt-6 border-t border-slate-200/80 not-prose">
            <h4 class="text-base font-bold font-heading text-midnight mb-2">About Zip Solutions</h4>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
              Based near Montreal, Quebec, Zip Solutions ("The Home of Accessibility") was founded by educators and software engineers dedicated to building private, intuitive, and dignified assistive technology. Guided by an advisory board of certified educators of the deaf and community advocates, Zip Solutions develops open, barrier-free tools including Zip Captions, Easy Speak AAC, and broadcast integration bridges for schools, workplaces, houses of worship, and live events worldwide.
            </p>
          </div>

          <!-- Media Contact Details -->
          <div class="mt-6 pt-4 border-t border-slate-100 text-xs text-slate-600 not-prose flex flex-wrap gap-x-6 gap-y-2">
            <div><strong class="text-midnight font-sans">Media Relations:</strong> Zip Solutions</div>
            <div><strong class="text-midnight font-sans">Email:</strong> <a href="mailto:media@zipcaptions.app" class="text-teal-brand hover:underline">media@zipcaptions.app</a></div>
            <div><strong class="text-midnight font-sans">Website:</strong> <a href="https://www.zipsolutions.org" class="text-teal-brand hover:underline">https://www.zipsolutions.org</a></div>
            <div><strong class="text-midnight font-sans">App Portal:</strong> <a href="https://zipcaptions.app" target="_blank" rel="noopener noreferrer" class="text-teal-brand hover:underline">https://zipcaptions.app</a></div>
          </div>
        </div>

        <!-- Document Bottom Download Bar -->
        <div class="pt-8 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="text-xs text-slate-500">
            Official Document ID: <code class="font-mono bg-slate-100 px-2 py-1 rounded text-slate-700">PR-2026-10-PIPMODE</code>
          </div>

          <a 
            href="/files/Press Release - Picture in Picture.pdf" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-teal-brand hover:bg-teal-700 text-white text-sm font-bold font-heading shadow-sm transition-all"
          >
            <span>View Full Press Release (PDF)</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>
    </article>

    <!-- PRESS RELEASE 2: AI-POWERED CAPTIONS -->
    <article id="ai-captions" class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden scroll-mt-24">
      <!-- Release Top Metadata Bar -->
      <div class="bg-slate-50 border-b border-slate-200 px-6 sm:px-10 py-4 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-2">
          <span class="text-coral text-xs font-bold font-mono tracking-wider uppercase">
            Official Announcement
          </span>
          <span class="text-slate-400">•</span>
          <span class="text-xs text-slate-500 font-medium">
            Montreal, Quebec • February 2025
          </span>
        </div>

        <a 
          href="/files/Press Release - AI Captions.pdf" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-midnight hover:bg-slate-800 text-white text-xs font-bold font-heading shadow-sm transition-all"
        >
          <svg class="w-4 h-4 text-teal-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>Download Official PDF</span>
        </a>
      </div>

      <!-- Release Document Body -->
      <div class="p-6 sm:p-10 lg:p-14 space-y-8">
        <div>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-midnight font-heading tracking-tight leading-tight mb-4">
            Zip Captions Revolutionizes Accessibility with AI-Powered Live Captions
          </h2>
          <p class="text-lg sm:text-xl font-medium text-amethyst">
            AI captions complement our existing totally free live captioning solutions.
          </p>
        </div>

        <hr class="border-slate-100" />

        <div class="prose prose-slate max-w-none text-slate-700 text-base sm:text-lg leading-relaxed space-y-6">
          <p>
            <strong class="text-midnight uppercase tracking-wide text-sm font-heading">Montreal, Quebec —</strong> 
            Zip Captions, a leading free live captioning solution, today announced the launch of its new AI-powered captioning feature, powered by Microsoft Azure. This significant upgrade will provide Patreon supporters with significantly more accurate live captions, resulting in a more seamless and comprehensible experience for individuals with hearing loss, ADHD, Auditory Processing disorders, ANSD, and more.
          </p>

          <p>
            The newly introduced AI engine processes speech through state-of-the-art acoustic and linguistic models, delivering extraordinary precision in challenging acoustic environments, noisy conference halls, and fast-paced academic lectures.
          </p>

          <blockquote class="border-l-4 border-amethyst pl-6 py-2 italic text-slate-800 font-medium bg-slate-50/60 rounded-r-2xl my-6">
            "Our primary mission has always been universal, dignified access to the spoken word. By introducing state-of-the-art AI captioning while keeping our foundation 100% free and open, we are opening up next-generation comprehension tools to classrooms, houses of worship, and live events without creating financial barriers."
          </blockquote>

          <h3 class="text-xl font-bold font-heading text-midnight pt-4">
            Key Highlights of the Release:
          </h3>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 not-prose">
            <div class="p-5 rounded-2xl bg-alabaster border border-slate-200">
              <span class="text-xs font-bold uppercase tracking-wider text-teal-brand font-heading block mb-1">
                Advanced Intelligence
              </span>
              <h4 class="font-bold text-midnight text-base font-heading mb-1">Azure AI Cognitive Speech</h4>
              <p class="text-slate-600 text-xs sm:text-sm">
                Industry-leading speech models provide deep contextual accuracy for specialized terminology, accents, and complex phrasing.
              </p>
            </div>

            <div class="p-5 rounded-2xl bg-alabaster border border-slate-200">
              <span class="text-xs font-bold uppercase tracking-wider text-amethyst font-heading block mb-1">
                Core Accessibility
              </span>
              <h4 class="font-bold text-midnight text-base font-heading mb-1">Free Tier Preserved</h4>
              <p class="text-slate-600 text-xs sm:text-sm">
                The browser-based on-device speech engine remains 100% free forever for all users with unlimited session durations.
              </p>
            </div>

            <div class="p-5 rounded-2xl bg-alabaster border border-slate-200">
              <span class="text-xs font-bold uppercase tracking-wider text-teal-brand font-heading block mb-1">
                Broad Hardware Support
              </span>
              <h4 class="font-bold text-midnight text-base font-heading mb-1">Cross-Platform Web Engine</h4>
              <p class="text-slate-600 text-xs sm:text-sm">
                Instant execution across Chromebooks, Windows, macOS, iPadOS, iOS, Android, and Linux with zero software installers.
              </p>
            </div>

            <div class="p-5 rounded-2xl bg-alabaster border border-slate-200">
              <span class="text-xs font-bold uppercase tracking-wider text-amethyst font-heading block mb-1">
                Professional Integration
              </span>
              <h4 class="font-bold text-midnight text-base font-heading mb-1">Broadcast & Stream Ready</h4>
              <p class="text-slate-600 text-xs sm:text-sm">
                Seamless compatibility with OBS Studio, vMix, Twitch, NDI feeds, and auditorium multi-display projection systems.
              </p>
            </div>
          </div>

          <p class="pt-4">
            The new AI captions are available immediately through the Zip Captions web portal for all active Patreon community patrons who support the continued open development of our assistive tools.
          </p>
        </div>

        <!-- Document Bottom Download Bar -->
        <div class="pt-8 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="text-xs text-slate-500">
            Official Document ID: <code class="font-mono bg-slate-100 px-2 py-1 rounded text-slate-700">PR-2025-02-AICAPTIONS</code>
          </div>

          <a 
            href="/files/Press Release - AI Captions.pdf" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-teal-brand hover:bg-teal-700 text-white text-sm font-bold font-heading shadow-sm transition-all"
          >
            <span>View Full Press Release (PDF)</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>
    </article>

    <!-- Media Kit & Press Inquiries -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Brand & Media Assets -->
      <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 sm:p-8 flex flex-col justify-between">
        <div class="space-y-3">
          <span class="text-xs font-bold font-mono text-slate-500 uppercase tracking-wider block">
            Brand Resources
          </span>
          <h3 class="text-xl font-bold font-heading text-midnight">
            Logos & Media Assets
          </h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Download official high-resolution vector logos, product screenshots, and executive headshots for use in editorial coverage and conference programs.
          </p>

          <div class="flex items-center gap-4 pt-2">
            <img 
              src="/images/zipsolutions_logo.svg" 
              alt="Zip Solutions Logo" 
              class="h-10 w-auto object-contain p-1 border border-slate-200 rounded-lg bg-white"
            />
            <img 
              src="/images/zip_logo_blue_trans.png" 
              alt="Zip Captions Logo" 
              class="h-10 w-auto object-contain p-1 border border-slate-200 rounded-lg bg-slate-900"
            />
          </div>
        </div>

        <div class="pt-6 mt-6 border-t border-slate-100">
          <a 
            href="/contact-us" 
            class="inline-flex items-center gap-1.5 text-sm font-bold text-amethyst hover:text-amethyst-dark transition-colors"
          >
            <span>Request Media Kit Bundle</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Media Relations Contact -->
      <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 sm:p-8 flex flex-col justify-between">
        <div class="space-y-3">
          <span class="text-xs font-bold font-mono text-amethyst uppercase tracking-wider block">
            Direct Contact
          </span>
