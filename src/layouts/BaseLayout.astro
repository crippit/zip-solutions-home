---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

import { getEquivalentUrl, useTranslations } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  schema?: any;
  canonicalPath?: string;
  noindex?: boolean;
  hasFrTranslation?: boolean;
}

const currentLocale = (Astro.currentLocale || (Astro.url.pathname.startsWith('/fr') ? 'fr' : 'en')) as 'en' | 'fr';
const t = useTranslations(currentLocale);

const { 
  title = currentLocale === 'fr' ? "Zip Solutions | La maison de l'accessibilité" : 'Zip Solutions | The Home of Accessibility', 
  description = currentLocale === 'fr' 
    ? "La maison de l'accessibilité : sous-titrage en direct gratuit sur navigateur, outils de CAA hors ligne, organisation d'événements hybrides et technologies éducatives inclusives."
    : 'The Home of Accessibility — Empowering connection with free browser-based live captioning, offline AI AAC tools, hybrid event production, and accessible learning.',
  image = '/images/og-share-card.jpg',
  imageAlt = currentLocale === 'fr'
    ? "Zip Solutions — La maison de l'accessibilité, sous-titrage en direct et outils de CAA"
    : 'Zip Solutions — The Home of Accessibility, live captions and AAC tools',
  schema,
  canonicalPath,
  noindex = false,
  hasFrTranslation = true,
} = Astro.props;

const siteTitle = (title.includes('Zip Solutions') || title.includes('Solutions Zip'))
  ? title
  : `${title} | Zip Solutions`;

const siteOrigin = (Astro.site ? Astro.site.toString() : 'https://zipsolutions.org').replace(/\/$/, '');
const cleanPathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const effectiveCanonicalPath = (canonicalPath || cleanPathname).replace(/\/$/, '') || '/';

const canonicalURL = effectiveCanonicalPath === '/' ? `${siteOrigin}/` : `${siteOrigin}${effectiveCanonicalPath}`;
const imageUrl = new URL(image, `${siteOrigin}/`).toString();

const enEquivPath = getEquivalentUrl(effectiveCanonicalPath, 'en');
const frEquivPath = getEquivalentUrl(effectiveCanonicalPath, 'fr');
const canonicalEn = enEquivPath === '/' ? `${siteOrigin}/` : `${siteOrigin}${enEquivPath}`;
const canonicalFr = `${siteOrigin}${frEquivPath}`;

const keywordsContent = currentLocale === 'fr'
  ? "sous-titrage en direct, sous-titres gratuits navigateur, CAA, communication améliorée et alternative, accessibilité, technologie d'assistance, sous-titres vMix, sous-titres OBS, synthèse vocale, événements hybrides, surtitrage théâtre, éducation inclusive"
  : "free live captions, browser live captioning, speech to text, AAC app, augmentative alternative communication, assistive technology, vMix live captions, OBS closed captions, Twitch captions, classroom captioning, church live captions, theatre surtitles, hybrid event production";

const baseOrgNode: Record<string, any> = {
  "@type": ["Organization", "EducationalOrganization"],
  "@id": "https://zipsolutions.org/#organization",
  "name": "Zip Solutions",
  "alternateName": "Solutions Zip",
  "url": "https://zipsolutions.org",
  "logo": {
    "@type": "ImageObject",
    "url": "https://zipsolutions.org/images/zipsolutions_logo.png"
  },
  "foundingDate": "2023",
  "address": {
    "@type": "PostalAddress",
    "addressRegion": "QC",
    "addressCountry": "CA"
  },
  "description": currentLocale === 'fr'
    ? "La maison de l'accessibilité : sous-titrage en direct, outils de CAA, organisation d'événements hybrides et formation professionnelle personnalisée."
    : "The Home of Accessibility — Empowering connection with live captioning, AAC tools, in-person event organisation, hybrid session production, and custom professional development.",
  "award": [
    "University of Portsmouth 2025 Alumni Impact Award Winner",
    "Virginia Society for Technology in Education (VSTE) Accessibility Demo Slam Winner"
  ],
  "funder": [
    {
      "@type": "Organization",
      "name": "Dell Technologies Education Canada Innovation Accelerator"
    },
    {
      "@type": "Organization",
      "name": "Microsoft for Startups Founders Hub"
    }
  ],
  "sameAs": [
    "https://zipcaptions.app",
    "https://bsky.app/profile/zipcaptions.app",
    "https://github.com/crippit",
    "https://patreon.com/zipcaptions"
  ]
};

const baseWebsiteNode: Record<string, any> = {
  "@type": "WebSite",
  "@id": "https://zipsolutions.org/#website",
  "url": "https://zipsolutions.org",
  "name": "Zip Solutions",
  "inLanguage": currentLocale === 'fr' ? "fr-CA" : "en-US",
  "publisher": {
    "@id": "https://zipsolutions.org/#organization"
  }
};

const extraGraphItems: any[] = [];
if (schema) {
  const incoming = Array.isArray(schema) ? schema : [schema];
  for (const item of incoming) {
    if (!item) continue;
    if (item["@id"] === "https://zipsolutions.org/#organization") {
      Object.assign(baseOrgNode, item, { "@type": baseOrgNode["@type"] });
    } else if (item["@id"] === "https://zipsolutions.org/#website") {
      Object.assign(baseWebsiteNode, item);
    } else {
      extraGraphItems.push(item);
    }
  }
}

const isHomePage = cleanPathname === '/' || cleanPathname === '/fr';
if (!isHomePage) {
  extraGraphItems.push({
    "@type": "BreadcrumbList",
    "@id": `${canonicalURL}#breadcrumb`,
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": currentLocale === 'fr' ? "Accueil" : "Home",
        "item": currentLocale === 'fr' ? `${siteOrigin}/fr` : `${siteOrigin}/`
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": title.replace(/\s*\|\s*(Zip Solutions|Solutions Zip).*$/, ''),
        "item": canonicalURL
      }
    ]
  });
}

const schemaOrgJson = {
  "@context": "https://schema.org",
  "@graph": [baseOrgNode, baseWebsiteNode, ...extraGraphItems]
};
---

<!doctype html>
<html lang={currentLocale} class="h-full scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical & Alternate Hreflang URLs -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={canonicalEn} />
    {hasFrTranslation && <link rel="alternate" hreflang="fr" href={canonicalFr} />}
    <link rel="alternate" hreflang="x-default" href={canonicalEn} />

    <!-- Primary Meta Tags -->
    <title>{siteTitle}</title>
    <meta name="title" content={siteTitle} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0F172A" />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
    <meta name="author" content="Zip Solutions" />
    <meta name="keywords" content={keywordsContent} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="669" />
    <meta property="og:image:type" content={imageUrl.endsWith('.png') ? 'image/png' : 'image/jpeg'} />
    <meta property="og:site_name" content="Zip Solutions" />
    <meta property="og:locale" content={currentLocale === 'fr' ? 'fr_CA' : 'en_US'} />
    {hasFrTranslation && (
      <meta property="og:locale:alternate" content={currentLocale === 'fr' ? 'en_US' : 'fr_CA'} />
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrgJson)} />

    <!-- Slot for additional head tags if needed -->
    <slot name="head" />
  </head>
  <body class="min-h-full flex flex-col bg-alabaster text-midnight font-sans antialiased selection:bg-amethyst/20 selection:text-midnight">
    
    <!-- Accessibility Skip Link -->
    <a 
      href="#main-content" 
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2.5 focus:bg-amethyst focus:text-white focus:font-semibold focus:rounded-xl focus:shadow-xl focus:outline-none"
    >
      {t('skipToContent')}
    </a>

    <Header />

    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    <Footer />
  </body>
</html>
