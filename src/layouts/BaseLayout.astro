    "https://patreon.com/zipcaptions"
  ]
};

const baseWebsiteNode: Record<string, any> = {
  "@type": "WebSite",
  "@id": "https://zipsolutions.org/#website",
  "url": "https://zipsolutions.org",
  "name": "Zip Solutions",
  "inLanguage": currentLocale === 'fr' ? "fr-CA" : "en-US",
  "publisher": {
    "@id": "https://zipsolutions.org/#organization"
  }
};

const extraGraphItems: any[] = [];
if (schema) {
  const incoming = Array.isArray(schema) ? schema : [schema];
  for (const item of incoming) {
    if (!item) continue;
    if (item["@id"] === "https://zipsolutions.org/#organization") {
      Object.assign(baseOrgNode, item, { "@type": baseOrgNode["@type"] });
    } else if (item["@id"] === "https://zipsolutions.org/#website") {
      Object.assign(baseWebsiteNode, item);
    } else {
      extraGraphItems.push(item);
    }
  }
}

if (faqs && faqs.length > 0) {
  extraGraphItems.push({
    "@type": "FAQPage",
    "@id": `${canonicalURL}#faq`,
    "mainEntity": faqs.map((faq) => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }))
  });
}

const isHomePage = cleanPathname === '/' || cleanPathname === '/fr';
if (!isHomePage) {
  extraGraphItems.push({
    "@type": "BreadcrumbList",
    "@id": `${canonicalURL}#breadcrumb`,
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": currentLocale === 'fr' ? "Accueil" : "Home",
        "item": currentLocale === 'fr' ? `${siteOrigin}/fr` : `${siteOrigin}/`
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": title.replace(/\s*\|\s*(Zip Solutions|Solutions Zip).*$/, ''),
        "item": canonicalURL
      }
    ]
  });
}

const schemaOrgJson = {
  "@context": "https://schema.org",
  "@graph": [baseOrgNode, baseWebsiteNode, ...extraGraphItems]
};
---

<!doctype html>
<html lang={currentLocale} class="h-full scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical & Alternate Hreflang URLs -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={canonicalEn} />
    {hasFrTranslation && <link rel="alternate" hreflang="fr" href={canonicalFr} />}
    <link rel="alternate" hreflang="x-default" href={canonicalEn} />

    <!-- Primary Meta Tags -->
    <title>{siteTitle}</title>
    <meta name="title" content={siteTitle} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0F172A" />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
    <meta name="author" content="Zip Solutions" />
    <meta name="keywords" content={keywordsContent} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="669" />
    <meta property="og:image:type" content={imageUrl.endsWith('.png') ? 'image/png' : 'image/jpeg'} />
    <meta property="og:site_name" content="Zip Solutions" />
    <meta property="og:locale" content={currentLocale === 'fr' ? 'fr_CA' : 'en_US'} />
    {hasFrTranslation && (
      <meta property="og:locale:alternate" content={currentLocale === 'fr' ? 'en_US' : 'fr_CA'} />
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrgJson)} />

    <!-- Slot for additional head tags if needed -->
    <slot name="head" />
  </head>
  <body class="min-h-full flex flex-col bg-alabaster text-midnight font-sans antialiased selection:bg-amethyst/20 selection:text-midnight">
    
    <!-- Accessibility Skip Link -->
    <a 
      href="#main-content" 
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2.5 focus:bg-amethyst focus:text-white focus:font-semibold focus:rounded-xl focus:shadow-xl focus:outline-none"
    >
      {t('skipToContent')}
    </a>

    <Header />

    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    <Footer />

    <script is:inline>
      // Scroll-Driven Section Fade-In / Fade-Out & Parallax Controller
      (function () {
        var stageEls = Array.prototype.slice.call(document.querySelectorAll('.scroll-section-stage'));
        var heroEls = Array.prototype.slice.call(document.querySelectorAll('.parallax-hero-bg'));
        var slowEls = Array.prototype.slice.call(document.querySelectorAll('.parallax-slow'));
        var counterEls = Array.prototype.slice.call(document.querySelectorAll('.parallax-counter'));
        if (!stageEls.length && !heroEls.length && !slowEls.length && !counterEls.length) return;

        function clamp(val, min, max) {
          return Math.min(max, Math.max(min, val));
        }

        function easeOutCubic(t) {
          return 1 - Math.pow(1 - t, 3);
        }

        var ticking = false;
        function updateScrollParallax() {
          ticking = false;
          var vh = window.innerHeight || 800;
          var scrollY = window.scrollY || window.pageYOffset || 0;

          // 1. Section Fade-In / Fade-Out + Vertical Parallax
          for (var s = 0; s < stageEls.length; s++) {
            var stage = stageEls[s];
            var isHeroStage = stage.hasAttribute('data-hero-stage');
            var rect = stage.getBoundingClientRect();

            // Entry progress: 0 when top of section is at bottom of viewport (vh),
            // reaching 1.0 once its top enters 62% of viewport height (38% up from bottom)
            var enterZone = vh * 0.38;
            var distFromBottom = vh - rect.top;
            var enterProgress = isHeroStage ? 1 : clamp(distFromBottom / enterZone, 0, 1);

            // Exit progress:
            // - For full-viewport Hero stage: begins fading out smoothly as soon as the user scrolls past 24px
            // - For content stages: begins fading when bottom of section enters the top 42% of viewport toward the 80px header
            var exitProgress;
            if (isHeroStage) {
              exitProgress = 1 - clamp((scrollY - 24) / (vh * 0.65), 0, 1);
            } else {
              var exitStart = vh * 0.42;
              var exitEnd = 80;
              exitProgress = clamp((rect.bottom - exitEnd) / (exitStart - exitEnd), 0, 1);
            }

            // If at the very bottom of the page, keep the final section solid so the user can read it
            var docHeight = document.documentElement.scrollHeight || document.body.scrollHeight;
            var nearPageBottom = (scrollY + vh) >= (docHeight - 40);
            if (nearPageBottom && s === stageEls.length - 1) {
              enterProgress = 1;
              exitProgress = 1;
            }

            var enterEased = easeOutCubic(enterProgress);
            var exitEased = easeOutCubic(exitProgress);

            var opacity = Math.min(enterEased, exitEased);
            // Minimum floor of 0.04 so layout never pops harshly
            var finalOpacity = 0.04 + opacity * 0.96;

            // Parallax Y offset: rises +52px -> 0px on entry, and drifts 0px -> -48px on exit
            var enterY = (1 - enterEased) * 52;
            var exitY = (1 - exitEased) * (isHeroStage ? -56 : -44);
            var translateY = enterY + exitY;

            // Subtle depth scale: 0.96 -> 1.0 -> 0.96
            var scale = 0.96 + 0.04 * opacity;

            stage.style.opacity = finalOpacity.toFixed(3);
            stage.style.transform = 'translate3d(0,' + translateY.toFixed(1) + 'px,0) scale(' + scale.toFixed(4) + ')';
          }

          // 2. Hero background lattice drift
          for (var i = 0; i < heroEls.length; i++) {
            var p = clamp(scrollY / (vh * 0.95), 0, 1);
            var y = -18 + p * 96;
            heroEls[i].style.transform = 'translate3d(0,' + y.toFixed(1) + 'px,0)';
          }

          // 3. Background lattice & ambient glow counter-drift
          for (var j = 0; j < slowEls.length; j++) {
            var el = slowEls[j];
            var parent = el.parentElement || el;
            var prect = parent.getBoundingClientRect();
            if (prect.bottom < -120 || prect.top > vh + 120) continue;
            var progress = clamp((vh - prect.top) / (vh + prect.height), 0, 1);
            var shift = -56 + progress * 112;
            el.style.transform = 'translate3d(0,' + shift.toFixed(1) + 'px,0)';
          }

          // 4. Foreground product preview image counter-parallax
          for (var k = 0; k < counterEls.length; k++) {
            var cel = counterEls[k];
            var crect = cel.getBoundingClientRect();
            if (crect.bottom < -120 || crect.top > vh + 120) continue;
            var cprog = clamp((vh - crect.top) / (vh + crect.height), 0, 1);
            var cshift = 34 - cprog * 68;
            cel.style.transform = 'translate3d(0,' + cshift.toFixed(1) + 'px,0)';
          }
        }

        window.addEventListener('scroll', function () {
          if (!ticking) {
            ticking = true;
            window.requestAnimationFrame(updateScrollParallax);
          }
        }, { passive: true });
        window.addEventListener('resize', updateScrollParallax, { passive: true });
        updateScrollParallax();
      })();
    </script>
  </body>
</html>
