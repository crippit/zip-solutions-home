---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  heroBadge?: string;
  date?: string;
}

const { title, description, heroBadge, date } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <!-- Header Banner -->
  <section class="bg-gradient-to-b from-white to-slate-50 border-b border-slate-200/80 pt-12 pb-14 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-midnight font-heading">
        {title}
      </h1>
      {description && (
        <p class="mt-4 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
          {description}
        </p>
      )}
      {date && (
        <p class="mt-3 text-xs sm:text-sm text-slate-500 font-mono">
          Last updated: {date}
        </p>
      )}
    </div>
  </section>

  <!-- Page Content -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <article class="bg-white rounded-3xl p-6 sm:p-10 lg:p-12 border border-slate-200/80 shadow-sm prose-custom">
      <slot />
    </article>
  </div>
</BaseLayout>
