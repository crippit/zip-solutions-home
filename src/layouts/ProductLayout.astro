---
import BaseLayout from './BaseLayout.astro';

interface ActionButton {
  text: string;
  url: string;
  primary?: boolean;
  external?: boolean;
}

interface Capability {
  title: string;
  description: string;
  icon?: string;
}

interface SpecItem {
  label: string;
  value: string;
}

interface Props {
  title: string;
  subtitle: string;
  description: string;
  actions?: ActionButton[];
  heroImage?: string;
  heroImageAlt?: string;
  capabilities?: Capability[];
  specs?: SpecItem[];
  specsTitle?: string;
  specsSubtitle?: string;
  ctaTitle?: string;
  ctaDescription?: string;
  ctaAction?: ActionButton;
}

const {
  title,
  subtitle,
  description,
  actions = [],
  heroImage,
  heroImageAlt = title,
  capabilities = [],
  specs = [],
  specsTitle = "Good to know before you start",
  specsSubtitle = "At a Glance",
  ctaTitle = "Ready to get started?",
  ctaDescription = "Join thousands of users making communication more accessible today.",
  ctaAction,
} = Astro.props;

const softwareSchema = {
  "@type": "SoftwareApplication",
  "name": title,
  "description": description,
  "applicationCategory": "EducationalApplication, UtilitiesApplication",
  "operatingSystem": "All (Web, Windows, macOS, Linux, ChromeOS, iOS, Android)",
  "url": `https://zipsolutions.org${Astro.url.pathname}`,
  "offers": {
    "@type": "Offer",
    "price": "0.00",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock"
  }
};
---

<BaseLayout title={title} description={description} image={heroImage} schema={softwareSchema}>
  
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-12 sm:pt-16 pb-16 sm:pb-20 bg-gradient-to-b from-white via-slate-50 to-alabaster border-b border-slate-200/80">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      
      <!-- Typography Hierarchy (No pills) -->
      <p class="text-sm sm:text-base font-bold text-amethyst tracking-wide uppercase mb-3 font-heading">
        {subtitle}
      </p>

      <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-midnight font-heading leading-tight">
        {title}
      </h1>

      <p class="mt-5 text-base sm:text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed">
        {description}
      </p>

      <!-- Primary & Secondary Action Buttons -->
      {actions.length > 0 && (
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3.5">
          {actions.map((act) => (
            <a
              href={act.url}
              target={act.external ? "_blank" : undefined}
              rel={act.external ? "noopener noreferrer" : undefined}
              class={`inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl font-heading font-bold text-sm sm:text-base transition-all duration-200 ${
                act.primary
                  ? 'bg-amethyst hover:bg-amethyst-dark text-white shadow-md hover:shadow-lg'
                  : 'bg-white hover:bg-slate-100 text-midnight border border-slate-200 shadow-sm'
              }`}
            >
              <span>{act.text}</span>
              {act.external && (
                <svg class="w-4 h-4 text-current opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              )}
            </a>
          ))}
        </div>
      )}

      <!-- Hero Media Showcase -->
      {heroImage && (
        <div class="mt-12 sm:mt-14 max-w-4xl mx-auto">
          <div class="p-2 sm:p-3 bg-white rounded-3xl border border-slate-200 shadow-xl overflow-hidden">
            <img 
              src={heroImage} 
              alt={heroImageAlt} 
              class="w-full h-auto rounded-2xl object-cover" 
            />
          </div>
        </div>
      )}

    </div>
  </section>

  <!-- Key Capabilities Grid -->
  {capabilities.length > 0 && (
    <section class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <h2 class="text-2xl sm:text-3xl font-extrabold font-heading text-midnight">
          Key Capabilities
        </h2>
        <p class="mt-3 text-slate-600 text-base">
          Engineered for effortless accessibility, reliability, and speed.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {capabilities.map((cap) => (
          <div class="bg-white rounded-3xl p-7 border border-slate-200/80 shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
            <div>
              <div class="w-12 h-12 rounded-2xl bg-purple-50 text-amethyst flex items-center justify-center mb-5">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <h3 class="text-lg font-bold font-heading text-midnight mb-2">
                {cap.title}
              </h3>
              <p class="text-sm text-slate-600 leading-relaxed">
                {cap.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Custom Page Slot Content (Demos, Step-by-Step, Video Players, Tools) -->
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 sm:pb-24">
    <slot />
  </div>

  <!-- Quick Details & Practical Info Section -->
  {specs.length > 0 && (
    <section class="py-16 bg-slate-50 border-t border-slate-200/80">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-xl mx-auto mb-10">
          <p class="text-xs sm:text-sm font-bold text-amethyst tracking-wide uppercase mb-2 font-heading">
            {specsSubtitle}
          </p>
          <h2 class="text-2xl sm:text-3xl font-extrabold font-heading text-midnight">
            {specsTitle}
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          {specs.map((spec) => (
            <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:border-slate-300 transition-colors flex flex-col gap-2">
              <span class="text-xs font-bold uppercase tracking-wider text-teal-brand font-heading">
                {spec.label}
              </span>
              <p class="text-sm sm:text-base font-medium text-slate-800 leading-relaxed">
                {spec.value}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Bottom CTA Banner -->
  <section class="py-16 bg-midnight text-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <h2 class="text-2xl sm:text-4xl font-extrabold font-heading text-white">
        {ctaTitle}
      </h2>
      <p class="text-slate-400 text-base sm:text-lg max-w-2xl mx-auto">
        {ctaDescription}
      </p>
      <div class="flex flex-wrap justify-center gap-4 pt-2">
        {ctaAction ? (
          <a 
            href={ctaAction.url}
            target={ctaAction.external ? "_blank" : undefined}
            rel={ctaAction.external ? "noopener noreferrer" : undefined}
            class="px-8 py-4 rounded-2xl font-heading font-bold text-sm sm:text-base text-midnight bg-white hover:bg-alabaster shadow-lg transition-all"
          >
            {ctaAction.text}
          </a>
        ) : (
          <a 
            href="/contact-us"
            class="px-8 py-4 rounded-2xl font-heading font-bold text-sm sm:text-base text-midnight bg-white hover:bg-alabaster shadow-lg transition-all"
          >
            Get In Touch
          </a>
        )}
      </div>
    </div>
  </section>

</BaseLayout>
