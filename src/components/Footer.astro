---
import { getEquivalentUrl, useTranslations } from '../i18n/ui';

const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, '') || '/';
const currentLocale = (Astro.currentLocale || (currentPath.startsWith('/fr') ? 'fr' : 'en')) as 'en' | 'fr';
const t = useTranslations(currentLocale);
const isFr = currentLocale === 'fr';

const homeUrl = isFr ? '/fr' : '/';
const targetLang = isFr ? 'en' : 'fr';
const switchLangUrl = getEquivalentUrl(currentPath, targetLang);
const switchLangText = isFr ? 'English' : 'Français';
const switchLangShort = isFr ? 'EN' : 'FR';

function l(path: string): string {
  if (path.startsWith('http')) return path;
  if (!isFr) return path;
  if (path === '/') return '/fr';
  return `/fr${path}`;
}

const currentYear = new Date().getFullYear();
---

<footer class="bg-midnight text-slate-300 pt-16 pb-12 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 lg:gap-8 pb-12 border-b border-slate-800">
      
      <!-- Brand & Mission Column -->
      <div class="lg:col-span-2 space-y-4">
        <a href={homeUrl} class="flex items-center gap-3" aria-label={isFr ? "Zip Solutions - Accueil" : "Zip Solutions - Home"}>
          <img 
            src="/images/zipsolutions_logo.svg" 
            alt="Zip Solutions" 
            loading="lazy"
            class="h-8 w-auto bg-white/90 rounded-lg p-1.5 object-contain"
            width="150"
            height="34"
          />
        </a>
        <p class="text-slate-400 text-sm leading-relaxed max-w-sm">
          {t('footer.mission')}
        </p>
        <div class="pt-2 flex items-center gap-2 text-xs font-medium text-slate-400">
          <span class="text-sm select-none" aria-hidden="true">🍁</span>
          <span>{t('footer.madeIn')} <span class="text-coral">❤️</span> {t('footer.nearMontreal')}</span>
        </div>
      </div>

      <!-- Quick Links: Products -->
      <div>
        <h3 class="text-white font-heading font-bold text-sm tracking-wider uppercase mb-4">
          {isFr ? "Produits et outils" : "Products & Tools"}
        </h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href={l('/products')} class="text-slate-400 hover:text-white transition-colors">
              {isFr ? "Tous les outils et services" : "All Tools & Services"}
            </a>
          </li>
          <li>
            <a href={l('/zipcaptions')} class="text-slate-400 hover:text-white transition-colors">
              Zip Captions
            </a>
          </li>
          <li>
            <a href={l('/easyspeak')} class="text-slate-400 hover:text-white transition-colors">
              {isFr ? "EasySpeak CAA" : "EasySpeak AAC"}
            </a>
          </li>
          <li>
            <a href={l('/zipmath')} class="text-slate-400 hover:text-white transition-colors">
              Zip Math Remediator
            </a>
          </li>
          <li>
            <a href={l('/equibrowse')} class="text-slate-400 hover:text-white transition-colors">
              EquiBrowse
            </a>
          </li>
          <li>
            <a href={l('/zipspeech')} class="text-slate-400 hover:text-white transition-colors">
              {isFr ? "Zip Speech (Google Meet)" : "Zip Speech for Meet"}
            </a>
          </li>
          <li>
            <a href={l('/zippanel')} class="text-slate-400 hover:text-white transition-colors">
              {isFr ? "Extension Zip Panel" : "Zip Panel Extension"}
            </a>
          </li>
          <li>
            <a href={l('/zipconnect')} class="text-slate-400 hover:text-white transition-colors">
              {isFr ? "Zip Connect (Twitch)" : "Zip Connect for Twitch"}
            </a>
          </li>
          <li>
            <a href={l('/zipvmix')} class="text-slate-400 hover:text-white transition-colors">
              {isFr ? "Passerelle vMix en direct" : "vMix Live Bridge"}
            </a>
          </li>
          <li>
            <a href={l('/zipcaptionscompanion')} class="text-slate-400 hover:text-white transition-colors">
              {isFr ? "Companion Stream Deck" : "Stream Deck Companion"}
            </a>
          </li>
        </ul>
      </div>

      <!-- Quick Links: Organization & Events -->
      <div>
        <h3 class="text-white font-heading font-bold text-sm tracking-wider uppercase mb-4">
          {isFr ? "Organisation et services" : "Organization & Events"}
        </h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href={l('/events')} class="text-slate-400 hover:text-white transition-colors">
              {isFr ? "Organisation d'événements hybrides" : "Hybrid Event Production"}
            </a>
          </li>
          <li>
            <a href={l('/live-event-quotes')} class="text-slate-400 hover:text-white transition-colors">
              {isFr ? "Devis événements en direct" : "Live Event Captions Quotes"}
            </a>
          </li>
          <li>
            <a href={l('/story')} class="text-slate-400 hover:text-white transition-colors">
              {isFr ? "Notre histoire" : "Our Story"}
            </a>
          </li>
          <li>
            <a href={l('/about-us')} class="text-slate-400 hover:text-white transition-colors">
              {isFr ? "Notre équipe" : "Our Team"}
            </a>
          </li>
          <li>
