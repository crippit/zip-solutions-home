<script>
  // Self-contained ISO/IEC 18004 QR Code SVG generator (Versions 1-8, Byte mode, ECC Level L)
  function buildQrSvg(text: string): string {
    const data = new TextEncoder().encode(text);
    const V_TABLE: Array<[number, number, number, number] | null> = [
      null,
      [1, 26, 7, 1],
      [2, 44, 10, 1],
      [3, 70, 15, 1],
      [4, 100, 20, 1],
      [5, 134, 26, 1],
      [6, 172, 18, 2],
      [7, 196, 20, 2],
      [8, 242, 24, 2]
    ];
    let ver = 2;
    for (let v = 1; v <= 8; v++) {
      const entry = V_TABLE[v]!;
      const dataCap = entry[1] - entry[2] * entry[3] - 2;
      if (data.length <= dataCap) {
        ver = v;
        break;
      }
      if (v === 8) ver = 8;
    }
    const [, totalCw, ecCw, numBlocks] = V_TABLE[ver]!;
    const dataCwCount = totalCw - ecCw * numBlocks;

    const bits: number[] = [];
    const pushBits = (val: number, len: number) => {
      for (let i = len - 1; i >= 0; i--) bits.push((val >> i) & 1);
    };
    pushBits(0b0100, 4);
    const clipped = data.slice(0, dataCwCount - 2);
    pushBits(clipped.length, 8);
    for (const b of clipped) pushBits(b, 8);
    const maxBits = dataCwCount * 8;
    for (let i = 0; i < 4 && bits.length < maxBits; i++) bits.push(0);
    while (bits.length % 8 !== 0) bits.push(0);
    const padBytes = [0xec, 0x11];
    let padIdx = 0;
    while (bits.length < maxBits) {
      pushBits(padBytes[padIdx % 2], 8);
      padIdx++;
    }

    const codewords: number[] = [];
    for (let i = 0; i < bits.length; i += 8) {
      let b = 0;
      for (let j = 0; j < 8; j++) b = (b << 1) | bits[i + j];
      codewords.push(b);
    }

    const exp = new Uint8Array(512);
    const log = new Uint8Array(256);
    let x = 1;
    for (let i = 0; i < 255; i++) {
      exp[i] = x;
      log[x] = i;
      x <<= 1;
      if (x & 0x100) x ^= 0x11d;
    }
    for (let i = 255; i < 512; i++) exp[i] = exp[i - 255];
    const gfMul = (a: number, b: number) => (a === 0 || b === 0 ? 0 : exp[log[a] + log[b]]);

    const polyMul = (p: Uint8Array, q: Uint8Array) => {
      const res = new Uint8Array(p.length + q.length - 1);
      for (let i = 0; i < p.length; i++) {
        for (let j = 0; j < q.length; j++) {
          res[i + j] ^= gfMul(p[i], q[j]);
        }
      }
      return res;
    };
    let gen: Uint8Array = new Uint8Array([1]);
    for (let i = 0; i < ecCw; i++) {
      gen = polyMul(gen, new Uint8Array([1, exp[i]]));
    }
    const rsEncode = (msg: number[]) => {
      const rem = new Uint8Array(msg.length + ecCw);
      rem.set(msg);
      for (let i = 0; i < msg.length; i++) {
        const coef = rem[i];
        if (coef !== 0) {
          for (let j = 1; j < gen.length; j++) {
            rem[i + j] ^= gfMul(gen[j], coef);
          }
        }
      }
      return rem.slice(msg.length);
    };

    const dataBlocks: number[][] = [];
    const ecBlocks: Uint8Array[] = [];
    const blockSize = Math.floor(dataCwCount / numBlocks);
    let offset = 0;
    for (let b = 0; b < numBlocks; b++) {
      const blk = codewords.slice(offset, offset + blockSize);
      offset += blockSize;
      dataBlocks.push(blk);
      ecBlocks.push(rsEncode(blk));
    }

    const finalBytes: number[] = [];
    for (let i = 0; i < blockSize; i++) {
      for (let b = 0; b < numBlocks; b++) finalBytes.push(dataBlocks[b][i]);
    }
    for (let i = 0; i < ecCw; i++) {
      for (let b = 0; b < numBlocks; b++) finalBytes.push(ecBlocks[b][i]);
    }

    const size = ver * 4 + 17;
    const grid = Array.from({ length: size }, () => new Int8Array(size).fill(-1));
    const reserved = Array.from({ length: size }, () => new Uint8Array(size));

    const setFinder = (r: number, c: number) => {
      for (let dr = -1; dr <= 7; dr++) {
        for (let dc = -1; dc <= 7; dc++) {
          const rr = r + dr;
          const cc = c + dc;
          if (rr < 0 || rr >= size || cc < 0 || cc >= size) continue;
          const inOuter = (dr >= 0 && dr <= 6 && (dc === 0 || dc === 6)) || (dc >= 0 && dc <= 6 && (dr === 0 || dr === 6));
          const inInner = dr >= 2 && dr <= 4 && dc >= 2 && dc <= 4;
          grid[rr][cc] = inOuter || inInner ? 1 : 0;
          reserved[rr][cc] = 1;
        }
      }
    };
    setFinder(0, 0);
    setFinder(0, size - 7);
    setFinder(size - 7, 0);

    const alignMap: Record<number, number[]> = {
      1: [],
      2: [6, 18],
      3: [6, 22],
      4: [6, 26],
      5: [6, 30],
      6: [6, 34],
      7: [6, 22, 38],
      8: [6, 24, 42]
    };
    const alignPos = alignMap[ver] || [];
    for (const ar of alignPos) {
      for (const ac of alignPos) {
        if (reserved[ar][ac]) continue;
        for (let dr = -2; dr <= 2; dr++) {
          for (let dc = -2; dc <= 2; dc++) {
            grid[ar + dr][ac + dc] = Math.max(Math.abs(dr), Math.abs(dc)) !== 1 ? 1 : 0;
            reserved[ar + dr][ac + dc] = 1;
          }
        }
      }
    }

    for (let i = 8; i < size - 8; i++) {
      if (!reserved[6][i]) {
        grid[6][i] = i % 2 === 0 ? 1 : 0;
        reserved[6][i] = 1;
      }
      if (!reserved[i][6]) {
        grid[i][6] = i % 2 === 0 ? 1 : 0;
        reserved[i][6] = 1;
      }
    }

    for (let i = 0; i < 9; i++) {
      reserved[8][i] = 1;
      reserved[i][8] = 1;
    }
    for (let i = 0; i < 8; i++) {
      reserved[8][size - 1 - i] = 1;
      reserved[size - 1 - i][8] = 1;
    }
    grid[size - 8][8] = 1;
    reserved[size - 8][8] = 1;

    if (ver >= 7) {
      const verInfo = ver === 7 ? 0x07c94 : 0x085bc;
      for (let i = 0; i < 18; i++) {
        const bit = (verInfo >> i) & 1;
        const r = Math.floor(i / 3);
        const c = size - 11 + (i % 3);
        grid[r][c] = bit;
        reserved[r][c] = 1;
        grid[c][r] = bit;
        reserved[c][r] = 1;
      }
    }

    const allBits: number[] = [];
    for (const b of finalBytes) {
      for (let i = 7; i >= 0; i--) allBits.push((b >> i) & 1);
    }
    let bitIdx = 0;
    let upward = true;
    for (let right = size - 1; right >= 1; right -= 2) {
      if (right === 6) right = 5;
      for (let vert = 0; vert < size; vert++) {
        const r = upward ? size - 1 - vert : vert;
        for (let j = 0; j < 2; j++) {
          const c = right - j;
          if (!reserved[r][c]) {
            const bit = bitIdx < allBits.length ? allBits[bitIdx++] : 0;
            const mask = (r + c) % 2 === 0 ? 1 : 0;
            grid[r][c] = bit ^ mask;
          }
        }
      }
      upward = !upward;
    }

    const fmt = 0x77c4;
    const fmtCoords1 = [
      [8, 0], [8, 1], [8, 2], [8, 3], [8, 4], [8, 5], [8, 7], [8, 8],
      [7, 8], [5, 8], [4, 8], [3, 8], [2, 8], [1, 8], [0, 8]
    ];
    const fmtCoords2 = [
      [size - 1, 8], [size - 2, 8], [size - 3, 8], [size - 4, 8], [size - 5, 8], [size - 6, 8], [size - 7, 8],
      [8, size - 8], [8, size - 7], [8, size - 6], [8, size - 5], [8, size - 4], [8, size - 3], [8, size - 2], [8, size - 1]
    ];
    for (let i = 0; i < 15; i++) {
      const bit = (fmt >> i) & 1;
      grid[fmtCoords1[i][0]][fmtCoords1[i][1]] = bit;
      grid[fmtCoords2[i][0]][fmtCoords2[i][1]] = bit;
    }

    let rects = '';
    for (let r = 0; r < size; r++) {
      for (let c = 0; c < size; c++) {
        if (grid[r][c] === 1) {
          rects += `<rect x="${c}" y="${r}" width="1" height="1" fill="#0F172A"/>`;
        }
      }
    }
    return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${size} ${size}" width="112" height="112" role="img" aria-label="Custom QR Code for ${text}">${rects}</svg>`;
  }

  const qrContainer = document.getElementById('preview-qr-svg-container');
  const qrTargetLabel = document.getElementById('preview-qr-target-label');
  const previewStreamUrl = document.getElementById('preview-stream-url');
  const resolvedStreamHint = document.getElementById('resolved-stream-url-hint');

  const templateSelect = document.getElementById('sign-template-select') as HTMLSelectElement | null;
  const orgInput = document.getElementById('sign-org-input') as HTMLInputElement | null;
  const codeInput = document.getElementById('sign-code-input') as HTMLInputElement | null;
  const printBtn = document.getElementById('print-custom-sign-btn');

  const previewOrg = document.getElementById('preview-org-name');
  const previewHeadline = document.getElementById('preview-headline');
  const previewSubtitle = document.getElementById('preview-subtitle');
  const previewCode = document.getElementById('preview-room-code');
  const previewSteps = document.getElementById('preview-steps-list');

  function parseBroadcastInput(rawInput: string): { displayCode: string; targetUrl: string } {
    const trimmed = rawInput.trim();
    if (!trimmed) {
      return {
        displayCode: '____________________',
        targetUrl: 'https://zipcaptions.app'
      };
    }
    const streamMatch = trimmed.match(/zipcaptions\.app\/stream\/([^\s/?#]+)/i);
    if (streamMatch && streamMatch[1]) {
      const code = streamMatch[1];
      return {
        displayCode: code,
        targetUrl: `https://zipcaptions.app/stream/${code}`
      };
    }
    if (/^https?:\/\//i.test(trimmed)) {
      const segments = trimmed.replace(/\/+$/, '').split('/');
      const lastSeg = segments[segments.length - 1] || trimmed;
      return {
        displayCode: lastSeg,
        targetUrl: trimmed
      };
    }
    const cleanCode = trimmed.replace(/^\/?(stream\/)?/i, '');
    return {
      displayCode: cleanCode,
      targetUrl: `https://zipcaptions.app/stream/${encodeURIComponent(cleanCode)}`
    };
  }

  function updateSignPreview() {
    if (orgInput && previewOrg) {
      previewOrg.textContent = orgInput.value.trim() || 'Zip Captions';
    }
    const { displayCode, targetUrl } = parseBroadcastInput(codeInput?.value || '');
    if (previewCode) {
      previewCode.textContent = displayCode;
    }
    if (previewStreamUrl) {
      previewStreamUrl.textContent = targetUrl;
    }
    if (resolvedStreamHint) {
      resolvedStreamHint.textContent = targetUrl;
    }
    if (qrContainer) {
      qrContainer.innerHTML = buildQrSvg(targetUrl);
    }
    if (qrTargetLabel) {
      qrTargetLabel.textContent = targetUrl.replace(/^https?:\/\//i, '');
    }
    if (templateSelect) {
      const selectedOpt = templateSelect.options[templateSelect.selectedIndex];
      if (selectedOpt) {
        const headline = selectedOpt.getAttribute('data-headline') || '';
        const subtitle = selectedOpt.getAttribute('data-subtitle') || '';
        const stepsRaw = selectedOpt.getAttribute('data-steps') || '[]';
        if (previewHeadline) previewHeadline.textContent = headline;
        if (previewSubtitle) previewSubtitle.textContent = subtitle;
        if (previewSteps) {
          try {
            const steps: string[] = JSON.parse(stepsRaw);
            previewSteps.innerHTML = steps
              .map(
                (st, idx) =>
                  `<li class="flex items-start gap-2.5 p-3 rounded-lg bg-slate-800/90 border border-slate-700"><span class="w-6 h-6 rounded-md bg-amethyst text-white font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">${idx + 1}</span><span class="leading-snug">${st}</span></li>`
              )
              .join('');
          } catch {
            // ignore parse error
          }
        }
      }
    }
  }

  updateSignPreview();
  templateSelect?.addEventListener('change', updateSignPreview);
  orgInput?.addEventListener('input', updateSignPreview);
  codeInput?.addEventListener('input', updateSignPreview);

  printBtn?.addEventListener('click', () => {
    const posterEl = document.getElementById('printable-poster-preview');
    if (!posterEl) return;
    const printWin = window.open('', '_blank', 'width=850,height=1050');
    if (!printWin) {
      window.print();
      return;
    }
    const orgText = previewOrg?.textContent || '';
    const headlineText = previewHeadline?.textContent || '';
    const subtitleText = previewSubtitle?.textContent || '';
    const roomCodeText = previewCode?.textContent || '';
    const qrSvgHtml = qrContainer?.innerHTML || '';
    const qrTargetText = qrTargetLabel?.textContent || 'zipcaptions.app';
    const stepItems = Array.from(previewSteps?.querySelectorAll('li span:last-child') || []).map(
      (el) => el.textContent || ''
    );

    printWin.document.write(`<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title>${headlineText}</title>
  <style>
    @page { size: letter portrait; margin: 0.35in; }
    * { box-sizing: border-box; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; background: #0F172A; color: #FFFFFF; margin: 0; padding: 0; }
    .poster { background: #0F172A; border: 3px solid #2DD4BF; border-radius: 18px; padding: 18px; }
    .hero { background: #1E1B4B; border-bottom: 6px solid #2DD4BF; border-radius: 14px; padding: 26px 28px; margin-bottom: 18px; }
