---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from './FaqSection.astro';
import { generalPrintable, sectorsData, type SectorData } from '../data/useCasesData';

interface Props {
  sector: SectorData;
  locale: 'en' | 'fr';
}

const { sector, locale } = Astro.props;
const isFr = locale === 'fr';
const basePrefix = isFr ? '/fr' : '';
const allSectors = sectorsData[locale];
const universalSign = generalPrintable[locale];
const allPrintables = [...sector.printables, universalSign];
const customizableTemplates = allPrintables.filter((p) => p.hasQrAndRoomBox);

const siteOrigin = 'https://zipsolutions.org';
const pageUrl = `${siteOrigin}${basePrefix}/use-cases/${sector.slug}`;
const hubUrl = `${siteOrigin}${basePrefix}/use-cases`;

const sectorSchema = [
  {
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
    "url": pageUrl,
    "name": sector.seoTitle,
    "description": sector.description,
    "inLanguage": isFr ? "fr-CA" : "en-US",
    "isPartOf": {
      "@id": "https://zipsolutions.org/#website"
    },
    "hasPart": allPrintables.map((item) => ({
      "@type": "DigitalDocument",
      "name": item.title,
      "description": item.description,
      "url": `${siteOrigin}${item.fileUrl}`,
      "encodingFormat": "application/pdf",
      "isAccessibleForFree": true
    }))
  },
  ...sector.videos.map((vid) => ({
    "@type": "VideoObject",
    "name": vid.title,
    "description": vid.description,
    "thumbnailUrl": `https://i.ytimg.com/vi/${vid.youtubeId}/hqdefault.jpg`,
    "uploadDate": vid.uploadDate,
    "embedUrl": `https://www.youtube.com/embed/${vid.youtubeId}`
  }))
];
---

<BaseLayout
  title={sector.seoTitle}
  description={sector.description}
  faqs={sector.faqs}
  schema={sectorSchema}
>
  <Fragment slot="head">
    <meta name="keywords" content={sector.keywords} />
  </Fragment>

  <!-- Sector Navigation Bar (No Pills) -->
  <div class="bg-slate-100 border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex flex-wrap items-center justify-between gap-3">
      <a
        href={`${basePrefix}/use-cases`}
        class="inline-flex items-center gap-1.5 text-xs font-bold font-heading text-slate-700 hover:text-amethyst transition-colors"
      >
        <svg aria-hidden="true" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>{isFr ? 'Tous les secteurs d’utilisation' : 'All Sector Use Cases'}</span>
      </a>

      <nav aria-label={isFr ? 'Secteurs Zip Captions' : 'Zip Captions Sectors'} class="flex flex-wrap items-center gap-1.5">
        {allSectors.map((s) => {
          const active = s.slug === sector.slug;
          return (
            <a
              href={`${basePrefix}/use-cases/${s.slug}`}
              aria-current={active ? 'page' : undefined}
              class={`px-3 py-1.5 rounded-lg text-xs font-bold font-heading transition-colors ${
                active
                  ? 'bg-midnight text-white shadow-xs'
                  : 'bg-white text-slate-700 hover:text-amethyst border border-slate-200/80'
              }`}
            >
              {s.navLabel}
            </a>
          );
        })}
      </nav>
    </div>
  </div>

  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-white via-slate-50 to-alabaster border-b border-slate-200/80 pt-12 sm:pt-16 pb-14 sm:pb-18 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-xs sm:text-sm font-bold text-teal-brand tracking-wider uppercase mb-3 font-heading">
        {sector.categoryLabel}
      </p>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-midnight font-heading leading-tight">
        {sector.title}
      </h1>
      <p class="mt-4 text-base sm:text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed">
        {sector.description}
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3.5">
        <a
          href="https://zipcaptions.app"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl font-heading font-bold text-sm sm:text-base bg-amethyst hover:bg-amethyst-dark text-white shadow-md transition-all"
        >
          <span>{isFr ? 'Lancer Zip Captions gratuitement' : 'Launch Zip Captions Free'}</span>
          <svg aria-hidden="true" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
        <a
          href="#printables"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl font-heading font-bold text-sm sm:text-base bg-white hover:bg-slate-100 text-midnight border border-slate-300 shadow-xs transition-all"
        >
          <svg aria-hidden="true" class="w-4 h-4 text-teal-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          <span>{isFr ? 'Affiches et ressources imprimables' : 'Free Printables & Signs'}</span>
        </a>
        <a
          href="#videos"
          class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl font-heading font-semibold text-sm sm:text-base text-slate-700 hover:text-midnight bg-slate-200/60 hover:bg-slate-200 transition-colors"
        >
          <span>{isFr ? 'Voir les vidéos' : 'Watch Videos'}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Section 1: Why Zip Captions Is Used in This Sector -->
  <section class="py-16 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <p class="text-xs font-bold uppercase tracking-wider text-amethyst font-heading mb-2">
        {isFr ? 'Cas d’utilisation concrets' : 'Practical Use Cases'}
      </p>
      <h2 class="text-2xl sm:text-4xl font-extrabold font-heading text-midnight">
        {sector.reasonsTitle}
      </h2>
      <p class="mt-3 text-slate-600 text-sm sm:text-base leading-relaxed">
        {sector.reasonsSubtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {sector.reasons.map((reason) => (
        <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-xs hover:border-slate-300 transition-all flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-purple-50 text-amethyst flex items-center justify-center mb-4 border border-purple-100">
              <svg aria-hidden="true" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <h3 class="text-lg font-bold font-heading text-midnight mb-2">
              {reason.title}
            </h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              {reason.description}
            </p>
          </div>
        </div>
      ))}
    </div>

    {sector.disclaimerNote && (
      <div class="mt-10 bg-slate-100 rounded-2xl p-5 sm:p-6 border border-slate-300 text-xs sm:text-sm text-slate-700 leading-relaxed">
        {sector.disclaimerNote}
      </div>
    )}
  </section>

  <!-- Section 2: How Setup Works in 3 Steps -->
  <section class="py-16 bg-white border-y border-slate-200/80">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <p class="text-xs font-bold uppercase tracking-wider text-teal-brand font-heading mb-2">
          {isFr ? 'Mise en route simple' : 'Simple Workflow'}
        </p>
        <h2 class="text-2xl sm:text-3xl font-extrabold font-heading text-midnight">
          {sector.setupTitle}
        </h2>
        <p class="mt-2 text-slate-600 text-sm sm:text-base">
          {sector.setupSubtitle}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        {sector.setupSteps.map((st) => (
          <div class="bg-alabaster rounded-2xl p-6 sm:p-8 border border-slate-200">
            <span class="text-2xl font-extrabold font-mono text-teal-brand block mb-2">
              {st.step}
            </span>
            <h3 class="text-lg font-bold font-heading text-midnight mb-2">
              {st.title}
            </h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              {st.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 3: Printable Posters, Signs, and Checklists (Deferred rendering below the fold) -->
  <section id="printables" class="deferred-below-fold py-16 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 scroll-mt-20">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <p class="text-xs font-bold uppercase tracking-wider text-amethyst font-heading mb-2">
        {isFr ? 'Ressources gratuites à imprimer' : 'Free Printable Resources'}
      </p>
      <h2 class="text-2xl sm:text-4xl font-extrabold font-heading text-midnight">
        {isFr ? 'Affiches, chevalets et listes de contrôle' : 'Posters, Signs, Cards, and Checklists'}
      </h2>
      <p class="mt-3 text-slate-600 text-sm sm:text-base leading-relaxed">
        {isFr
          ? 'Téléchargez nos modèles PDF prêts à imprimer (avec code QR intégré vers zipcaptions.app) ou personnalisez une affiche avec votre propre code de diffusion ci-dessous.'
          : 'Download ready-to-print PDF files (with a built-in QR code for zipcaptions.app) or use the customizer below to add your own room name and broadcast code before printing.'}
      </p>
    </div>

    <!-- Downloadable PDF Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-14">
      {allPrintables.map((item) => (
        <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-xs flex flex-col justify-between gap-6">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-xs font-bold font-mono text-teal-brand uppercase tracking-wider">
                {item.typeLabel}
              </span>
              <span class="text-xs font-mono text-slate-500 bg-slate-100 px-2.5 py-1 rounded-md border border-slate-200">
                US Letter / A4
              </span>
            </div>
            <h3 class="text-xl font-bold font-heading text-midnight mb-2">
              {item.title}
            </h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              {item.description}
            </p>
          </div>

          <div class="pt-4 border-t border-slate-100 flex flex-wrap items-center gap-3">
            <a
              href={item.fileUrl}
              download
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-midnight hover:bg-slate-800 text-white text-xs sm:text-sm font-bold font-heading transition-colors shadow-2xs"
            >
              <svg aria-hidden="true" class="w-4 h-4 text-teal-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              <span>{isFr ? 'Télécharger le PDF' : 'Download PDF'}</span>
            </a>
            <a
              href={item.fileUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs sm:text-sm font-bold font-heading transition-colors"
            >
              <span>{isFr ? 'Ouvrir et imprimer' : 'View & Print'}</span>
              <svg aria-hidden="true" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Interactive Browser Sign Customizer -->
    {customizableTemplates.length > 0 && (
      <div class="bg-white rounded-3xl border-2 border-slate-200 shadow-sm p-6 sm:p-10">
        <div class="max-w-3xl mb-8">
          <span class="text-xs font-bold font-mono text-amethyst uppercase tracking-wider block mb-1">
            {isFr ? 'Outil d’impression personnalisée' : 'Custom Sign & Poster Builder'}
          </span>
          <h3 class="text-xl sm:text-2xl font-extrabold font-heading text-midnight">
            {isFr
              ? 'Personnalisez votre affiche avec votre nom et code de diffusion'
              : 'Customize a Poster with Your Organization Name and Broadcast Code'}
          </h3>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed">
            {isFr
              ? 'Choisissez un modèle, inscrivez le nom de votre salle ou organisation ainsi que votre code de diffusion Zip Captions, puis cliquez sur Imprimer l’affiche.'
              : 'Pick a sign template, type in your room or organization name and your Zip Captions broadcast room code, and click Print Custom Sign.'}
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <!-- Left Form Controls -->
          <div class="lg:col-span-5 space-y-5 bg-slate-50 p-6 rounded-2xl border border-slate-200">
            <div>
              <label for="sign-template-select" class="block text-xs font-bold font-heading text-midnight uppercase tracking-wider mb-1">
                {isFr ? '1. Modèle d’affiche' : '1. Sign Template'}
              </label>
              <span id="sign-template-hint" class="block text-xs text-slate-500 mb-2">
                {isFr ? 'Sélectionnez le texte prérempli adapté à votre lieu.' : 'Choose the pre-written sign wording that fits your space.'}
              </span>
              <select
                id="sign-template-select"
                aria-describedby="sign-template-hint"
                class="w-full px-3.5 py-2.5 rounded-xl bg-white border border-slate-300 text-sm text-midnight font-medium focus:outline-none focus:ring-2 focus:ring-amethyst"
              >
                {customizableTemplates.map((tpl, idx) => (
                  <option
                    value={tpl.id}
                    selected={idx === 0}
                    data-headline={tpl.defaultPosterHeadline}
                    data-subtitle={tpl.defaultPosterSubtitle}
                    data-steps={JSON.stringify(tpl.defaultSteps || [])}
                  >
                    {tpl.title}
                  </option>
                ))}
              </select>
            </div>

            <div>
              <label for="sign-org-input" class="block text-xs font-bold font-heading text-midnight uppercase tracking-wider mb-1">
                {isFr ? '2. Nom du lieu, de la salle ou de l’organisation' : '2. Organization or Room Name'}
              </label>
              <span id="sign-org-hint" class="block text-xs text-slate-500 mb-2">
                {isFr ? 'Apparaît en haut de votre affiche imprimée.' : 'Appears at the top of your printed poster.'}
              </span>
              <input
                id="sign-org-input"
                type="text"
                aria-describedby="sign-org-hint"
                value={sector.defaultOrgPlaceholder}
                class="w-full px-3.5 py-2.5 rounded-xl bg-white border border-slate-300 text-sm text-midnight font-medium focus:outline-none focus:ring-2 focus:ring-amethyst"
              />
            </div>

            <div>
              <label for="sign-code-input" class="block text-xs font-bold font-heading text-midnight uppercase tracking-wider mb-1">
                {isFr ? '3. Code de diffusion ou lien direct' : '3. Broadcast Join Code or Stream Link'}
              </label>
              <span id="sign-code-hint" class="block text-xs text-slate-500 mb-2">
                {isFr
                  ? 'Entrez votre code (ex. 76-aqz5-pf77) ou collez le lien https://zipcaptions.app/stream/76-aqz5-pf77. Le code QR se met à jour automatiquement.'
                  : 'Enter your join code (for example, 76-aqz5-pf77) or paste https://zipcaptions.app/stream/76-aqz5-pf77. The QR code updates automatically.'}
              </span>
              <input
                id="sign-code-input"
                type="text"
                aria-describedby="sign-code-hint"
                value={sector.defaultRoomCodePlaceholder}
                placeholder="76-aqz5-pf77"
                class="w-full px-3.5 py-2.5 rounded-xl bg-white border border-slate-300 text-sm font-mono font-bold text-midnight focus:outline-none focus:ring-2 focus:ring-amethyst"
              />
              <p class="mt-2 text-[11px] font-mono text-slate-600 bg-white px-3 py-1.5 rounded-lg border border-slate-200 truncate">
                <span class="font-bold text-teal-brand">{isFr ? 'Lien QR :' : 'QR Link:'}</span>{' '}
                <span id="resolved-stream-url-hint">{`https://zipcaptions.app/stream/${sector.defaultRoomCodePlaceholder}`}</span>
              </p>
            </div>

            <div class="pt-2">
              <button
                id="print-custom-sign-btn"
                type="button"
                class="w-full inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl bg-teal-brand hover:bg-teal-dark text-white font-heading font-bold text-sm shadow-sm transition-all cursor-pointer"
              >
                <svg aria-hidden="true" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
                </svg>
                <span>{isFr ? 'Imprimer cette affiche personnalisée' : 'Print Custom Sign'}</span>
              </button>
            </div>
          </div>

          <!-- Right Live Printable Poster Preview -->
          <div class="lg:col-span-7">
            <div
              id="printable-poster-preview"
              class="bg-slate-950 rounded-2xl border-2 border-teal-brand p-3 sm:p-4 overflow-hidden shadow-md"
            >
              <!-- Poster Hero Banner -->
              <div class="bg-[#1E1B4B] text-white p-6 sm:p-7 rounded-xl border-b-4 border-teal-brand relative">
                <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
                  <span
                    id="preview-org-name"
                    class="inline-block px-3 py-1 rounded-md bg-amethyst text-white text-xs font-bold font-mono uppercase tracking-wider"
                  >
                    {sector.defaultOrgPlaceholder}
                  </span>
                  <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-slate-900 border border-slate-700 text-xs font-bold font-heading">
                    <span class="px-1.5 py-0.5 rounded-xs bg-amethyst text-white text-[10px]">CC</span>
                    <span class="text-purple-300">Zip</span>
                    <span class="text-teal-300">Captions</span>
                  </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-12 gap-4 items-center">
                  <div class="sm:col-span-9">
                    <h4
                      id="preview-headline"
                      class="text-xl sm:text-2xl font-extrabold font-heading text-white uppercase tracking-tight leading-snug"
                    >
                      {customizableTemplates[0]?.defaultPosterHeadline}
                    </h4>
                    <p
                      id="preview-subtitle"
                      class="mt-2 text-xs sm:text-sm text-slate-200 leading-relaxed"
                    >
                      {customizableTemplates[0]?.defaultPosterSubtitle}
                    </p>
                  </div>
                  <div class="hidden sm:flex sm:col-span-3 justify-end">
                    <div class="w-20 h-20 rounded-xl bg-slate-900/90 border-2 border-teal-brand flex flex-col items-center justify-center p-2 text-center">
                      <span class="text-lg font-extrabold font-mono text-teal-300 leading-none">CC</span>
                      <span class="text-[9px] font-mono text-slate-300 uppercase mt-1">Live Text</span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Poster Centerpiece: Room Code + Giant QR Card -->
              <div class="mt-3 bg-white rounded-xl border-2 border-teal-brand p-5 sm:p-6">
                <div class="grid grid-cols-1 sm:grid-cols-12 gap-5 items-center">
                  <div class="sm:col-span-7 space-y-2">
                    <div class="bg-[#1E1B4B] text-white text-[11px] font-bold font-heading uppercase tracking-wider px-3 py-1.5 rounded-md text-center">
                      {isFr ? 'Code de diffusion sur zipcaptions.app' : 'Broadcast Room Code at zipcaptions.app'}
                    </div>
                    <div
                      id="preview-room-code"
                      class="px-4 py-4 rounded-lg bg-slate-50 border-2 border-dashed border-amethyst font-mono text-2xl sm:text-3xl font-extrabold text-midnight tracking-wider min-h-[4.25rem] flex items-center justify-center text-center"
                    >
                      {sector.defaultRoomCodePlaceholder}
                    </div>
                    <div class="flex items-center justify-between text-[11px] font-mono text-slate-600 pt-0.5 gap-2">
                      <span id="preview-stream-url" class="truncate">{`https://zipcaptions.app/stream/${sector.defaultRoomCodePlaceholder}`}</span>
                      <span class="shrink-0">{isFr ? 'Aucun compte requis' : 'No app or login needed'}</span>
                    </div>
                  </div>

                  <div class="sm:col-span-5 flex flex-col items-center justify-center sm:border-l sm:border-slate-200 sm:pl-4">
                    <div
                      id="preview-qr-svg-container"
                      class="p-2.5 bg-white rounded-lg border-2 border-amethyst flex items-center justify-center"
                      aria-label="Custom QR Code for Zip Captions Broadcast"
                    ></div>
                    <span class="mt-2 px-3 py-1 rounded-md bg-amethyst text-white text-[10px] font-bold font-heading uppercase tracking-wider">
                      {isFr ? 'Balayez avec la caméra' : 'Scan with Phone Camera'}
                    </span>
                    <span
                      id="preview-qr-target-label"
                      class="mt-1 text-[10px] font-mono text-slate-500 max-w-[11rem] truncate text-center"
                    >
                      {`zipcaptions.app/stream/${sector.defaultRoomCodePlaceholder}`}
                    </span>
                  </div>
                </div>
              </div>

              <!-- Poster 2x2 Visual Step Grid -->
              <div class="mt-3 p-4 sm:p-5 rounded-xl bg-slate-900 border border-slate-800">
                <p class="text-xs font-bold font-heading text-teal-300 uppercase tracking-wider text-center mb-3">
                  {isFr ? 'Comment suivre les sous-titres en direct' : 'How to Read Live Captions on Your Device'}
                </p>
