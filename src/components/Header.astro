              Cookie Policy
            </a>
          </div>
        </div>

      </nav>

      <!-- Right Action CTA -->
      <div class="hidden lg:flex items-center gap-3">
        <a 
          href="/contact-us" 
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl font-heading font-semibold text-sm text-white bg-teal-brand hover:bg-teal-dark shadow-sm hover:shadow-md transition-all duration-200 focus-visible:ring-2 focus-visible:ring-teal-brand"
        >
          Contact Us
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex items-center lg:hidden">
        <button 
          id="mobile-menu-btn" 
          type="button" 
          class="p-2.5 rounded-xl text-slate-700 hover:text-midnight hover:bg-slate-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-amethyst" 
          aria-label="Toggle navigation menu"
          aria-expanded="false"
        >
          <svg id="hamburger-icon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-200 bg-white px-4 pt-3 pb-6 space-y-2 shadow-xl animate-in slide-in-from-top duration-200 max-h-[calc(100vh-5rem)] overflow-y-auto">
    
    <a href="/" class="block px-3 py-2.5 rounded-xl text-base font-semibold text-slate-800 hover:bg-slate-100">
      Home
    </a>

    <!-- Mobile Products Collapsible -->
    <details class="group rounded-xl">
      <summary class="flex items-center justify-between px-3 py-2.5 rounded-xl text-base font-semibold text-slate-800 hover:bg-slate-100 cursor-pointer list-none">
        <span>Products & Services</span>
        <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>
      <div class="pl-4 pr-2 py-1 space-y-1">
        <a href="/products" class="block px-3 py-2 rounded-lg text-sm font-medium text-slate-600 hover:text-amethyst hover:bg-purple-50">Services Overview</a>
        <a href="/zipcaptions" class="block px-3 py-2 rounded-lg text-sm font-medium text-slate-600 hover:text-amethyst hover:bg-purple-50">Zip Captions</a>
        <a href="/easyspeak" class="block px-3 py-2 rounded-lg text-sm font-medium text-slate-600 hover:text-amethyst hover:bg-purple-50">Easy Speak AAC</a>
        <a href="/zippanel" class="block px-3 py-2 rounded-lg text-sm font-medium text-slate-600 hover:text-amethyst hover:bg-purple-50">Zip Panel Extension</a>
        <a href="/zipconnect" class="block px-3 py-2 rounded-lg text-sm font-medium text-slate-600 hover:text-amethyst hover:bg-purple-50">Zip Connect Extension</a>
        <a href="/zipvmix" class="block px-3 py-2 rounded-lg text-sm font-medium text-slate-600 hover:text-amethyst hover:bg-purple-50">Zip Captions vMix Bridge</a>
        <div class="my-1 border-t border-slate-100"></div>
        <a href="/products" class="block px-3 py-2 rounded-lg text-sm font-medium text-slate-600 hover:text-amethyst hover:bg-purple-50">Event Organisation &amp; Hybrid Sessions</a>
        <a href="/contact-us" class="block px-3 py-2 rounded-lg text-sm font-medium text-slate-600 hover:text-amethyst hover:bg-purple-50">Custom Live Event Quotes</a>
