---
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200/80 transition-all duration-200 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 focus-visible:ring-2 focus-visible:ring-amethyst rounded-lg p-1 group" aria-label="Zip Solutions - Home">
        <img 
          src="/images/zipsolutions_logo.png" 
          alt="Zip Solutions" 
          class="h-8 sm:h-9 w-auto object-contain transition-transform duration-200 group-hover:scale-[1.02]" 
          width="160"
          height="38"
        />
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center space-x-1 xl:space-x-2" aria-label="Main Navigation">
        
        <a 
          href="/" 
          class={`px-3.5 py-2 rounded-xl text-sm font-semibold transition-colors ${currentPath === '/' ? 'text-amethyst bg-purple-50' : 'text-slate-700 hover:text-midnight hover:bg-slate-100'}`}
        >
          Home
        </a>

        <!-- Products & Services Dropdown -->
        <div class="relative dropdown-group">
          <button 
            type="button" 
            class="dropdown-btn flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-sm font-semibold text-slate-700 hover:text-midnight hover:bg-slate-100 transition-colors focus-visible:ring-2 focus-visible:ring-amethyst" 
            aria-expanded="false"
            aria-haspopup="true"
          >
            <span>Products & Services</span>
            <svg class="w-4 h-4 text-slate-500 transition-transform dropdown-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="dropdown-menu hidden absolute left-0 mt-2 w-64 rounded-2xl bg-white border border-slate-200/90 shadow-xl py-2 z-50 animate-in fade-in slide-in-from-top-2 duration-150">
            <a href="/products" class="flex items-center px-4 py-2.5 text-sm font-medium text-slate-700 hover:text-amethyst hover:bg-purple-50/70 transition-colors">
              Services Overview
            </a>
            <a href="/zipcaptions" class="flex items-center px-4 py-2.5 text-sm font-medium text-slate-700 hover:text-amethyst hover:bg-purple-50/70 transition-colors">
              Zip Captions
            </a>
            <a href="/easyspeak" class="flex items-center px-4 py-2.5 text-sm font-medium text-slate-700 hover:text-amethyst hover:bg-purple-50/70 transition-colors">
              Easy Speak AAC
            </a>
            <a href="/zippanel" class="flex items-center px-4 py-2.5 text-sm font-medium text-slate-700 hover:text-amethyst hover:bg-purple-50/70 transition-colors">
              Zip Panel Extension
            </a>
            <a href="/zipconnect" class="flex items-center px-4 py-2.5 text-sm font-medium text-slate-700 hover:text-amethyst hover:bg-purple-50/70 transition-colors">
              Zip Connect Extension
            </a>
            <a href="/zipvmix" class="flex items-center px-4 py-2.5 text-sm font-medium text-slate-700 hover:text-amethyst hover:bg-purple-50/70 transition-colors">
              Zip Captions vMix Bridge
            </a>
            <div class="my-1 border-t border-slate-100"></div>
            <a href="/products" class="flex items-center px-4 py-2.5 text-sm font-medium text-slate-700 hover:text-amethyst hover:bg-purple-50/70 transition-colors">
              Event Organisation &amp; Hybrid Sessions
            </a>
            <a href="/contact-us" class="flex items-center px-4 py-2.5 text-sm font-medium text-slate-700 hover:text-amethyst hover:bg-purple-50/70 transition-colors">
              Custom Live Event Quotes
            </a>
          </div>
        </div>

        <!-- Advisory Board Link -->
        <a 
          href="/advisory" 
          class={`px-3.5 py-2 rounded-xl text-sm font-semibold transition-colors ${currentPath === '/advisory' ? 'text-amethyst bg-purple-50' : 'text-slate-700 hover:text-midnight hover:bg-slate-100'}`}
        >
          Advisory Board
        </a>

        <!-- Zip Captions Dropdown -->
        <div class="relative dropdown-group">
          <button 
            type="button" 
            class="dropdown-btn flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-sm font-semibold text-slate-700 hover:text-midnight hover:bg-slate-100 transition-colors focus-visible:ring-2 focus-visible:ring-amethyst" 
            aria-expanded="false"
            aria-haspopup="true"
          >
            <span>Zip Captions</span>
            <svg class="w-4 h-4 text-slate-500 transition-transform dropdown-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
