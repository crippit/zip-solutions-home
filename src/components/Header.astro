      <div class="pl-4 pr-2 py-1 space-y-1">
        <a href="/zipcaptions" class="block px-3 py-2 rounded-lg text-sm font-medium text-slate-600 hover:text-teal-brand hover:bg-teal-50">About Zip Captions</a>
        <a href="/pricing" class="block px-3 py-2 rounded-lg text-sm font-medium text-slate-600 hover:text-teal-brand hover:bg-teal-50">Pricing Plans</a>
        <a href="https://zipcaptions.app" target="_blank" rel="noopener noreferrer" class="block px-3 py-2 rounded-lg text-sm font-medium text-slate-600 hover:text-teal-brand hover:bg-teal-50">Start Captioning ↗</a>
        <a href="https://help.zipcaptions.app" target="_blank" rel="noopener noreferrer" class="block px-3 py-2 rounded-lg text-sm font-medium text-slate-600 hover:text-teal-brand hover:bg-teal-50">Help Center ↗</a>
        <a href="https://discord.gg/5Hyu7sQTHv" target="_blank" rel="noopener noreferrer" class="block px-3 py-2 rounded-lg text-sm font-medium text-slate-600 hover:text-teal-brand hover:bg-teal-50">Community Discord ↗</a>
        <a href="https://patreon.com/zipcaptions" target="_blank" rel="noopener noreferrer" class="block px-3 py-2 rounded-lg text-sm font-medium text-slate-600 hover:text-teal-brand hover:bg-teal-50">Patreon ↗</a>
