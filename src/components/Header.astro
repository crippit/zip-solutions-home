---
import { getEquivalentUrl } from '../i18n/ui';
import { DesktopNav } from './DesktopNav';
import { MobileNavSheet } from './MobileNavSheet';

const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, '') || '/';
const currentLocale = (Astro.currentLocale || (currentPath.startsWith('/fr') ? 'fr' : 'en')) as 'en' | 'fr';
const isFr = currentLocale === 'fr';

const homeUrl = isFr ? '/fr' : '/';
const targetLang = isFr ? 'en' : 'fr';
const switchLangUrl = getEquivalentUrl(currentPath, targetLang);
const switchLangText = isFr ? 'English' : 'Français';
const switchLangShort = isFr ? 'EN' : 'FR';

function l(path: string): string {
  if (path.startsWith('http')) return path;
  if (!isFr) return path;
  if (path === '/') return '/fr';
  return `/fr${path}`;
}
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200/80 transition-all duration-200 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href={homeUrl} class="flex items-center gap-3 focus-visible:ring-2 focus-visible:ring-amethyst rounded-lg p-1 group" aria-label={isFr ? "Zip Solutions - Accueil" : "Zip Solutions - Home"}>
        <img 
          src="/images/zipsolutions_logo.svg" 
          alt="Zip Solutions" 
          class="h-8 sm:h-9 w-auto object-contain transition-transform duration-200 group-hover:scale-[1.02]" 
          width="160"
          height="38"
        />
      </a>

      <!-- Desktop Navigation (Radix UI / shadcn DropdownMenu) -->
      <DesktopNav client:load currentPath={currentPath} isFr={isFr} />

      <!-- Right Action CTA & Language Switcher -->
      <div class="hidden lg:flex items-center gap-2.5">
        <!-- Language Switcher Button (Zero Pills) -->
        <a 
          href={switchLangUrl} 
          class="px-2.5 py-1.5 rounded-xl border border-slate-200 hover:border-amethyst hover:bg-purple-50/60 text-xs font-bold font-mono text-slate-700 hover:text-amethyst transition-all flex items-center gap-1.5 focus-visible:ring-2 focus-visible:ring-amethyst shadow-2xs"
          title={isFr ? "Switch language to English" : "Passer le site en français"}
          aria-label={isFr ? "Switch language to English" : "Passer le site en français"}
        >
          <span class="text-sm select-none" aria-hidden="true">🌐</span>
          <span>{switchLangShort}</span>
        </a>

        <a 
          href={l('/contact-us')} 
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl font-heading font-semibold text-sm text-white bg-teal-brand hover:bg-teal-dark shadow-sm hover:shadow-md transition-all duration-200 focus-visible:ring-2 focus-visible:ring-teal-brand"
        >
          {isFr ? "Contact" : "Contact Us"}
        </a>
      </div>

      <!-- Mobile Navigation Drawer (Radix UI Dialog/Sheet) -->
      <div class="flex items-center gap-2 lg:hidden">
        <!-- Mobile Quick Language Switcher -->
        <a 
          href={switchLangUrl} 
          class="px-2 py-1.5 rounded-lg border border-slate-200 bg-white text-xs font-bold font-mono text-slate-700 flex items-center gap-1 shadow-2xs"
          title={isFr ? "Switch language to English" : "Passer le site en français"}
          aria-label={isFr ? "Switch language to English" : "Passer le site en français"}
        >
          <span class="text-xs select-none" aria-hidden="true">🌐</span>
          <span>{switchLangShort}</span>
        </a>

        <MobileNavSheet
          client:load
          currentPath={currentPath}
          isFr={isFr}
          switchLangUrl={switchLangUrl}
          switchLangText={switchLangText}
          switchLangShort={switchLangShort}
        />
      </div>

    </div>
  </div>
</header>
