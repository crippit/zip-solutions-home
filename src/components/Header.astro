            class="dropdown-btn flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-sm font-semibold text-slate-700 hover:text-midnight hover:bg-slate-100 transition-colors focus-visible:ring-2 focus-visible:ring-amethyst" 
