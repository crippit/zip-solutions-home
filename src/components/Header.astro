---
import { getEquivalentUrl, useTranslations } from '../i18n/ui';

const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, '') || '/';
const currentLocale = (Astro.currentLocale || (currentPath.startsWith('/fr') ? 'fr' : 'en')) as 'en' | 'fr';
const t = useTranslations(currentLocale);
const isFr = currentLocale === 'fr';

const homeUrl = isFr ? '/fr' : '/';
const targetLang = isFr ? 'en' : 'fr';
const switchLangUrl = getEquivalentUrl(currentPath, targetLang);
const switchLangText = isFr ? 'English' : 'Français';
const switchLangShort = isFr ? 'EN' : 'FR';

function l(path: string): string {
  if (path.startsWith('http')) return path;
  if (!isFr) return path;
  if (path === '/') return '/fr';
  return `/fr${path}`;
}
---

