      <div class="pl-4 pr-2 py-1 space-y-1">
        <a href="/story" class="block px-3 py-2 rounded-lg text-sm font-medium text-slate-600 hover:text-amethyst hover:bg-purple-50">Our Story</a>
        <a href="/about-us" class="block px-3 py-2 rounded-lg text-sm font-medium text-slate-600 hover:text-amethyst hover:bg-purple-50">Our Team</a>
        <a href="/testimonial" class="block px-3 py-2 rounded-lg text-sm font-medium text-slate-600 hover:text-amethyst hover:bg-purple-50">Testimonials</a>
        <a href="/press" class="block px-3 py-2 rounded-lg text-sm font-medium text-slate-600 hover:text-amethyst hover:bg-purple-50">In the Press</a>
        <a href="/pressrelease" class="block px-3 py-2 rounded-lg text-sm font-medium text-slate-600 hover:text-amethyst hover:bg-purple-50">Press Releases</a>
