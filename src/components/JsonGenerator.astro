---
const isFr = Astro.currentLocale === 'fr' || Astro.url.pathname.startsWith('/fr');

const title = isFr 
  ? "Enregistrer le fichier JSON de page généré par l'IA" 
  : "Save Your AI Generated Page JSON";
const description = isFr
  ? "Collez ci-dessous le bloc de code JSON généré par le Gem Gemini, nommez votre fichier, et cliquez sur télécharger pour l'enregistrer directement sur votre appareil afin de l'importer dans Zip EasySpeak."
  : "Paste the JSON code block generated by the Gemini Gem below, name your file, and click download to save it directly to your device for importing into Zip EasySpeak.";
const placeholder = isFr ? "Collez votre JSON ici..." : "Paste your JSON here...";
const buttonText = isFr ? "Télécharger le fichier JSON" : "Download JSON File";
const errEmpty = isFr ? "Veuillez coller du code JSON avant de télécharger." : "Please paste some JSON code before downloading.";
const errInvalid = isFr ? "JSON non valide : veuillez vérifier le format de votre code." : "Invalid JSON: Please check the format of your pasted code.";
const successTemplate = isFr ? "Téléchargement de {filename} réussi !" : "Downloaded {filename} successfully!";
---

<div class="my-8 p-6 bg-slate-50 rounded-2xl border border-slate-200">
  <h3 class="text-lg font-bold font-heading text-midnight mb-3">
    {title}
  </h3>
  <p class="text-sm text-slate-600 mb-4">
    {description}
  </p>
  
  <div class="space-y-4" data-err-empty={errEmpty} data-err-invalid={errInvalid} data-success={successTemplate}>
    <div>
      <label for="json-input" class="block text-xs font-bold uppercase tracking-wider text-slate-700 font-heading mb-1.5">
        {isFr ? "Code JSON de la page" : "Page JSON Code"}
      </label>
      <textarea 
        id="json-input" 
        rows="6" 
        placeholder={placeholder} 
        class="w-full font-mono text-xs p-3.5 rounded-xl border border-slate-300 bg-white text-midnight focus:outline-none focus:ring-2 focus:ring-amethyst"
      ></textarea>
    </div>

    <div class="flex flex-col sm:flex-row gap-3 items-center">
      <div class="w-full sm:w-64">
        <label for="file-name-input" class="sr-only">
          {isFr ? "Nom du fichier JSON" : "JSON Filename"}
        </label>
        <input 
          id="file-name-input" 
          type="text" 
          value="page.json" 
          placeholder="filename.json" 
          class="w-full px-4 py-2 text-sm rounded-xl border border-slate-300 bg-white text-midnight focus:outline-none focus:ring-2 focus:ring-amethyst font-mono"
        />
      </div>
      <button 
        id="json-download-btn" 
        type="button" 
        class="w-full sm:w-auto px-6 py-2.5 bg-amethyst hover:bg-amethyst-dark text-white text-sm font-semibold rounded-xl shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-amethyst"
      >
        {buttonText}
      </button>
    </div>
    <div id="json-status" class="text-xs font-semibold hidden" role="status" aria-live="polite"></div>
  </div>
</div>

<script>
  const container = document.querySelector('[data-err-empty]') as HTMLElement;
  const jsonInput = document.getElementById('json-input') as HTMLTextAreaElement;
  const fileNameInput = document.getElementById('file-name-input') as HTMLInputElement;
  const downloadBtn = document.getElementById('json-download-btn');
  const statusMsg = document.getElementById('json-status');

  const errEmpty = container?.dataset.errEmpty || 'Please paste some JSON code before downloading.';
  const errInvalid = container?.dataset.errInvalid || 'Invalid JSON: Please check the format of your pasted code.';
  const successTemplate = container?.dataset.success || 'Downloaded {filename} successfully!';

  downloadBtn?.addEventListener('click', () => {
    if (!jsonInput || !statusMsg) return;

    const content = jsonInput.value.trim();
    if (!content) {
      statusMsg.textContent = errEmpty;
      statusMsg.className = 'text-xs font-semibold text-coral block';
      return;
    }

    try {
      // Validate JSON
      JSON.parse(content);

      let filename = (fileNameInput?.value || 'page.json').trim();
      if (!filename.endsWith('.json')) {
        filename += '.json';
      }

      const blob = new Blob([content], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);

      statusMsg.textContent = successTemplate.replace('{filename}', filename);
      statusMsg.className = 'text-xs font-semibold text-teal-brand block';
    } catch (e: any) {
      statusMsg.textContent = errInvalid;
      statusMsg.className = 'text-xs font-semibold text-coral block';
    }
  });
</script>
