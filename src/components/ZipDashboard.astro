  },
  {
    id: 13,
    name: "Digital Sound & Lighting Systems",
    appUrl: null,
    learnUrl: "/contact-us",
    description: "Professional theatre sound, architectural lighting systems (such as ETC Mosaic), and conference AV system integration and automation.",
    family: "AV Consultancy & Open Guides",
    type: "Venue Systems & AV",
    categories: ["AV Consultancy & Open Guides", "Consulting"],
    icon: "sliders",
    color: "bg-teal-dark",
    borderColor: "border-teal-300",
  },
  {
    id: 15,
    name: "Captioning Consultancy",
    appUrl: null,
    learnUrl: "/contact-us",
    description: "Expert guidance for integrating live captions and theatre surtitles. We advise on stage positioning, LED wall displays, attendee relay apps, and script synchronization.",
    family: "AV Consultancy & Open Guides",
    type: "Captioning Advisory",
    categories: ["AV Consultancy & Open Guides", "Consulting"],
    icon: "users",
    color: "bg-teal-dark",
    borderColor: "border-teal-300",
  },
  {
    id: 14,
    name: "Free Resources for Listening Accessibility",
    appUrl: "https://resources.zipsolutions.org",
    learnUrl: "https://resources.zipsolutions.org",
    description: "Comprehensive guides on Phonak Roger setups, SMART Flat Panels, WiFi assistive listening, classroom media hubs, and theatre surtitles.",
    family: "AV Consultancy & Open Guides",
    type: "Open Knowledge Base",
    categories: ["AV Consultancy & Open Guides", "Resources"],
    icon: "library",
    color: "bg-teal-dark",
    borderColor: "border-teal-300",
  }
];

const allCategories = [
  "All",
  "Live Captioning & Broadcast",
  "AAC & Speech Synthesis",
  "Equitable Reading & Learning",
  "Event Organisation & PD",
  "AV Consultancy & Open Guides"
];
---

<div class="w-full">
  
  <!-- Search & Filter Controls -->
  <div class="mb-10 space-y-4">
    <div class="flex flex-col md:flex-row gap-4 items-center justify-between">
      
      <!-- Search Input -->
      <div class="relative w-full md:w-96">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input 
          id="product-search"
          type="text" 
          placeholder="Search products, services, tools..." 
          class="w-full pl-10 pr-4 py-2.5 rounded-2xl border border-slate-200 bg-white text-midnight placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-amethyst shadow-sm transition-all text-sm"
          aria-label="Search products and services"
        />
      </div>

      <!-- Result Counter -->
      <div id="product-count" class="text-xs font-semibold text-slate-500 uppercase tracking-wider">
        Showing all {products.length} solutions
      </div>
    </div>

    <!-- Category Filters -->
    <div class="flex flex-wrap gap-2 pt-2" role="tablist" aria-label="Filter by category">
      {allCategories.map((cat) => (
        <button
          type="button"
          data-category={cat}
          class={`filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all border ${
            cat === 'All'
              ? 'bg-midnight text-white border-midnight active-filter'
              : 'bg-white text-slate-600 border-slate-200 hover:border-amethyst/50 hover:text-amethyst'
          }`}
          role="tab"
          aria-selected={cat === 'All' ? 'true' : 'false'}
        >
          {cat}
        </button>
      ))}
    </div>
  </div>

  <!-- Product Grid -->
  <div id="products-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {products.map((product) => (
      <div 
        class="product-card group flex flex-col bg-white rounded-3xl p-6 border border-slate-200/80 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 relative overflow-hidden"
        data-name={product.name.toLowerCase()}
        data-desc={product.description.toLowerCase()}
        data-categories={JSON.stringify(product.categories)}
      >
        <!-- Background Ambient Accent Blob -->
        <div class={`absolute -right-10 -top-10 w-28 h-28 rounded-full opacity-10 group-hover:opacity-25 transition-opacity duration-300 ${product.color}`}></div>

        <!-- Top row: Icon and Category text (No pills) -->
        <div class="flex items-start justify-between mb-5 relative z-10">
          <div class={`p-3.5 rounded-2xl text-white shadow-md ${product.color}`}>
            {product.icon === 'ear' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.5 10c0-3.6 2.7-6.5 6-6.5s6 2.9 6 6.5c0 3.2-1.8 5.2-3 6.5-.8.8-1.5 1.8-1.5 2.8a2.2 2.2 0 1 1-4.4 0" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.5 8a2 2 0 0 1 2 2c0 1-.6 1.7-1.3 2.2" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.5 7a5 5 0 0 1 0 6" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 4.5a8.5 8.5 0 0 1 0 11" />
              </svg>
            )}
            {product.icon === 'layout' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <rect x="3" y="3" width="18" height="18" rx="2" stroke-width="2" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9h18M9 21V9" />
              </svg>
            )}
            {product.icon === 'brain' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.5a2.5 2.5 0 00-4.96-.46 2.5 2.5 0 00-1.98 3 2.5 2.5 0 00-1.32 4.24 3 3 0 00.34 4.58 2.5 2.5 0 002.92 3.14M12 4.5a2.5 2.5 0 014.96-.46 2.5 2.5 0 011.98 3 2.5 2.5 0 011.32 4.24 3 3 0 01-.34 4.58 2.5 2.5 0 01-2.92 3.14M12 4.5V20" />
              </svg>
            )}
            {product.icon === 'graduation-cap' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14v7" />
              </svg>
            )}
            {product.icon === 'link' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
              </svg>
            )}
            {product.icon === 'layers' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
            )}
            {product.icon === 'video' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
            )}
            {product.icon === 'mic' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
              </svg>
            )}
            {product.icon === 'grid' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
              </svg>
            )}
            {product.icon === 'shield-check' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
              </svg>
            )}
            {product.icon === 'book-open' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
            )}
            {product.icon === 'headphones' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 18v-6a9 9 0 0118 0v6M3 18a3 3 0 003 3h1a1 1 0 001-1v-4a1 1 0 00-1-1H4a1 1 0 00-1 1zm18 0a3 3 0 01-3 3h-1a1 1 0 01-1-1v-4a1 1 0 011-1h3a1 1 0 011 1z" />
              </svg>
            )}
            {product.icon === 'sliders' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
              </svg>
            )}
            {product.icon === 'library' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z" />
              </svg>
            )}
            {product.icon === 'users' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            )}
            {product.icon === 'calendar' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            )}
            {product.icon === 'tv' && (
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            )}
          </div>
          <div class="flex flex-col items-end max-w-[65%] text-right">
            <span class="text-xs font-bold text-midnight tracking-tight font-heading leading-tight">
              {product.family}
            </span>
            <span class="text-[11px] font-medium text-slate-500 mt-0.5">
              {product.type}
            </span>
          </div>
        </div>

        <!-- Title -->
        <h2 class="text-xl font-bold font-heading text-midnight mb-2.5 group-hover:text-amethyst transition-colors">
          {product.name}
        </h2>

        <!-- Description -->
        <p class="text-slate-600 text-sm leading-relaxed mb-6 flex-grow">
          {product.description}
        </p>

        <!-- Actions -->
        <div class="mt-auto flex items-center gap-2.5 pt-2 border-t border-slate-100">
          {product.learnUrl && (
            <a 
              href={product.learnUrl}
              class="flex-1 flex justify-center items-center px-3.5 py-2.5 bg-slate-50 hover:bg-slate-100 text-slate-800 text-xs font-bold rounded-xl border border-slate-200 transition-colors"
            >
              Learn More
            </a>
          )}
          {product.appUrl && (
            <a 
              href={product.appUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex-1 flex justify-center items-center gap-1.5 px-3.5 py-2.5 bg-amethyst hover:bg-amethyst-dark text-white text-xs font-bold rounded-xl shadow-sm hover:shadow-md transition-all"
            >
              <span>Try Now</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          )}
        </div>

      </div>
    ))}
  </div>

  <!-- Empty state message -->
  <div id="no-products" class="hidden text-center py-16 bg-white rounded-3xl border border-slate-200/80 p-8">
    <svg class="w-12 h-12 mx-auto text-slate-300 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <h3 class="text-lg font-bold text-midnight mb-1 font-heading">No solutions match your search</h3>
    <p class="text-sm text-slate-500 mb-4">Try adjusting your keywords or clearing the category filter.</p>
    <button id="reset-filters-btn" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition-colors">
      Reset Filters
    </button>
  </div>

</div>

<script>
  let activeCategory = 'All';
  let searchTerm = '';

  const searchInput = document.getElementById('product-search') as HTMLInputElement;
  const filterBtns = document.querySelectorAll('.filter-btn');
  const productCards = document.querySelectorAll('.product-card');
  const countLabel = document.getElementById('product-count');
  const noProducts = document.getElementById('no-products');
  const resetBtn = document.getElementById('reset-filters-btn');

  function updateFilter() {
    let visibleCount = 0;

    productCards.forEach((card) => {
      const el = card as HTMLElement;
      const name = el.dataset.name || '';
      const desc = el.dataset.desc || '';
      const categories: string[] = JSON.parse(el.dataset.categories || '[]');

      const matchesSearch = !searchTerm || name.includes(searchTerm) || desc.includes(searchTerm);
      const matchesCategory = activeCategory === 'All' || categories.includes(activeCategory);

      if (matchesSearch && matchesCategory) {
        el.style.display = 'flex';
        visibleCount++;
      } else {
        el.style.display = 'none';
      }
    });

    if (countLabel) {
      countLabel.textContent = `Showing ${visibleCount} solutions`;
    }

    if (noProducts) {
      if (visibleCount === 0) {
        noProducts.classList.remove('hidden');
      } else {
        noProducts.classList.add('hidden');
      }
    }
  }

  searchInput?.addEventListener('input', (e) => {
    searchTerm = (e.target as HTMLInputElement).value.trim().toLowerCase();
    updateFilter();
  });

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.classList.remove('bg-midnight', 'text-white', 'border-midnight', 'active-filter');
        b.classList.add('bg-white', 'text-slate-600', 'border-slate-200');
        b.setAttribute('aria-selected', 'false');
      });

      btn.classList.add('bg-midnight', 'text-white', 'border-midnight', 'active-filter');
      btn.classList.remove('bg-white', 'text-slate-600', 'border-slate-200');
      btn.setAttribute('aria-selected', 'true');

      activeCategory = btn.getAttribute('data-category') || 'All';
      updateFilter();
    });
  });

  resetBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    searchTerm = '';
    activeCategory = 'All';

    filterBtns.forEach((b) => {
      if (b.getAttribute('data-category') === 'All') {
        b.classList.add('bg-midnight', 'text-white', 'border-midnight', 'active-filter');
        b.classList.remove('bg-white', 'text-slate-600', 'border-slate-200');
        b.setAttribute('aria-selected', 'true');
      } else {
        b.classList.remove('bg-midnight', 'text-white', 'border-midnight', 'active-filter');
        b.classList.add('bg-white', 'text-slate-600', 'border-slate-200');
        b.setAttribute('aria-selected', 'false');
      }
    });

    updateFilter();
  });
</script>
